# Kernel config fragment — hardened + Kubernetes + Raspberry Pi Foundation boards
# (Pi 5 / BCM2712, Pi 4 / BCM2711, AND Pi 3 / BCM2837 — this fragment is
# applied to ALL THREE boards)
#
# Applied on top of the board defconfig via scripts/config.
# Format: one "scripts/config" argument set per line.
# Lines starting with # are comments and are skipped.
#
# Edit this file to add or remove kernel options.
#
# NOTE (--board axis, Phase 6): the truly RP1/Pi5-EXCLUSIVE hardware lines that
# used to live in this "RPi 5 hardware" section (NVMe, RP1's PIO/camera-front-end/
# pinctrl/ADC blocks, and RP1's Synopsys DesignWare-derived I2C/SPI controllers —
# none of which exist on a Pi 4/BCM2711, which has no RP1 southbridge at all) were
# split OUT into specs-rpi5/kernel/rp1-pi5.config, applied ONLY for --board rpi5.
# specs-rpi5/kernel/bcm2711-pi4.config is the Pi 4 analogue (its own on-die
# Broadcom I2C/SPI/pinctrl), applied ONLY for --board rpi4. specs-rpi5/kernel/
# bcm2837-pi3.config (Phase 8) is the Pi 3 analogue — but unlike Pi 4, Pi 3 also
# has NO PCIe/xHCI hardware of any kind (see below), so its fragment ADDS
# board-exclusive DWC2 USB + USB-Ethernet + BCM2835-family GPIO-header hardware
# rather than merely swapping I2C/SPI silicon. What's left HERE is the hardware
# genuinely SHARED by (or, for Pi 3, harmlessly inert on) all three boards:
#   - CONFIG_DRM_V3D / CONFIG_DRM_VC4: the V3D GPU + VC4 KMS display driver pair
#     used by VideoCore IV (Pi 3), VI (Pi 4), AND VII (Pi 5) alike — the same
#     mainline driver pair covers the whole BCM2835-through-BCM2712 VideoCore
#     lineage. Genuinely shared on ALL THREE boards; no per-board Kconfig
#     needed (Pi 3 DOES need an extra config.txt dtoverlay to activate KMS —
#     see build-rpi5-stage4.sh's VC4_OVERLAY_LINE — but that is a firmware/DT
#     concern, not a kernel Kconfig one).
#   - CONFIG_PCIE_BRCMSTB / CONFIG_USB_XHCI_PCI / CONFIG_USB_XHCI_HCD: the
#     Broadcom PCIe root complex + xHCI stack. On Pi 4 this is NOT optional —
#     ALL FOUR of its USB ports (2.0 and 3.0) are wired through the single
#     PCIe-attached VL805 xHCI controller, so disabling PCIE_BRCMSTB for
#     --board rpi4 would silently kill USB on real hardware. On Pi 5 the same
#     driver/IP also fronts RP1's own xHCI + (via the exposed FFC/M.2 HAT link)
#     user-facing NVMe. On Pi 3 (BCM2837) this hardware DOES NOT EXIST AT ALL
#     — these lines are deliberately left enabled anyway (harmless dead
#     Kconfig weight, no matching hardware to bind to) rather than
#     restructured out into a shared-but-not-universal fragment: the
#     lower-risk call, since it doesn't touch already-proven Phase 6 code and
#     matches this codebase's existing tolerance for some "compiles but never
#     binds" config elsewhere. Pi 3's actual USB/Ethernet path (Synopsys DWC2)
#     is enabled by bcm2837-pi3.config instead.
# ── RPi Foundation shared hardware (VideoCore DRM/KMS, PCIe + USB3 xHCI) ──
enable CONFIG_PCIE_BRCMSTB
enable CONFIG_DRM_V3D
enable CONFIG_DRM_VC4
enable CONFIG_USB_XHCI_PCI
enable CONFIG_USB_XHCI_HCD

# ── Hardened kernel ────────────────────────────────────────────────
enable CONFIG_SECURITY
enable CONFIG_SECURITY_NETWORK
enable CONFIG_SECURITY_SELINUX
enable CONFIG_SECURITY_SELINUX_BOOTPARAM
enable CONFIG_SECURITY_SELINUX_DEVELOP
enable CONFIG_DEFAULT_SECURITY_SELINUX
# lockdown is listed FIRST so it activates before any other LSM
set-str CONFIG_LSM "lockdown,yama,selinux,bpf"
# Mirrors the x86 fragment: a CONFIG_LSM name whose module is not compiled in is
# silently DROPPED by the kernel, not diagnosed. The Pi shipped the same defect —
# out/qemu-runs/runs/rpi5_pki/launch/console.log:79 reads
#   LSM: initializing lsm=lockdown,capability,selinux
# against a cmdline.txt asking for lockdown,yama,selinux,bpf. Yama (ptrace_scope)
# is enabled here so the shipped string is the running posture; the 8 ARM board
# fragments already carried CONFIG_SECURITY_YAMA=y and are unaffected.
enable CONFIG_SECURITY_YAMA
disable CONFIG_SECURITY_APPARMOR
enable CONFIG_AUDIT
enable CONFIG_AUDITSYSCALL
enable CONFIG_SECCOMP
enable CONFIG_SECCOMP_FILTER
enable CONFIG_STACKPROTECTOR
enable CONFIG_STACKPROTECTOR_STRONG
enable CONFIG_FORTIFY_SOURCE
enable CONFIG_HARDENED_USERCOPY
enable CONFIG_SLAB_FREELIST_RANDOM
enable CONFIG_SLAB_FREELIST_HARDENED
enable CONFIG_SHUFFLE_PAGE_ALLOCATOR
enable CONFIG_RANDOMIZE_BASE
enable CONFIG_RANDOMIZE_MEMORY
enable CONFIG_INIT_ON_ALLOC_DEFAULT_ON
disable CONFIG_INIT_ON_FREE_DEFAULT_ON
enable CONFIG_PAGE_TABLE_ISOLATION
enable CONFIG_RODATA_FULL_DEFAULT_ENABLED
enable CONFIG_ARM64_BTI
enable CONFIG_ARM64_PTR_AUTH
enable CONFIG_ARM64_MTE
enable CONFIG_STRICT_KERNEL_RWX
enable CONFIG_STRICT_MODULE_RWX
disable CONFIG_ACPI_CUSTOM_METHOD
disable CONFIG_COMPAT_BRK
disable CONFIG_DEVKMEM
disable CONFIG_PROC_KCORE
enable CONFIG_BUG_ON_DATA_CORRUPTION
set-val CONFIG_DEFAULT_MMAP_MIN_ADDR 65536
set-val CONFIG_PANIC_TIMEOUT 10

# ── Kernel lockdown LSM (cmdline: lockdown=integrity) ──────────────
enable CONFIG_SECURITY_LOCKDOWN_LSM
enable CONFIG_SECURITY_LOCKDOWN_LSM_EARLY

# ── GCC hardening plugins (compile-time mitigations) ──────────────
enable CONFIG_GCC_PLUGINS
enable CONFIG_GCC_PLUGIN_LATENT_ENTROPY
enable CONFIG_GCC_PLUGIN_STRUCTLEAK
enable CONFIG_GCC_PLUGIN_STRUCTLEAK_BYREF_ALL
enable CONFIG_GCC_PLUGIN_STACKLEAK
# A no-op, as in the x86 fragment: GCC_PLUGIN_RANDSTRUCT is derived from the
# RANDSTRUCT choice, which bcm2712_defconfig leaves at RANDSTRUCT_NONE, and
# olddefconfig recomputes it to unset. That is what lets CONFIG_DEBUG_INFO_BTF
# below resolve (it depends on struct randomisation being off). Choosing
# RANDSTRUCT_FULL/PERFORMANCE would cost BTF and with it bpf-LSM enforcement.
enable CONFIG_GCC_PLUGIN_RANDSTRUCT

# ── Additional hardening ───────────────────────────────────────────
enable CONFIG_ZERO_CALL_USED_REGS
enable CONFIG_DEBUG_LIST
# Disable hibernation — resume-from-disk bypasses LUKS2 disk encryption.
disable CONFIG_HIBERNATION
# Disable kexec — can be used to load an unsigned kernel.
disable CONFIG_KEXEC
disable CONFIG_KEXEC_FILE
# Panic on kernel oops (prevents privilege escalation from undefined kernel state).
enable CONFIG_PANIC_ON_OOPS
# Remove /proc/config.gz (kernel config extraction path).
disable CONFIG_IKCONFIG
disable CONFIG_IKCONFIG_PROC

# ── Cgroup v2 (Kubernetes) ────────────────────────────────────────
enable CONFIG_CGROUPS
enable CONFIG_CGROUP_FREEZER
enable CONFIG_CGROUP_PIDS
enable CONFIG_CGROUP_DEVICE
enable CONFIG_CGROUP_CPUACCT
enable CONFIG_CGROUP_PERF
enable CONFIG_CGROUP_SCHED
enable CONFIG_CGROUP_BPF
enable CONFIG_MEMCG
enable CONFIG_BLK_CGROUP
enable CONFIG_CGROUP_WRITEBACK
# HugeTLB cgroup controller needs HUGETLB_PAGE, which the raspberrypi-sources
# defconfig leaves off (CONFIG_HUGETLBFS is not set on the minimal SBC config) —
# so CGROUP_HUGETLB below prunes and the build guard fails. arm64 sets
# ARCH_SUPPORTS_HUGETLBFS, so enabling HUGETLBFS pulls in HUGETLB_PAGE and lets
# CGROUP_HUGETLB land =y. x86's mainline defconfig already carries it.
enable CONFIG_HUGETLBFS
enable CONFIG_CGROUP_HUGETLB
enable CONFIG_CPUSETS
enable CONFIG_CGROUP_NET_PRIO
enable CONFIG_CGROUP_NET_CLASSID
enable CONFIG_FAIR_GROUP_SCHED
enable CONFIG_CFS_BANDWIDTH

# ── Namespaces (containers) ────────────────────────────────────────
enable CONFIG_NAMESPACES
enable CONFIG_UTS_NS
enable CONFIG_IPC_NS
enable CONFIG_USER_NS
enable CONFIG_PID_NS
enable CONFIG_NET_NS

# ── Networking (K8s CNI / kube-proxy / IPVS) ──────────────────────
enable CONFIG_NETFILTER
# IPv6 BUILT-IN (=y). The raspberrypi-sources defconfig ships CONFIG_IPV6=m, which
# forces EVERY IP6_NF_* symbol to =m (a module can't satisfy a =y that `depends on
# IPV6`) — so the IP6_NF_*=y this fragment requests get silently downgraded to =m
# by olddefconfig and the build guard fails (CONFIG_IP6_NF_IPTABLES_LEGACY not =y).
# x86's mainline defconfig already has IPV6=y; pin it here for parity + so dual-stack
# kube-proxy/NetworkPolicy ip6tables/nft chains are built-in, not load-on-demand.
enable CONFIG_IPV6
enable CONFIG_NETFILTER_ADVANCED
enable CONFIG_NF_CONNTRACK
enable CONFIG_NF_NAT
enable CONFIG_NF_NAT_MASQUERADE
enable CONFIG_NETFILTER_XTABLES
# LEGACY iptables core (kernel >=6.16 split the legacy x_tables out): the legacy
# IPv4/IPv6 filter/mangle/raw tables now depend on IP{,6}_NF_IPTABLES_LEGACY,
# which depend on NETFILTER_XTABLES_LEGACY. Without these, olddefconfig silently
# drops IP_NF_MANGLE / IP6_NF_MANGLE (asserted below). On kernels <6.16 these
# symbols don't exist and olddefconfig harmlessly drops the added lines. (6.18 fix
# mirrored from the x86 builder; kept version-agnostic since rpi-sources floats.)
enable CONFIG_NETFILTER_XTABLES_LEGACY
enable CONFIG_IP_NF_IPTABLES_LEGACY
enable CONFIG_IP6_NF_IPTABLES_LEGACY
enable CONFIG_NETFILTER_XT_MATCH_COMMENT
enable CONFIG_NETFILTER_XT_MATCH_MULTIPORT
enable CONFIG_NETFILTER_XT_MATCH_STATISTIC
enable CONFIG_NETFILTER_XT_MATCH_MARK
enable CONFIG_NETFILTER_XT_MATCH_CONNTRACK
enable CONFIG_NETFILTER_XT_MATCH_ADDRTYPE
enable CONFIG_NETFILTER_XT_TARGET_MARK
enable CONFIG_NETFILTER_XT_TARGET_MASQUERADE
enable CONFIG_NETFILTER_XT_TARGET_REDIRECT
enable CONFIG_IP_NF_IPTABLES
enable CONFIG_IP_NF_FILTER
enable CONFIG_IP_NF_NAT
enable CONFIG_IP_NF_MANGLE
enable CONFIG_IP6_NF_IPTABLES
enable CONFIG_IP6_NF_FILTER
enable CONFIG_IP6_NF_NAT
enable CONFIG_IP6_NF_MANGLE
enable CONFIG_NF_TABLES
# Per-family nf_tables (IPv4/IPv6): kernel >=6.x gates NFT_NAT/NFT_MASQ on
# NF_TABLES_IPV4 || NF_TABLES_IPV6 — without a family olddefconfig prunes them
# (asserted below). Harmless on kernels that don't have the split. (6.18 fix.)
enable CONFIG_NF_TABLES_IPV4
enable CONFIG_NF_TABLES_IPV6
enable CONFIG_NFT_NAT
enable CONFIG_NFT_MASQ
enable CONFIG_NFT_CT
enable CONFIG_BRIDGE
enable CONFIG_BRIDGE_NETFILTER
enable CONFIG_VLAN_8021Q
enable CONFIG_VXLAN
enable CONFIG_IP_VS
enable CONFIG_IP_VS_NFCT
enable CONFIG_IP_VS_RR
enable CONFIG_IP_VS_WRR
enable CONFIG_IP_VS_SH
enable CONFIG_NET_SCH_HTB
enable CONFIG_NET_CLS_CGROUP
enable CONFIG_DUMMY
enable CONFIG_MACVLAN
enable CONFIG_IPVLAN
enable CONFIG_VETH
enable CONFIG_NET_L3_MASTER_DEV

# ── Overlay / container filesystem ─────────────────────────────────
enable CONFIG_OVERLAY_FS
enable CONFIG_OVERLAY_FS_REDIRECT_DIR
enable CONFIG_OVERLAY_FS_INDEX
enable CONFIG_FUSE_FS

# ── BPF (Cilium CNI / eBPF) ───────────────────────────────────────
enable CONFIG_BPF
enable CONFIG_BPF_SYSCALL
enable CONFIG_BPF_JIT
enable CONFIG_BPF_JIT_ALWAYS_ON
enable CONFIG_HAVE_EBPF_JIT
enable CONFIG_BPF_EVENTS
# Makes the trailing `bpf` in CONFIG_LSM resolve (x86 mirror). Deps SECURITY /
# BPF_SYSCALL / BPF_JIT / BPF_EVENTS are all enabled in this fragment. Program
# ATTACH also needs BTF; the BTF block below mirrors the x86 fragment (read its
# BTF note for the Kconfig dependency chain and the RANDSTRUCT trade-off).
enable CONFIG_BPF_LSM
enable CONFIG_CGROUP_BPF
enable CONFIG_XDP_SOCKETS
# BTF: the pahole for this arm64 kernel link runs on the BUILD HOST, not in the
# image — Dockerfile.build installs dev-util/pahole in its final stage. The
# build-rpi5-stage4.sh guard fails the build when olddefconfig drops
# CONFIG_DEBUG_INFO_BTF (no pahole, or a randstruct choice added later).
enable CONFIG_DEBUG_KERNEL
enable CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT
enable CONFIG_DEBUG_INFO_BTF
enable CONFIG_DEBUG_INFO_BTF_MODULES

# ── Misc container requirements ───────────────────────────────────
enable CONFIG_POSIX_MQUEUE
enable CONFIG_KEYS
enable CONFIG_CRYPTO_USER_API_HASH
enable CONFIG_CRYPTO_USER_API_SKCIPHER

# ── TUN/TAP (tailscale / headscale userspace networking) ──────────
enable CONFIG_TUN

# ── /dev auto-population (stage4 ships no static device nodes) ─────
enable CONFIG_DEVTMPFS
enable CONFIG_DEVTMPFS_MOUNT

# ── USB mass storage + FAT (read the USB "KEYS" provisioning stick) ─
enable CONFIG_USB_STORAGE
enable CONFIG_USB_UAS
enable CONFIG_SCSI
enable CONFIG_BLK_DEV_SD
enable CONFIG_FAT_FS
enable CONFIG_VFAT_FS
enable CONFIG_MSDOS_FS
enable CONFIG_EXFAT_FS
enable CONFIG_NLS_CODEPAGE_437
enable CONFIG_NLS_ISO8859_1
enable CONFIG_NLS_UTF8
enable CONFIG_EXT4_FS

# ── Encryption-at-rest: LUKS2 / dm-crypt ──────────────────────────
# Device-mapper + dm-crypt back the LUKS2 data partition keys-provision creates
# (provision_storage) on the Pi's attached NVMe/USB. aes-xts-plain64 needs
# CRYPTO_XTS + AES (ARM64 CE accel where present); argon2id PBKDF runs in
# userspace (cryptsetup). The Pi5 has no on-board TPM, so the USB-KEYS keyfile is
# the unlock slot (clevis-tpm2 is used instead on a Pi WITH a TPM HAT). KEYS +
# TRUSTED_KEYS are included so a TPM HAT path works without a kernel rebuild.
enable CONFIG_MD
enable CONFIG_BLK_DEV_DM
enable CONFIG_DM_CRYPT
enable CONFIG_CRYPTO_XTS
enable CONFIG_CRYPTO_AES
enable CONFIG_CRYPTO_AES_ARM64_CE_BLK
enable CONFIG_CRYPTO_SHA512
enable CONFIG_CRYPTO_USER_API_HASH
enable CONFIG_CRYPTO_USER_API_SKCIPHER
enable CONFIG_KEYS
enable CONFIG_TRUSTED_KEYS

# ── Virtualization / QEMU `-M virt` integration testing ───────────
# Built-in (=y) so the kernel can mount a virtio rootfs with no initramfs.
# Harmless on real RPi 5 hardware; enables booting the exact same Image
# under qemu-system-aarch64 for tests/qemu.
enable CONFIG_PCI_HOST_GENERIC
enable CONFIG_PCI_HOST_COMMON
enable CONFIG_VIRTIO
enable CONFIG_VIRTIO_MENU
enable CONFIG_VIRTIO_PCI
enable CONFIG_VIRTIO_MMIO
enable CONFIG_VIRTIO_BLK
enable CONFIG_VIRTIO_NET
enable CONFIG_VIRTIO_CONSOLE
enable CONFIG_VIRTIO_BALLOON
enable CONFIG_SCSI_VIRTIO
enable CONFIG_SERIAL_AMBA_PL011
enable CONFIG_SERIAL_AMBA_PL011_CONSOLE
enable CONFIG_RTC_DRV_PL031
enable CONFIG_NET_9P
enable CONFIG_NET_9P_VIRTIO
enable CONFIG_9P_FS
