# bcm2711-pi4.config — BCM2711-native peripheral hardware, applied ONLY for
# --board rpi4
#
# The Raspberry Pi 4 has NO RP1 southbridge (that chip is Pi 5-only — see
# rp1-pi5.config) — its GPIO header I2C/SPI/pin-mux are native BCM2711 silicon,
# the same long-standing Broadcom peripheral blocks used by every Pi board
# before the Pi 5 (Pi 1/2/3/Zero/400). raspberrypi-sources' bcm2711_defconfig
# already turns these on by default; they are asserted here EXPLICITLY (mirrors
# the olddefconfig-drift guards elsewhere in this build) so a future defconfig
# refresh cannot silently drop GPIO-header I2C/SPI/pinmux without this fragment
# re-enabling it. NOT verified against real BCM2711 hardware or a fresh
# `make bcm2711_defconfig` diff in this sandbox (no aarch64 toolchain/hardware
# available) — the symbol names themselves are long-established, widely
# documented mainline Kconfig options, but the "already on by default" claim is
# unverified here and worth a follow-up defconfig diff before this ships.
#
# Applied on top of hardened-k8s.config (the universal base — still carries the
# shared PCIe/USB3/DRM lines both boards need, see its header note) for
# --board rpi4 only. Format: one "scripts/config" argument set per line; lines
# starting with # are comments and are skipped.

# ── GPIO-header I2C (bcm2835 on-die controller) ────────────────────
enable CONFIG_I2C_BCM2835

# ── GPIO-header SPI (main SPI0 + the mini SPI1/SPI2 AUX block) ─────
enable CONFIG_SPI_BCM2835
enable CONFIG_SPI_BCM2835AUX

# ── GPIO pin controller / pin-mux (shared by every bcm283x-family Pi) ──
enable CONFIG_PINCTRL_BCM2835
