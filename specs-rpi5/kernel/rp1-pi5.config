# rp1-pi5.config — RP1-EXCLUSIVE hardware, applied ONLY for --board rpi5
#
# RP1 is the custom peripheral-controller ("southbridge") chip Raspberry Pi
# designed for the Pi 5. It connects to the BCM2712 application processor over
# a PCIe 2.0 x4 link and owns essentially all of the Pi 5's external I/O: GPIO,
# I2C, SPI, UART, PWM, I2S, the camera front-end, an onboard ADC, and both
# downstream USB2/USB3 host-controller pairs. NONE of this silicon exists on a
# Raspberry Pi 4 (BCM2711) — its equivalent GPIO/I2C/SPI/pinctrl are native
# BCM2711 blocks instead (see bcm2711-pi4.config). Applying these options
# unconditionally to a Pi 4 build would be harmless-but-wrong Kconfig noise at
# best (the symbols simply never activate — no RP1 hardware to bind to) and
# actively misleading at worst (a maintainer reading the fragment list would
# reasonably assume the board has RP1-driven NVMe/camera/ADC when it does not).
#
# Applied on top of hardened-k8s.config (the universal base, still carries the
# shared PCIe/USB3/DRM lines both boards need — see its header note) for
# --board rpi5 only. Format: one "scripts/config" argument set per line;
# lines starting with # are comments and are skipped.

# ── User-facing NVMe (Pi 5's exposed FFC / M.2 HAT PCIe link) ──────
# The standard Pi 4 Model B has no user-accessible PCIe/NVMe path at all (its
# one PCIe lane is fully consumed internally by the VL805 USB3 bridge — see
# hardened-k8s.config); Pi 5 exposes a second, user-facing PCIe link via the
# FFC connector specifically for an NVMe HAT/M.2 adapter.
enable CONFIG_NVME_CORE
enable CONFIG_BLK_DEV_NVME

# ── RP1-exclusive silicon blocks (no equivalent on BCM2711/Pi 4) ───
enable CONFIG_RP1_PIO
enable CONFIG_VIDEO_RP1_CFE
enable CONFIG_PINCTRL_RP1
enable CONFIG_SENSORS_RP1_ADC

# ── RP1's Synopsys DesignWare-derived I2C/SPI controllers ──────────
# Per Raspberry Pi's own RP1 peripherals datasheet, RP1's I2C/SPI (and I2S)
# blocks are Synopsys DesignWare IP, distinct from the legacy Broadcom
# bcm2835-family controllers BCM2711/Pi 4 still uses directly (see
# bcm2711-pi4.config's CONFIG_I2C_BCM2835 / CONFIG_SPI_BCM2835*).
enable CONFIG_I2C_DESIGNWARE_PLATFORM
enable CONFIG_SPI_DW_MMIO
