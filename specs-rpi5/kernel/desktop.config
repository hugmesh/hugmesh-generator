# RPi Foundation CLIENT-DESKTOP kernel fragment (board-neutral: Pi 3, Pi 4 AND
# Pi 5 all apply it) — appended on top of hardened-k8s.config (applied to EVERY
# role, cluster node or desktop — same universal-base pattern
# build-x86-host-stage4.sh and build-jetson-stage4.sh already use) ONLY for
# --role desktop (ROLE_CLIENT). Note: --board rpi3 hard-errors on every OTHER
# role (see build-rpi5-stage4.sh), so in practice rpi3 ALWAYS applies this
# fragment. hardened-k8s.config already carries the shared DRM/KMS bits
# (CONFIG_DRM_V3D/CONFIG_DRM_VC4 — VideoCore IV on Pi 3, VI on Pi 4, VII on
# Pi 5, same driver pair) needed for ANY display output on any board —
# this fragment adds the input / HID / sound bits a person's device needs and a
# headless cluster node does not. Lines are applied with the SAME
# `scripts/config --<action> <CONFIG_x>` loop as hardened-k8s.config. Mirrors
# specs-x86/kernel/desktop.config, trimmed of the x86/laptop-only ACPI/
# microcode/SATA bits that don't apply to this SBC family.

# Input: keyboard / mouse / touchpad (libinput reads evdev)
enable CONFIG_INPUT_EVDEV
enable CONFIG_INPUT_KEYBOARD
enable CONFIG_INPUT_MOUSE
enable CONFIG_INPUT_MOUSEDEV
enable CONFIG_INPUT_TOUCHSCREEN

# USB HID (keyboards, mice, dongles) — the underlying USB host controller is
# board-specific (USB_XHCI_HCD/XHCI_PCI on Pi 4/5, already enabled
# unconditionally by hardened-k8s.config's shared-hardware section; DWC2 on
# Pi 3, enabled by bcm2837-pi3.config) but USB_HID/HID_GENERIC sit on top of
# usbcore and don't care which host driver is underneath.
enable CONFIG_USB_HID
enable CONFIG_HID_GENERIC

# Sound: generic ALSA + USB audio (HDMI audio routes through CONFIG_DRM_VC4,
# already enabled unconditionally — no BCM2835-specific ALSA driver needed on
# ANY of the 3 boards; this repo does not enable the legacy analog-jack
# snd-bcm2835 driver for Pi 4/5 either, so Pi 3 loses nothing relative to its
# siblings by following the same call — HDMI digital audio + USB audio class
# devices remain the supported paths).
enable CONFIG_SOUND
enable CONFIG_SND
enable CONFIG_SND_USB_AUDIO
