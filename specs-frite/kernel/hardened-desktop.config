# Kernel config fragment — Libre Computer Le/La Frite (Amlogic GXL) LIGHT desktop.
#
# Applied on top of the chosen base defconfig by build-frite-stage4.sh (each line
# is fed to `scripts/config --<action> <CONFIG_...>`). Two jobs:
#   1) Keep the SAME hardening posture as the rest of the fleet (SELinux LSM,
#      lockdown-friendly, audit) — the SELinux guard in the builder enforces it.
#   2) Enable the Amlogic Meson platform + a lean DRM/KMS + input + USB so the
#      lean desktop actually displays and takes a keyboard/mouse on the SBC.
#
# We build from a generic arm64 defconfig (the builder passes -d defconfig), which
# already enables the broad ARCH_MESON platform; this fragment pins the bits the
# light desktop + the hardened posture specifically need.

# ── Amlogic Meson GXL platform (S805X / S905X) ─────────────────────
enable CONFIG_ARCH_MESON
enable CONFIG_MESON_GXL_PHY
enable CONFIG_MESON_SARADC
enable CONFIG_MESON_GX_SOCINFO
# Onboard 100M Ethernet (dwmac-meson)
enable CONFIG_STMMAC_ETH
enable CONFIG_DWMAC_MESON
# eMMC / SD (MMC host on the GXL)
enable CONFIG_MMC
enable CONFIG_MMC_MESON_GX
# SPI NOR (La Frite boots u-boot from SPI; useful to read/identify it from Linux)
enable CONFIG_SPI
enable CONFIG_SPI_MESON_SPIFC
enable CONFIG_MTD
enable CONFIG_MTD_SPI_NOR

# ── USB (La Frite has NO SD slot — USB is the LIVE root path) ──────
enable CONFIG_USB
enable CONFIG_USB_DWC2
enable CONFIG_USB_DWC3
enable CONFIG_USB_DWC3_MESON_G12A
enable CONFIG_USB_STORAGE
enable CONFIG_USB_XHCI_HCD
enable CONFIG_USB_EHCI_HCD
enable CONFIG_USB_OHCI_HCD
enable CONFIG_USB_HID
enable CONFIG_HID_GENERIC

# ── Display / DRM (meson KMS + Mali-450 'lima') ────────────────────
enable CONFIG_DRM
enable CONFIG_DRM_MESON
enable CONFIG_DRM_MESON_DW_HDMI
enable CONFIG_DRM_LIMA
enable CONFIG_FB
enable CONFIG_FRAMEBUFFER_CONSOLE
enable CONFIG_DRM_FBDEV_EMULATION

# ── Input ──────────────────────────────────────────────────────────
enable CONFIG_INPUT_EVDEV
enable CONFIG_INPUT_KEYBOARD
enable CONFIG_INPUT_MOUSE

# ── Audio (lean — HDMI/I2S via the meson card; ALSA only) ──────────
enable CONFIG_SOUND
enable CONFIG_SND
enable CONFIG_SND_SOC
enable CONFIG_SND_MESON_GX_SOUND_CARD

# ── zram swap (the 512 MB SKU leans on this) ──────────────────────
enable CONFIG_ZRAM
enable CONFIG_ZSMALLOC
enable CONFIG_SWAP

# ── Hardening posture (MUST match the fleet; guarded by the builder) ─
enable CONFIG_SECURITY
enable CONFIG_SECURITY_SELINUX
enable CONFIG_SECURITY_SELINUX_BOOTPARAM
enable CONFIG_SECURITY_YAMA
enable CONFIG_AUDIT
enable CONFIG_AUDITSYSCALL
enable CONFIG_BPF_SYSCALL
--set-str CONFIG_LSM "yama,selinux,bpf"
# ASLR / stack / slab hardening
enable CONFIG_RANDOMIZE_BASE
enable CONFIG_STACKPROTECTOR_STRONG
enable CONFIG_SLAB_FREELIST_HARDENED
enable CONFIG_SLAB_FREELIST_RANDOM
enable CONFIG_HARDENED_USERCOPY
enable CONFIG_FORTIFY_SOURCE

# ── tun + iptables (tailscale needs /dev/net/tun + nf) ─────────────
enable CONFIG_TUN
enable CONFIG_NETFILTER
enable CONFIG_NF_CONNTRACK
enable CONFIG_IP_NF_IPTABLES
enable CONFIG_NETFILTER_XTABLES

# ── Squashfs + overlay + loop (the LIVE flavor boots a squashfs) ──
# The LIVE flavor boots a dracut dmsquash-live initramfs that mounts
# LiveOS/squashfs.img read-only (loop + squashfs) and stacks a writable overlay
# = the ephemeral root. We use the overlayfs overlay (rd.live.overlay.overlayfs=1
# on the cmdline), but device-mapper + dm-snapshot are also enabled so dracut's
# default DM overlay path works too. tmpfs/devtmpfs are required for the initramfs
# (it mounts /dev via devtmpfs and the writable overlay on tmpfs).
enable CONFIG_SQUASHFS
enable CONFIG_SQUASHFS_XZ
enable CONFIG_OVERLAY_FS
enable CONFIG_BLK_DEV_LOOP
enable CONFIG_ISO9660_FS
enable CONFIG_BLK_DEV_DM
enable CONFIG_DM_SNAPSHOT
enable CONFIG_BLK_DEV_RAM
enable CONFIG_DEVTMPFS
enable CONFIG_DEVTMPFS_MOUNT
enable CONFIG_TMPFS
enable CONFIG_TMPFS_POSIX_ACL
enable CONFIG_BLK_DEV_INITRD
