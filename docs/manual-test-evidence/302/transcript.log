=================== probe - control personas sign-in state (before step 9)  (2026-09-30T16:42:52Z) ===================
--- command (verbatim script body) ---
echo '# probe (read-only sign-ins) of the control personas the plan relies on; run before step 9 to learn whether the controls are valid'
for u in e2e-user e2e-gamesonly e2e-admin mesh-operator e2e-gamesadmin e2e-adminonly e2e-superadmin; do
  jar="$W/tmp/probe-$u.jar"; rm -f "$jar"
  code="$(curl -sk -c "$jar" -o "$W/tmp/probe-body.json" -w '%{http_code}' -X POST "$B/bff/login" -H 'content-type: application/json' -d "$(jq -nc --arg u "$u" --arg p "$PW" '{username:$u,password:$p}')")"
  printf '%-16s login=%s body=%s ' "$u" "$code" "$(head -c 160 "$W/tmp/probe-body.json")"
  curl -sk -b "$jar" "$B/bff/session" | jq -c '{registrationComplete,roles}' 2>/dev/null || echo '(no session json)'
  rm -f "$jar"
done
