=================== step 2 - read the per-run secret  (2026-09-30T16:42:20Z) ===================
--- command (verbatim script body) ---
cd "$WT" && ls -l .e2e-credentials | sed 's/^\(.\{10\}\) [0-9]* \([^ ]*\) \([^ ]*\) .*\(\.e2e-credentials\)$/\1 \2 \3 \4/' && PW="$(grep '^E2E_PASSWORD=' .e2e-credentials | tail -n1 | cut -d= -f2-)"; [ -n "$PW" ] && echo "password resolved, length ${#PW}" || echo 'NO PASSWORD RESOLVED - STOP'
echo "credential-file lines: $(wc -l < .e2e-credentials)  (keys: $(cut -d= -f1 .e2e-credentials | tr '\n' ' '))"
--- output (redacted) ---
-rw------- magus magus .e2e-credentials
password resolved, length 32
credential-file lines: 1  (keys: E2E_PASSWORD )
(script exit=0)

=================== step 3 - prove PW matches this mesh (control e2e-user)  (2026-09-30T16:42:20Z) ===================
--- command (verbatim script body) ---
JU="$W/tmp/ju-user.jar"; rm -f "$JU"
curl -sk -c "$JU" -X POST "$B/bff/login" -H 'content-type: application/json' -d "$(jq -nc --arg p "$PW" '{username:"e2e-user",password:$p}')" -w '\nlogin=%{http_code}\n'
curl -sk -b "$JU" "$B/bff/session" | jq -c '{registrationComplete,roles}'
TOK_USER="$(awk '$6=="bff_<redacted>"{print $7}' "$JU")"; case "$TOK_USER" in bff_*) echo 'control token ok';; *) echo 'NO CONTROL TOKEN - STOP';; esac
--- output (redacted) ---
{"registrationComplete":true,"status":"active","mfaRequired":false}
login=200
{"registrationComplete":true,"roles":["user"]}
control token ok
(script exit=0)

