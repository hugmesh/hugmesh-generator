# Keyword acceptances — Orange Pi 5 / Orange Pi 5 Plus (Rockchip RK3588/RK3588S,
# arm64) light desktop.
#
# Kept deliberately minimal. Mainline gentoo-sources + linux-firmware + the LXDE
# stack are all stable on arm64. Add ~arm64 lines here only if a specific atom
# you pull in is testing-keyworded on arm64 (validate against the tree first).

# u-boot-tools: mkimage for the FIT/extlinux boot blob.
dev-embedded/u-boot-tools ~arm64

# spice-vdagent (the emulated-desktop display agent in the desktop list) is
# amd64-stable but only ~arm64. Accept it here. Do NOT add a line for its
# USE=selinux dependency sec-policy/selinux-vdagent: 2.20260616_p1 is STABLE on
# arm64 and satisfies ">=selinux-base-policy-2.20260616_p1"; a ~arm64 entry
# would make portage pick 2.20260922_p1, whose eclass RDEPEND demands a
# selinux-base-policy that is still ~arm64 on this board — a wall hours into a
# build. tests/scripts/test-vm-display-guest.sh pins both halves.
app-emulation/spice-vdagent ~arm64
