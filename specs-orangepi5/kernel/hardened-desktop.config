# Kernel config fragment — Orange Pi 5 / Orange Pi 5 Plus (Rockchip RK3588/RK3588S)
# light desktop. EXPERIMENTAL PLATFORM — see specs-orangepi5/README.md: this
# board has NEVER been booted with an image from this repo. Every RK3588-
# specific symbol below is researched (web + kernel/Mesa docs), NOT hardware-
# verified; treat every "verify" note as a real gap a reviewer must close before
# trusting this on real hardware.
#
# Applied on top of the chosen base defconfig by build-orangepi5-stage4.sh using
# scripts/kconfig/merge_config.sh (the Frite/Jetson convention — real Kconfig
# dependency-aware merging — NOT the x86/RPi5 `scripts/config --action` replay
# DSL). Three jobs:
#   1) Keep the SAME hardening posture as the rest of the fleet (SELinux LSM,
#      lockdown-friendly, audit) — the SELinux guard in the builder enforces it.
#   2) Enable the RK3588/RK3588S platform + PCIe/NVMe + GPU/DRM + networking +
#      USB so the board actually boots, displays, and takes input.
#   3) LUKS2/dm-crypt (--encrypt-root) + the lean-desktop input/HID/sound bits.
#
# Format: standard .config fragment (CONFIG_FOO=y / # CONFIG_FOO is not set /
# CONFIG_FOO="string") — consumed by merge_config.sh, NOT by scripts/config.

# ── Rockchip RK3588/RK3588S platform ───────────────────────────────
# CONFIG_ARCH_ROCKCHIP is the arm64 platform-select symbol (arch/arm64/Kconfig.platforms);
# it covers the whole Rockchip SoC family (RK3399/RK3568/RK3588/...), not just this chip.
CONFIG_ARCH_ROCKCHIP=y
CONFIG_ROCKCHIP_SARADC=y

# ── PCIe (RK3588: 4x lanes incl. Gen3 x4; RK3588S: fewer lanes, no PCIe3.0x4) ──
# The Orange Pi 5 Plus's M.2 NVMe slot AND the M.2 E-key WiFi slot are both PCIe.
# CONFIG_PCIE_ROCKCHIP_DW_HOST (drivers/pci/controller/dwc/Kconfig) is the real
# mainline DesignWare-based Rockchip PCIe HOST-mode driver — VERIFIED against
# live kernel source (a prior "CONFIG_PCIE_DW_ROCKCHIP" name here did not exist
# as a Kconfig symbol at all; it was silently dropped by merge_config.sh with
# no build-time signal, and only had no visible effect because the generic
# arm64 defconfig this builder starts from happens to default the real symbol
# on independently). Selects PCIE_ROCKCHIP_DW + PCIE_DW_HOST automatically.
CONFIG_PCI=y
CONFIG_PCIEPORTBUS=y
CONFIG_PCIE_ROCKCHIP_DW_HOST=y
CONFIG_PCIEASPM=y

# ── NVMe (Orange Pi 5 Plus M.2 slot; PCIe3.0x4 on RK3588, absent on RK3588S) ──
# NVMe ROOTFS is a supported, documented configuration (U-Boot lives on SPI NOR/
# eMMC/SD and loads the kernel+initramfs from there; the NVMe device is then
# mounted as root by the kernel — see the builder header for the full boot-
# chain rationale). Whether U-Boot's OWN SPL/TPL can load directly FROM a cold
# NVMe device (skipping SPI/eMMC entirely) is a narrower, less-verified claim —
# NOT relied upon here; this fragment only needs the kernel-side NVMe driver.
CONFIG_BLK_DEV_NVME=y
CONFIG_NVME_CORE=y

# ── eMMC / microSD (Rockchip DesignWare MSHC controller) ───────────
# CONFIG_MMC_SDHCI_OF_DWCMSHC is the mainline driver for Rockchip's eMMC/SD host
# controller IP (shared across RK3568/RK3588); VERIFY against the kernel tree.
CONFIG_MMC=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_OF_DWCMSHC=y

# ── USB (USB3 DWC3 controllers + xHCI; both boards have USB-A/USB-C ports) ────
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PLATFORM=y
CONFIG_USB_DWC3=y
CONFIG_USB_STORAGE=y
CONFIG_USB_HID=y
CONFIG_HID_GENERIC=y

# ── Networking ──────────────────────────────────────────────────────
# Orange Pi 5 Plus: dual 2.5GbE via Realtek RTL8125 (PCIe-attached); handled by
# the MAINLINE in-tree r8169 driver (RTL8125 support landed in r8169 well before
# any kernel version this builder would plausibly select — no out-of-tree
# Realtek r8125 driver needed). Orange Pi 5 (non-Plus, RK3588S) typically ships
# a single lower-speed NIC (board/SKU-dependent) — r8169 covers the common
# Realtek case there too; VERIFY the exact NIC on whatever exact SKU is in hand,
# vendor/SKU variation is real on these boards.
CONFIG_R8169=y

# ── WiFi (module only — EXPERIMENTAL, mainline support is ROUGH) ───
# Onboard/M.2 WiFi on Orange Pi 5 boards is commonly a Broadcom/Cypress AP6275P
# (SDIO, brcmfmac-class). As of the research backing this fragment, mainline
# brcmfmac support for the AP6275P/AP6275S family is INCOMPLETE (association
# reported but data path not passing traffic in some reports; device-tree
# overlay detection issues in others) — meaningfully behind Frite's "no radio
# hardware at all" situation, where there is simply nothing to support. WiFi
# stays OFF BY DEFAULT (harden_radios() in the builder, same as every other
# platform); the module is included so `--enable-wifi` has something to load,
# but do NOT treat WiFi as reliable on this platform yet. See
# specs-orangepi5/README.md.
CONFIG_BRCMFMAC=m
CONFIG_CFG80211=m
CONFIG_MAC80211=m

# ── GPU / Display ───────────────────────────────────────────────────
# Mali-G610 MP4 (Valhall, 10th-gen Mali): the KERNEL driver is Panthor (NOT
# Panfrost — Panfrost covers OLDER Bifrost/Midgard Mali; Panthor is the
# separate, newer driver for Valhall-and-later, merged in Linux v6.10). The
# MESA/Gentoo USERSPACE side confusingly keeps the NAME "panfrost" for its
# Gallium driver even after being extended to drive Panthor-kernel hardware
# (reached OpenGL ES 3.1 conformance on Mali-G610 in Mesa 24.1.1) — so
# VIDEO_CARDS="panfrost" in make.conf.tmpl is CORRECT despite the kernel-side
# driver being named Panthor. This split naming is a real, confirmed point of
# confusion — flagged here so it isn't "fixed" incorrectly later.
CONFIG_DRM=y
CONFIG_DRM_PANTHOR=y
# VOP2 (Video Output Processor 2, RK3588's display pipeline) + the RK3588 HDMI
# PHY ("HDMI QP", a newer PHY variant vs older Rockchip chips' plain dw-hdmi):
# mainline HDMI output on RK3588 was NOT functional before Linux 6.13 (per the
# research behind this fragment — VOP2 patches landed in stages through 2024,
# with usable HDMI0/HDMI1 display-mode handling only converging in 6.13+).
# CONFIG_DRM_ROCKCHIP auto-selects VOP2 support for this SoC; VERIFY the
# checked-out gentoo-sources kernel is >= 6.13 or HDMI output may simply not
# work. This is the single most version-sensitive item in this whole fragment.
CONFIG_DRM_ROCKCHIP=y
CONFIG_DRM_DW_HDMI_QP=y
CONFIG_DRM_DW_HDMI=y
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_DRM_FBDEV_EMULATION=y

# ── Input ────────────────────────────────────────────────────────────
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_INPUT_MOUSE=y

# ── Audio (HDMI audio + generic ALSA/USB; ALSA only, no pulseaudio/pipewire) ──
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_SOC_ROCKCHIP=y
CONFIG_SND_USB_AUDIO=y

# ── Hardware crypto (Rockchip Crypto V2 engine) — OPTIONAL accelerator ──────
# RK3588 has a dedicated Rockchip crypto engine (2 cipher/hash pipelines: AES
# 128/192/256, DES/TDES, SHA-1/256/512, SM3, HMAC, PKA). The mainline driver
# (CRYPTO_DEV_ROCKCHIP2, "Rockchip cryptographic offloader V2", covering
# RK3566/RK3568/RK3588) registers ecb(aes)/cbc(aes)/xts(aes)/sha*/sm3 — xts(aes)
# is exactly LUKS's cipher, so if this driver is present + selected as the
# active provider it WOULD accelerate FDE reads/writes. CONFIDENCE: MEDIUM —
# the driver is relatively new upstream (initial submission ~late 2023) and
# algorithm coverage grew over several revisions; VERIFY it is actually present
# and enabled in the checked-out kernel tree/version before relying on it. Kept
# as an ADDITIVE, non-mandatory accelerator: CRYPTO_AES_ARM64_CE_BLK below
# (ARMv8 Crypto Extensions — a CPU-instruction accelerator both the Cortex-A76
# and Cortex-A55 cores implement) is the GUARANTEED accelerator this fragment
# relies on; the crypto engine driver is enabled opportunistically on top.
CONFIG_CRYPTO_DEV_ROCKCHIP2=m

# ── LUKS2 root (dm-crypt) — --encrypt-root builds ──────────────────
# Same CONFIG_MD/BLK_DEV_DM/DM_CRYPT/CRYPTO_XTS/CRYPTO_AES pattern every other
# platform in this repo uses (x86/frite/rpi5/jetson). CONFIG_MD gates the whole
# drivers/md/Kconfig subtree that BLK_DEV_DM/DM_CRYPT depend on (directly or
# transitively) — without it, `make olddefconfig` silently drops them regardless
# of what's requested here. CRYPTO_AES_ARM64_CE_BLK is the ARMv8 Crypto
# Extensions accelerator (guaranteed present on both Cortex-A76 and Cortex-A55
# in this SoC — unlike Frite's Cortex-A53, where the CE extension is optional
# per-implementation). Mirrors specs-frite/kernel/hardened-desktop.config.
CONFIG_MD=y
CONFIG_DM_CRYPT=y
CONFIG_CRYPTO_XTS=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_AES_ARM64_CE_BLK=y
CONFIG_CRYPTO_SHA512=y
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y
# Disable hibernation — resume-from-disk bypasses LUKS2 disk encryption.
# Mirrors every other hardened-*.config in this repo.
# CONFIG_HIBERNATION is not set

# ── Hardening posture (MUST match the fleet; guarded by the builder) ─
# SECURITY_NETWORK must come before SECURITY_SELINUX — selinux depends on it.
CONFIG_SECURITY=y
CONFIG_SECURITY_NETWORK=y
CONFIG_SECURITY_SELINUX=y
CONFIG_SECURITY_SELINUX_BOOTPARAM=y
CONFIG_SECURITY_YAMA=y
# Kernel lockdown (cmdline: lockdown=integrity). Mirrors specs-x86 + specs-rpi5; the
# 8 ARM boards used to ship neither the symbol nor the cmdline token. It SELECTS
# CONFIG_MODULE_SIG (Kconfig: `select MODULE_SIG if MODULES`), so every module this
# build installs is signed with the kernel's auto-generated key and an UNSIGNED or
# out-of-tree .ko is refused at runtime once lockdown=integrity is on. _EARLY makes
# lockdown run before every other LSM so the boot parameters are covered too.
CONFIG_SECURITY_LOCKDOWN_LSM=y
CONFIG_SECURITY_LOCKDOWN_LSM_EARLY=y
CONFIG_AUDIT=y
CONFIG_AUDITSYSCALL=y
CONFIG_BPF_SYSCALL=y
# `bpf` is deliberately NOT in this list. The kernel silently DROPS an LSM name
# whose module is absent — it prints a SHORTER "LSM: initializing lsm=..." and
# boots on — and CONFIG_BPF_LSM has never been set in ANY board fragment in this
# repo, nor are its Kconfig deps (BPF_JIT, BPF_EVENTS) enabled here. So the name
# only ever advertised a posture the running kernel did not have. yama IS real on
# this board (CONFIG_SECURITY_YAMA=y above). Re-add `bpf` only together with
# CONFIG_BPF_LSM + its deps AND a verified board build; the builder guard now
# derives the required CONFIG_* set from this very string and will fail without it.
# lockdown is listed FIRST so it activates before any other LSM (as on x86/rpi5).
CONFIG_LSM="lockdown,yama,selinux"
# ASLR / stack / slab hardening
CONFIG_RANDOMIZE_BASE=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_SLAB_FREELIST_HARDENED=y
CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_FORTIFY_SOURCE=y

# ── tun + iptables (tailscale needs /dev/net/tun + nf) ─────────────
CONFIG_TUN=y
CONFIG_NETFILTER=y
CONFIG_NF_CONNTRACK=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_NETFILTER_XTABLES=y

# ── Squashfs + overlay + loop (the LIVE flavor boots a squashfs) ──
# Same dmsquash-live boot design as Frite/RPi5: the LIVE/INSTALLER medium boots
# a dracut dmsquash-live initramfs that mounts LiveOS/squashfs.img read-only
# (loop + squashfs) and stacks a writable overlay = the ephemeral root.
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_OVERLAY_FS=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_ISO9660_FS=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_SNAPSHOT=y
CONFIG_BLK_DEV_RAM=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_BLK_DEV_INITRD=y
