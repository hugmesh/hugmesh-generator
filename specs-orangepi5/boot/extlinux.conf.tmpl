# extlinux.conf — U-Boot distro-boot config for Orange Pi 5 / Orange Pi 5 Plus
# (Rockchip RK3588/RK3588S). U-Boot's distro-boot scans the first partition of
# whatever block device it finds (microSD/eMMC/USB/NVMe) for /extlinux/extlinux.conf
# and boots the entry below — the SAME mechanism build-frite-stage4.sh uses (NOT
# the RPi5 config.txt/cmdline.txt model, and NOT UEFI/GRUB — see the builder's
# header for the full boot-chain research/rationale).
#
# Variables substituted at build time (render_template in build-orangepi5-stage4.sh):
#   @@OPI5_KERNEL_IMG@@   Kernel image filename in /boot (e.g. Image)
#   @@OPI5_DTB@@          Board DTB path under /dtb (e.g.
#                         rockchip/rk3588-orangepi-5-plus.dtb)
#   @@OPI5_INITRD_LINE@@  INITRD line (live/installer/encrypted-disk boot) or a
#                         comment (plaintext installed system)
#   @@BRAND_TITLE@@       Menu label brand
#
# IMPORTANT: boot the DTB that ships WITH THE KERNEL (copied to /boot/dtb by the
# builder), NOT any DTB baked into U-Boot itself — mainline RK3588 device-tree
# support is still evolving fast (see specs-orangepi5/README.md); a stale
# in-u-boot DTB is a common source of "boots to nothing" on these boards.

DEFAULT orangepi5
TIMEOUT 20
MENU TITLE @@BRAND_TITLE@@ — Orange Pi 5

LABEL orangepi5
    MENU LABEL @@BRAND_TITLE@@ light desktop
    LINUX /@@OPI5_KERNEL_IMG@@
    FDT /dtb/@@OPI5_DTB@@
@@OPI5_INITRD_LINE@@
    APPEND @@OPI5_APPEND@@

# ── SELinux entries (#863 refute, blockers 3 and 4) ─────────────────────────────
# DEFAULT above is unchanged; these two are picked from the boot menu on the serial
# console (U-Boot shows it because of the MENU TITLE line; the Jetson's L4TLauncher
# lists every LABEL). Same kernel, FDT, initrd and cmdline as the default, plus ONE
# token: the kernel takes the LAST enforcing=, and libselinux lets it override
# /etc/selinux/config.
#   orangepi5-selinux-rescue          enforcing=0  boot a node whose enforcing policy
#                                   breaks its boot (permissive, for this boot only)
#   orangepi5-selinux-enforcing-test  enforcing=1  try enforcing for ONE boot without
#                                   touching /etc/selinux/config
# The installers rewrite root= with a per-line sed, so these APPEND lines get the
# installed root= exactly like the default's.

LABEL orangepi5-selinux-rescue
    MENU LABEL @@BRAND_TITLE@@ light desktop (SELinux permissive rescue)
    LINUX /@@OPI5_KERNEL_IMG@@
    FDT /dtb/@@OPI5_DTB@@
@@OPI5_INITRD_LINE@@
    APPEND @@OPI5_APPEND@@ enforcing=0

LABEL orangepi5-selinux-enforcing-test
    MENU LABEL @@BRAND_TITLE@@ light desktop (SELinux enforcing (test))
    LINUX /@@OPI5_KERNEL_IMG@@
    FDT /dtb/@@OPI5_DTB@@
@@OPI5_INITRD_LINE@@
    APPEND @@OPI5_APPEND@@ enforcing=1
