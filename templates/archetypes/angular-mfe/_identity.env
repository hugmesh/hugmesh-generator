# _identity.env — UPSTREAM-IDENTITY drift oracle for the ANGULAR-MFE archetype.
#
# EXEMPLAR MEMBER = snapdragon-login-ui (the Phase-2 seed). Original literal token
# values the archetype recipe + class-A federation-base.js carry in the READ-ONLY
# upstream base. NOT secrets, NOT tenant brand — the base's own identity.
#
# NOTE the Phase-4 title split: the Phase-2 exemplar folded brand+role into ONE
# BRAND_TITLE ("Snapdragon Login (remote)"). A single global BRAND_TITLE cannot
# differentiate per-UI tab titles across a multi-repo render, so the archetype
# splits it: BRAND_TITLE (leading brand word) + TITLE_WORD (per-UI role word).
# At upstream identity BRAND_TITLE=Snapdragon, TITLE_WORD=Login reproduces the
# original "<title>Snapdragon Login (remote)</title>".
#
# scripts/validate-repo-templates.sh renders each recipe anchor's find + replace
# AND the class-A .hbs with these values and asserts anchored-region drift:
#   (1) find@upstream still occurs in the freshly-pulled base
#   (2) replace@upstream == find@upstream (round-trip no-op)
#   (3) each class-A whole-file .hbs renders byte-identical to the base file
#
# NOT consumed at emit time — the driver derives REAL tenant values. Oracle only.
CLUSTER_DOMAIN="snapdragon.systems"
BRAND_TITLE="Snapdragon"
NPM_SCOPE="snapdragon"
HOST_NAME="snapdragon-host"
GENERATOR_ORG_GROUP="hugmesh-net/snapdragon-generator"
APP_SLUG="login"
TITLE_WORD="Login"
