apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: gateway-{{PROFILE}}
  labels:
    app.kubernetes.io/name: hugmesh-{{PROFILE}}-gateway
spec:
  rules:
    # Brand ingress host = the tenant cluster domain. The /api/** route seed is
    # brand-neutral (mirrors the gateway's Path=/api/** predicate).
    - host: "{{CLUSTER_DOMAIN}}"
      http:
        paths:
          - path: /api
            pathType: Prefix
            backend:
              service:
                name: hugmesh-{{PROFILE}}-gateway
                port:
                  number: 8080
