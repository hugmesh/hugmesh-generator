# _identity.env — UPSTREAM-IDENTITY drift oracle for the GATEWAY archetype.
#
# EXEMPLAR MEMBER = snapdragon-gateway (be profile). The gateway source carries
# exactly ONE brand token (the CI include org/group); the rest of the brand
# coupling is NEW deploy env (deploy/*.hbs, class-A — no upstream literal to
# drift against, so only the CI anchor participates in the drift oracle).
#
# scripts/validate-repo-templates.sh asserts the CI anchor's find@upstream is
# still present in the freshly-pulled base and round-trips (replace@upstream==find).
#
# NOT consumed at emit time. Oracle only.
CLUSTER_DOMAIN="snapdragon.systems"
GENERATOR_ORG_GROUP="Snapdragon-Systems/snapdragon-generator"
PROFILE="be"
