# {{BRAND_TITLE}} casdoor ExternalSecrets — ESO materialization of this brand's
# own-IdP credentials from Vault (ClusterSecretStore "hugmesh-vault").
# Generated from hugmesh-generator/templates/manifests/casdoor/external-secrets.yaml.hbs
#
# VAULT PATH: secret/{{BRAND}}/casdoor — the PHASE5-DECISIONS #3 convention
# (base segment == brand slug), ONE KV document with three properties
# (db_password_plain / admin_password / app_client_secret), mirroring the
# secret/hugmesh/casdoor-games exemplar. The path is minted at DOMAIN-CREATION
# time (operator / DomainReconciler lane — docs/DOMAIN-IDP.md), never by
# gen-cluster-secrets.sh; until it exists these stay unsynced and the casdoor
# pods stay pending on their Secret mounts — fail-closed, per-brand, loud.
apiVersion: external-secrets.io/v1beta1
kind: ExternalSecret
metadata:
  name: {{BRAND}}-casdoor-db
  labels: { app: {{BRAND}}-casdoor, app.kubernetes.io/part-of: {{CLUSTER_DOMAIN}} }
spec:
  refreshInterval: 1h
  secretStoreRef:
    name: hugmesh-vault
    kind: ClusterSecretStore
  target:
    name: {{BRAND}}-casdoor-db
    creationPolicy: Owner
    template:
      data:
        # Fixed DB role name (matches pg.yaml's POSTGRES_DB/probe user); only
        # the password is per-brand material.
        username: "casdoor"
        password: "{{ .password }}"
  data:
    - secretKey: password
      remoteRef:
        key: {{BRAND}}/casdoor
        property: db_password_plain
---
# Admin login the {{BRAND}}-casdoor-init Job uses to drive this brand's Casdoor
# API (and the value it SETS as the built-in admin's password, replacing the
# publicly known casdoor bootstrap default — see init-job.yaml).
apiVersion: external-secrets.io/v1beta1
kind: ExternalSecret
metadata:
  name: {{BRAND}}-casdoor-admin
  labels: { app: {{BRAND}}-casdoor, app.kubernetes.io/part-of: {{CLUSTER_DOMAIN}} }
spec:
  refreshInterval: 1h
  secretStoreRef:
    name: hugmesh-vault
    kind: ClusterSecretStore
  target:
    name: {{BRAND}}-casdoor-admin
    creationPolicy: Owner
    template:
      data:
        username: "admin"
        password: "{{ .password }}"
  data:
    - secretKey: password
      remoteRef:
        key: {{BRAND}}/casdoor
        property: admin_password
---
# The brand OAuth2 application's client secret (the confidential half of the
# {{BRAND}}-client id) — injected into the application object by the init Job,
# never committed, never a ConfigMap literal.
apiVersion: external-secrets.io/v1beta1
kind: ExternalSecret
metadata:
  name: {{BRAND}}-casdoor-app
  labels: { app: {{BRAND}}-casdoor, app.kubernetes.io/part-of: {{CLUSTER_DOMAIN}} }
spec:
  refreshInterval: 1h
  secretStoreRef:
    name: hugmesh-vault
    kind: ClusterSecretStore
  target:
    name: {{BRAND}}-casdoor-app
    creationPolicy: Owner
    template:
      data:
        clientSecret: "{{ .clientSecret }}"
  data:
    - secretKey: clientSecret
      remoteRef:
        key: {{BRAND}}/casdoor
        property: app_client_secret
