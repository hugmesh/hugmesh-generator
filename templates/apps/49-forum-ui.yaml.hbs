# {{BRAND_TITLE}} forum-ui — phpBB forum Angular MFE remote (/social/forum/**).
# Generated from hugmesh-generator/templates/apps/49-forum-ui.yaml.hbs
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: {{BRAND}}-forum-ui
  namespace: devops
spec:
  project: default
  source:
    repoURL: https://github.com/hugmesh-net/hugmesh-generator.git
    targetRevision: main
    path: specs/cluster/manifests/forum-ui
    kustomize:
      namespace: {{BRAND}}-frontend
      images:
        - name: hugmesh-systems/forum-ui
          newName: registry.{{CLUSTER_DOMAIN}}/{{HARBOR_PROJECT}}/{{BRAND}}-forum-ui
          newTag: main
  destination:
    server: https://kubernetes.default.svc
    namespace: {{BRAND}}-frontend
  syncPolicy:
    automated: { prune: true, selfHeal: true }
    syncOptions: [CreateNamespace=true]
