# {{BRAND_TITLE}} fe-gateway — front door for {{CLUSTER_DOMAIN}} (Angular host) + MFE remotes.
# Generated from hugmesh-generator/templates/apps/20-gateway-fe.yaml.hbs
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: {{BRAND}}-gateway-fe
  namespace: devops
spec:
  project: default
  source:
    repoURL: https://github.com/hugmesh/hugmesh-generator.git
    targetRevision: main
    path: specs/cluster/charts/hugmesh-gateway
    helm:
      releaseName: {{BRAND}}-fe-gateway
      values: |
        # PRE-EXISTING BUG fix (found migrating the core cluster to Harbor) —
        # see templates/apps/20-gateway-be.yaml.hbs's identical comment: the
        # chart's default image.repository now hardcodes the reference
        # cluster's own Harbor project, so every brand must override it here.
        image:
          repository: registry.{{CLUSTER_DOMAIN}}/{{HARBOR_PROJECT}}/{{BRAND}}-gateway
        imagePullSecrets:
          - name: harbor-registry
        instance:
          name: {{BRAND}}-fe-gateway
        # ── Gateway MFA enforcement (issue #47) — the PER-DOMAIN flip. Rendered
        # from the brand profile's MFA knob (brands/<brand>.conf MFA=1 -> true;
        # absent/0/false/off -> false), so enforcement scopes to THIS brand's
        # CLUSTER_DOMAIN only. Only app.mfa.enabled is templated: freshnessWindow
        # keeps the chart default (600000; helm merges maps) and
        # enforcePrivilegedFloor is NEVER templated — it is live enforcement on
        # its own even with enabled=false and locks un-enrolled SUPERADMINs out
        # (docs/MFA-ROLLOUT.md §2 / §3 step 7). Enroll BEFORE you enforce applies
        # to a tenant flip too. Wiring gated by tests/stack/test-mfa-flip-wiring.sh.
        mfa:
          enabled: {{MFA_ENABLED}}
        keystore:
          enabled: true
        ingress:
          enabled: true
          className: nginx
          host: {{CLUSTER_DOMAIN}}
          extraHosts:
            - "*.{{CLUSTER_DOMAIN}}"
        nodeSelector:
          {{CLUSTER_DOMAIN}}/frontend: "true"
        seLinux:
          level: "s0:c13"
        extraEnv:
          - name: ROUTE_ACCESS_DB_PASSWORD
            valueFrom:
              secretKeyRef:
                name: route-access-fe-gateway
                key: password
          - name: ROUTE_ACCESS_R2DBC_URL
            value: r2dbc:postgresql://fe_gateway:$(ROUTE_ACCESS_DB_PASSWORD)@route-access-db.{{BRAND}}-pki.svc.cluster.local:5432/gateway
          - name: HUGMESH_GATEWAY_MTLS_ENABLED
            value: "true"
          # ── BFF session bridge: opaque bff_ → Spring SecurityContext ──────────
          # Mirrors specs/cluster/apps/20-gateway-fe.yaml (kept in sync by hand):
          # BffSessionAuthFilter introspects a bff_ session against admin-bff so
          # cookie-mode browser requests authenticate at this gateway. BLANK/absent
          # INTERNAL_TOKEN → no-op on both sides (secret optional).
          - { name: APP_BFF_SESSION_ENABLED, value: "true" }
          - name: BFF_BASE_URL
            value: http://{{BRAND}}-admin-bff-api.{{BRAND}}-backend.svc.cluster.local:8080
          - name: INTERNAL_TOKEN
            valueFrom:
              secretKeyRef:
                name: bff-internal-token
                key: token
                optional: true
        routes:
          # ROUTE PARITY with specs/cluster/apps/20-gateway-fe.yaml (#559): the
          # same routes, in the same order, with the primary's cluster domain and
          # service-name prefix replaced by this brand's own. The reasons
          # for each route and its position are written once, beside the primary
          # table; read them there. Gated by
          # tests/scripts/test-fe-template-route-parity.sh, which renders this
          # file with both engines and compares it to the primary table route by
          # route (id, path, predicates, uri, filters, order). A route that must
          # stay primary-only goes on that guard's exclusion list with a reason,
          # never silently missing from here.
          #
          # Spring Cloud Gateway matches FIRST-IN-DECLARED-ORDER, so a more
          # specific path always sits above the subtree route that would swallow
          # it: /games/api/** above /games/**, /bff/register/complete above
          # /bff/register/**, /bff/me/appeal above /bff/me/**, every /bff/<x>
          # route above the /bff/** catch-all, and /** last.
          #
          # SPA deep-link fallback, MUST STAY FIRST: an HTML navigation to an
          # in-shell remote's path boots the host shell; assets, XHR and
          # remoteEntry.json (no text/html Accept) fall through to the remote
          # routes below.
          - id: remote-deeplink-to-host-shell
            uri: http://{{BRAND}}-host-shell.{{BRAND}}-frontend.svc.cluster.local:80
            path: /social/matrix/**,/social/mastodon/**,/social/forum/**,/wiki/**,/tube/**,/owncast/**,/character-studio/**,/character-forge/**,/admin/**,/mod/**,/user/**,/games/**
            header: "Accept, .*text/html.*"
          # Each remote below is its own standalone nginx bundle (own
          # index.html/remoteEntry.json at its own webroot), so StripPrefix maps
          # the gateway-prefixed path back to that webroot.
          - id: matrix-ui
            uri: http://{{BRAND}}-matrix-ui.{{BRAND}}-frontend.svc.cluster.local:80
            path: /social/matrix/**
            filters:
              - StripPrefix=2
          - id: mastodon-ui
            uri: http://{{BRAND}}-mastodon-ui.{{BRAND}}-frontend.svc.cluster.local:80
            path: /social/mastodon/**
            filters:
              - StripPrefix=2
          - id: forum-ui
            uri: http://{{BRAND}}-forum-ui.{{BRAND}}-frontend.svc.cluster.local:80
            path: /social/forum/**
            filters:
              - StripPrefix=2
          # login-ui is a STANDALONE Angular app built with base-href=/login/, so
          # StripPrefix=1 maps /login/<asset> back to the webroot nginx serves.
          - id: login-ui
            uri: http://{{BRAND}}-login-ui.{{BRAND}}-frontend.svc.cluster.local:80
            path: /login/**
            filters:
              - StripPrefix=1
          - id: admin-ui
            uri: http://{{BRAND}}-admin-ui.{{BRAND}}-frontend.svc.cluster.local:80
            path: /admin/**
            filters:
              - StripPrefix=1
          - id: mod-ui
            uri: http://{{BRAND}}-mod-ui.{{BRAND}}-frontend.svc.cluster.local:80
            path: /mod/**
            filters:
              - StripPrefix=1
          - id: user-ui
            uri: http://{{BRAND}}-user-ui.{{BRAND}}-frontend.svc.cluster.local:80
            path: /user/**
            filters:
              - StripPrefix=1
          - id: character-studio-ui
            uri: http://{{BRAND}}-character-studio-ui.{{BRAND}}-frontend.svc.cluster.local:8080
            path: /character-studio/**
            filters:
              - StripPrefix=1
          - id: character-forge-ui
            uri: http://{{BRAND}}-character-forge-ui.{{BRAND}}-frontend.svc.cluster.local:8080
            path: /character-forge/**
            filters:
              - StripPrefix=1
          # games-bff (/games/api/**) BEFORE games-ui (/games/**), or the
          # remote's nginx swallows every API call.
          - id: games-bff
            uri: http://{{BRAND}}-games.{{BRAND}}-games.svc.cluster.local:8080
            path: /games/api/**
            filters:
              - StripPrefix=1
          - id: games-ui
            uri: http://{{BRAND}}-games-ui.{{BRAND}}-frontend.svc.cluster.local:8080
            path: /games/**
            filters:
              - StripPrefix=1
          - id: api-docs
            uri: http://{{BRAND}}-api-docs.{{BRAND}}-frontend.svc.cluster.local:80
            path: /api-docs/**
            filters:
              - StripPrefix=1
          # Same-origin BFFs, more specific subpaths BEFORE the /bff/** catch-all.
          - id: {{BRAND}}-mod-bff-api
            uri: https://{{BRAND}}-mod-bff-api.{{BRAND}}-backend.svc.cluster.local:8080
            path: /bff/mod/**
          - id: {{BRAND}}-user-bff-api
            uri: https://{{BRAND}}-user-bff-api.{{BRAND}}-backend.svc.cluster.local:8080
            path: /bff/user/**
          - id: {{BRAND}}-forum-bff-api-moderation
            uri: https://{{BRAND}}-forum-bff-api.{{BRAND}}-backend.svc.cluster.local:8080
            path: /bff/forum/moderation/**
          - id: {{BRAND}}-forum-bff-api
            uri: https://{{BRAND}}-forum-bff-api.{{BRAND}}-backend.svc.cluster.local:8080
            path: /bff/forum/**
          - id: {{BRAND}}-wiki-bff-api-admin
            uri: https://{{BRAND}}-wiki-bff-api.{{BRAND}}-backend.svc.cluster.local:8080
            path: /bff/wiki/admin/**
          - id: {{BRAND}}-wiki-bff-api
            uri: https://{{BRAND}}-wiki-bff-api.{{BRAND}}-backend.svc.cluster.local:8080
            path: /bff/wiki/**
          - id: {{BRAND}}-mesh-bff-api
            uri: https://{{BRAND}}-mesh-bff-api.{{BRAND}}-backend.svc.cluster.local:8080
            path: /bff/mesh/**
          - id: {{BRAND}}-character-forge-bff-api
            uri: https://{{BRAND}}-character-forge-bff-api.{{BRAND}}-backend.svc.cluster.local:8080
            path: /bff/character-forge/**
          # SSO login/session/registration live on user-bff; exact paths, each
          # above the /bff/** admin-bff catch-all.
          - id: {{BRAND}}-user-bff-api-login
            uri: https://{{BRAND}}-user-bff-api.{{BRAND}}-backend.svc.cluster.local:8080
            path: /bff/login
          - id: {{BRAND}}-user-bff-api-password-reset-request
            uri: https://{{BRAND}}-user-bff-api.{{BRAND}}-backend.svc.cluster.local:8080
            path: /bff/password-reset/request
          - id: {{BRAND}}-user-bff-api-password-reset-confirm
            uri: https://{{BRAND}}-user-bff-api.{{BRAND}}-backend.svc.cluster.local:8080
            path: /bff/password-reset/confirm
          # CARVE-OUT: registration stage 2 is served by admin-bff, not user-bff.
          # It MUST sit above /bff/register/** or the subtree route sends the
          # stage-2 POST to a service that does not implement it (404), and no
          # account can finish onboarding.
          - id: {{BRAND}}-admin-bff-api-register-complete
            uri: https://{{BRAND}}-admin-bff-api.{{BRAND}}-backend.svc.cluster.local:8080
            path: /bff/register/complete
          - id: {{BRAND}}-user-bff-api-register
            uri: https://{{BRAND}}-user-bff-api.{{BRAND}}-backend.svc.cluster.local:8080
            path: /bff/register/**
          # CARVE-OUT: the ban appeal is served by admin-bff under user-bff's
          # /bff/me/** prefix. It MUST sit above /bff/me/** or a suspended
          # account's own appeal 404s.
          - id: {{BRAND}}-admin-bff-api-me-appeal
            uri: https://{{BRAND}}-admin-bff-api.{{BRAND}}-backend.svc.cluster.local:8080
            path: /bff/me/appeal
          - id: {{BRAND}}-user-bff-api-me
            uri: https://{{BRAND}}-user-bff-api.{{BRAND}}-backend.svc.cluster.local:8080
            path: /bff/me/**
          - id: {{BRAND}}-user-bff-api-session
            uri: https://{{BRAND}}-user-bff-api.{{BRAND}}-backend.svc.cluster.local:8080
            path: /bff/session
          # The POST sign-out alias the clients call; without it sign-out falls
          # through to admin-bff and is a no-op.
          - id: {{BRAND}}-user-bff-api-sessionout
            uri: https://{{BRAND}}-user-bff-api.{{BRAND}}-backend.svc.cluster.local:8080
            path: /bff/sessionOut
          - id: {{BRAND}}-user-bff-api-provision
            uri: https://{{BRAND}}-user-bff-api.{{BRAND}}-backend.svc.cluster.local:8080
            path: /bff/provision/**
          - id: {{BRAND}}-admin-bff-api
            uri: https://{{BRAND}}-admin-bff-api.{{BRAND}}-backend.svc.cluster.local:8080
            path: /bff/**
          - id: remote-fragment
            uri: http://{{BRAND}}-remote-fragment.{{BRAND}}-frontend.svc.cluster.local:80
            path: /_fragments/**
          # External client protocol surfaces (Matrix / Mastodon clients): before
          # the host-only vanity route and the /** catch-all, both of which would
          # otherwise swallow them.
          - id: matrix-cs-api
            uri: https://tuwunel-proxy.{{BRAND}}-backend.svc.cluster.local:4443
            path: /_matrix/**
          - id: matrix-wellknown
            uri: https://tuwunel-proxy.{{BRAND}}-backend.svc.cluster.local:4443
            path: /.well-known/matrix/client,/.well-known/matrix/server
          - id: mastodon-client-api
            uri: https://akkoma-proxy.{{BRAND}}-backend.svc.cluster.local:4443
            path: /api/v1/**,/api/v2/**
          - id: mastodon-oauth
            uri: https://akkoma-proxy.{{BRAND}}-backend.svc.cluster.local:4443
            path: /oauth/**
          - id: be-default
            uri: http://{{BRAND}}-be-gateway.{{BRAND}}-backend.svc.cluster.local:8080
            path: /be/**
            filters:
              - StripPrefix=1
          # Vanity subdomains: <username>.<cluster domain>. Host-only predicate,
          # AFTER every path route and BEFORE the /** catch-all. `vanity: true`
          # marks the route the chart's vanityDomains list extends.
          - id: vanity-subdomain
            host: "*.{{CLUSTER_DOMAIN}}"
            vanity: true
            uri: https://{{BRAND}}-federation-api.{{BRAND}}-backend.svc.cluster.local:8080
            filters:
              - SetPath=/api/federation/vanity
          - id: frontend-host
            uri: http://{{BRAND}}-host-shell.{{BRAND}}-frontend.svc.cluster.local:80
            path: /**
  destination:
    server: https://kubernetes.default.svc
    namespace: {{BRAND}}-frontend
  syncPolicy:
    automated: { prune: true, selfHeal: true }
    syncOptions: [CreateNamespace=true]
