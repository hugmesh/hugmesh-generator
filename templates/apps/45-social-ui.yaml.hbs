# {{BRAND_TITLE}} social-ui — Matrix + Mastodon + login + admin Angular MFE remotes.
# Generated from hugmesh-generator/templates/apps/45-social-ui.yaml.hbs
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: {{BRAND}}-social-ui
  namespace: devops
spec:
  project: default
  source:
    repoURL: https://github.com/Snapdragon-Systems/hugmesh-generator.git
    targetRevision: main
    path: specs/cluster/manifests/social-ui
    kustomize:
      namespace: {{BRAND}}-frontend
      images:
        - name: snapdragon-systems/matrix-ui
          newName: registry.{{CLUSTER_DOMAIN}}/{{HARBOR_PROJECT}}/{{BRAND}}-matrix-ui
          newTag: main
        - name: snapdragon-systems/mastodon-ui
          newName: registry.{{CLUSTER_DOMAIN}}/{{HARBOR_PROJECT}}/{{BRAND}}-mastodon-ui
          newTag: main
        - name: snapdragon-systems/login-ui
          newName: registry.{{CLUSTER_DOMAIN}}/{{HARBOR_PROJECT}}/{{BRAND}}-login-ui
          newTag: main
        - name: snapdragon-systems/admin-ui
          newName: registry.{{CLUSTER_DOMAIN}}/{{HARBOR_PROJECT}}/{{BRAND}}-admin-ui
          newTag: main
  destination:
    server: https://kubernetes.default.svc
    namespace: {{BRAND}}-frontend
  syncPolicy:
    automated: { prune: true, selfHeal: true }
    syncOptions: [CreateNamespace=true]
