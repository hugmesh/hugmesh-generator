<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>{{BRAND_TITLE}}</title>
  <base href="/" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <script src="snap-config.js"></script>
</head>
<body>
  <!-- Base-absent skeleton: a minimal, bootable login shell. The real remote
       (Angular native-federation) replaces snap-login-root when the Tier-2 base
       is pullable; this fallback renders a static, branded holding page so the
       tenant is never left with nothing. -->
  <snap-login-root>
    <main style="font-family: system-ui, sans-serif; max-width: 24rem; margin: 4rem auto; text-align: center;">
      <h1>{{BRAND_TITLE}}</h1>
      <p>Sign-in is starting…</p>
    </main>
  </snap-login-root>
</body>
</html>
