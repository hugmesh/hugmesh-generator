# nginx.conf — minimal static server for the base-absent login-ui skeleton.
# Brand-neutral (untemplated in the Tier-1 overlay); included here so the
# skeleton tenant tree is self-contained and directly servable.
server {
  listen 8080;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  location = /snap-config.js {
    add_header Cache-Control "no-store";
    try_files $uri =404;
  }

  location / {
    try_files $uri $uri/ /index.html;
  }
}
