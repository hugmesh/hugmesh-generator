<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>{{BRAND_TITLE}}</title>
  <base href="/" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <!-- Runtime SPA config, written at container start by
       docker-entrypoint.d/40-snap-config.sh from env vars and served no-store
       (see nginx.conf). This classic script (in the document head) runs BEFORE
       the deferred module bundles Angular injects, so the window.__SNAP_*__
       globals (the BFF URL + the session-custody flag) exist before the app
       reads them. The nginx sub_filter tags it with the CSP nonce, and
       same-origin 'self' in script-src covers it either way.
       NOTE: keep literal tag tokens out of this comment — the Angular index
       writer injects es-module-shims config after the first such token. -->
  <!-- RELATIVE (no leading slash) so it resolves against the app base href — /login/
       when served standalone under the /login prefix — instead of the origin root
       (which the fe-gateway routes to the systems-web host, where it 404s). -->
  <script src="snap-config.js"></script>
</head>
<body>
  <snap-login-root></snap-login-root>
</body>
</html>
