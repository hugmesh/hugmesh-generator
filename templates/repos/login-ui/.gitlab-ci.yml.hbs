# Snapdragon CI — build + push this service's container image to the in-cluster
# GitLab container registry. The GitHub repo is pull-mirrored into in-cluster
# GitLab (mirror_trigger_builds=true), so this runs on push / mirror-sync on the
# privileged x86 runner (shell executor with docker, matching the generator CI).
# Images carry NO keys — KEYS material is supplied from the USB at first boot.

# Centralized OWASP pen-test stage (SCA + authenticated ZAP DAST) — one source of
# truth, maintained in the generator repo. Pulls in the hidden .pentest-* jobs.
include:
  - project: '{{GENERATOR_ORG_GROUP}}'
    ref: main
    file: '/tests/pentest/ci/pentest-stage.gitlab-ci.yml'

stages: [test, build, pentest]

test:
  stage: test
  tags: [snapdragon-x86, privileged]
  rules:
    - if: '$CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH'
    - if: '$CI_PIPELINE_SOURCE == "merge_request_event"'
    - if: '$CI_COMMIT_TAG'
  script:
    - docker run --rm --shm-size=1gb -v "${CI_PROJECT_DIR}:/workspace:ro" -w /workspace node:24-alpine sh -c "apk add --no-cache chromium && npm ci && CHROME_BIN=/usr/bin/chromium npm test"
  artifacts:
    when: always
    reports:
      junit:
        - reports/TESTS-*.xml
        - test-results/results.xml
    paths:
      - reports/
      - test-results/
    expire_in: 7 days

# -----------------------------------------------------------------------------
# UI e2e — Playwright + playwright-bdd (Gherkin) auth-entry-point harness.
# SHIPS DARK: every scenario is @cluster and the Before hook runtime-skips it
# unless E2E_LIVE=1 (a reachable integration-test host), so with no host this job
# runs the OFFLINE GATE — npm install, generate the BDD specs (`bddgen`), prove
# every scenario compiles + every Gherkin step is bound (`--list`), then run the
# suite (all scenarios skip → green). allow_failure so a harness hiccup surfaces
# in the MR widget without blocking the additive image pipeline. Runs in its own
# isolated `e2e/` workspace; no app/karma change. Uses the pre-baked Playwright
# image (Chromium + OS deps inside) on the privileged x86 runner.
e2e:bdd:
  stage: test
  tags: [snapdragon-x86, privileged]
  allow_failure: true
  rules:
    - if: '$CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH'
    - if: '$CI_PIPELINE_SOURCE == "merge_request_event"'
  script:
    - >
      docker run --rm -v "${CI_PROJECT_DIR}/e2e:/work" -w /work
      mcr.microsoft.com/playwright:v1.49.0-jammy
      sh -c "npm install --no-audit --no-fund &&
             npx bddgen &&
             npx playwright test --list &&
             npx playwright test --reporter=list"
  artifacts:
    when: always
    paths:
      - e2e/results/
    expire_in: 7 days

build:image:
  needs: [test]
  stage: build
  tags: [snapdragon-x86, privileged]
  rules:
    - if: '$CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH'
    - if: '$CI_COMMIT_TAG'
  script:
    - echo "$CI_REGISTRY_PASSWORD" | docker login -u "$CI_REGISTRY_USER" --password-stdin "$CI_REGISTRY"
    # Immutable tag = release tag or git SHA; plus a moving branch tag the deploy/
    # kustomize can track for dev.
    - export TAG="${CI_COMMIT_TAG:-$CI_COMMIT_SHORT_SHA}"
    - docker build --pull -t "$CI_REGISTRY_IMAGE:$TAG" -t "$CI_REGISTRY_IMAGE:$CI_COMMIT_REF_SLUG" .
    - docker push "$CI_REGISTRY_IMAGE:$TAG"
    - docker push "$CI_REGISTRY_IMAGE:$CI_COMMIT_REF_SLUG"

# -----------------------------------------------------------------------------
# OWASP pen-test stage — thin jobs that extend the centralized hidden jobs
# (.pentest-sca / .pentest-dast-baseline) included from the generator repo above.
# Non-blocking (allow_failure) so a finding surfaces in the MR widget without
# breaking the additive build/image pipeline. Rules mirror this repo's existing
# security-job rules: default branch + merge requests.
# -----------------------------------------------------------------------------
pentest:sca:
  extends: .pentest-sca
  allow_failure: true
  rules:
    - if: '$CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH'
    - if: '$CI_PIPELINE_SOURCE == "merge_request_event"'

pentest:dast:
  extends: .pentest-dast-baseline
  allow_failure: true
  rules:
    - if: '$CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH'
    - if: '$CI_PIPELINE_SOURCE == "merge_request_event"'
