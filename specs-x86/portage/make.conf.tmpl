# Native amd64 build — HARDENED — for the snapdragon-host k8s/GPU worker.
#
# Variables substituted at build time:
#   @@CHOST@@       Host triplet (x86_64-pc-linux-gnu)
#   @@JOBS@@        Parallel make jobs
#   @@WORK_DIR@@    Base build directory

CHOST="@@CHOST@@"

# Generic, portable hardened flags. -march=native would tie the image to the
# build host's CPU; x86-64-v2 is a safe baseline for modern desktops/servers.
COMMON_FLAGS="-march=x86-64-v2 -O2 -pipe -fstack-protector-strong -D_FORTIFY_SOURCE=2"
CFLAGS="${COMMON_FLAGS}"
CXXFLAGS="${COMMON_FLAGS}"
LDFLAGS="-Wl,-O1 -Wl,--as-needed -Wl,-z,relro -Wl,-z,now"

MAKEOPTS="-j@@JOBS@@"
# -userfetch/-userpriv: don't drop to the 'portage' user (can't traverse a
# mode-700 / encrypted work dir). Sandbox off for the native chroot build.
FEATURES="buildpkg nostrip -userfetch -userpriv -usersandbox -sandbox -pid-sandbox -network-sandbox -ipc-sandbox"
# Chroot-INTERNAL cache paths. The old @@WORK_DIR@@/{pkgdir,distfiles} rendered
# to the HOST-absolute build dir, which inside the chroot resolves UNDER the
# sysroot (sysroot/home/...): binpkgs+distfiles (2.4 GB) then got baked into
# every stage4/.img/squashfs (var/cache IS excluded; that home path was not),
# leaking host paths and bloating artifacts. /var/cache is excluded from the
# stage4 tar + squashfs, so these never ship, and they persist across the 4
# roles in one shared sysroot so role 2-4 reuse role 1's binpkgs (--usepkg).
PKGDIR="/var/cache/binpkgs"
DISTDIR="/var/cache/distfiles"

# Hardened USE baseline + container runtime + (optional) vendor-agnostic GPU stack.
# @@GPU_USE@@ expands to the GPU USE flags (vulkan vaapi vdpau gbm egl gles2) for
# the be+gpu / omnibus roles, and to nothing for the headless pki/be/fe roles.
USE="bindist hardened pie ssp -X -gtk -qt5 -qt6 -systemd -pulseaudio -bluetooth"
USE="${USE} cgroup cgroup2 seccomp selinux containers netlink"
USE="${USE} @@GPU_USE@@"

# Build only the MCS SELinux policy: provision_selinux() and containerd's per-pod
# MCS labelling both target type=mcs. Pinning this avoids relying on the profile
# default and skips compiling the unused strict/targeted/mls stores (faster build).
POLICY_TYPES="mcs"

# Open, vendor-agnostic GPU: AMD (amdgpu/radeonsi), Intel (i915/iris),
# NVIDIA via nouveau. No proprietary blobs. @@VIDEO_CARDS@@ expands to that list
# for the be+gpu / omnibus roles, and to nothing (no DRI drivers) for headless
# pki/be/fe roles.
VIDEO_CARDS="@@VIDEO_CARDS@@"
INPUT_DEVICES=""

ACCEPT_LICENSE="* -@EULA"
ACCEPT_KEYWORDS="amd64"

GRUB_PLATFORMS="efi-64 pc"

PYTHON_TARGETS="python3_12"
PYTHON_SINGLE_TARGET="python3_12"

PAX_MARKINGS="none"
