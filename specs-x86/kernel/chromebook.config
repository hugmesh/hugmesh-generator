# amd64 CHROMEBOOK kernel fragment — appended on top of desktop.config ONLY for
# `--role chromebook` (ADR-16: coreboot-UEFI target, e.g. a device reflashed with
# MrChromebox/Tianocore so GRUB-EFI --removable boots normally). desktop.config
# already carries the EC core + EC keyboard + pstore + I2C-i801; this fragment adds
# the chromebook-specific peripherals a generic x86 laptop image lacks: I2C-attached
# touchpads, I2C-HID, the DesignWare I2C bus those hang off, the I2S audio codecs +
# jack detect + SOC machine drivers, the EC sub-devices (charger/extcon/sensors/
# backlight), and the on-board TPM. Lines applied with `scripts/config --<action>`.

# I2C bus most chromebook peripherals (touchpad, audio jack, sensors) hang off
enable CONFIG_I2C_DESIGNWARE_CORE
enable CONFIG_I2C_DESIGNWARE_PLATFORM
enable CONFIG_I2C_DESIGNWARE_PCI
enable CONFIG_I2C_HID
enable CONFIG_I2C_HID_ACPI
enable CONFIG_PINCTRL
enable CONFIG_PINCTRL_INTEL

# I2C-attached touchpads/touchscreens used across chromebook models
enable CONFIG_MOUSE_ELAN_I2C
enable CONFIG_MOUSE_ELAN_I2C_I2C
enable CONFIG_TOUCHSCREEN_ELAN
enable CONFIG_TOUCHSCREEN_ATMEL_MXT
enable CONFIG_MOUSE_CYAPA
enable CONFIG_KEYBOARD_ATMEL_MXT

# Chrome EC sub-devices: charger, extcon (USB-C), MFD sensors, EC-driven backlight
enable CONFIG_CHARGER_CROS_USBPD
enable CONFIG_EXTCON_USBC_CROS_EC
enable CONFIG_CROS_EC_SENSORS
enable CONFIG_IIO
enable CONFIG_CROS_EC_LPC
enable CONFIG_CROS_EC_ISHTP
enable CONFIG_SENSORS_CROS_EC

# I2S / SOC audio: codecs + jack detect + the Intel machine drivers chromebooks use
enable CONFIG_SND_SOC
enable CONFIG_SND_SOC_CROS_EC_CODEC
enable CONFIG_SND_SOC_MAX98090
enable CONFIG_SND_SOC_TS3A227E
enable CONFIG_SND_SOC_RT5677
enable CONFIG_SND_SOC_RT5645
enable CONFIG_SND_SOC_DA7219
enable CONFIG_SND_SOC_INTEL_SST
enable CONFIG_SND_SOC_INTEL_SKYLAKE
enable CONFIG_SND_SOC_SOF_TOPLEVEL
enable CONFIG_SND_SOC_SOF_INTEL_TOPLEVEL

# On-board TPM (chromebooks ship a TPM; also the FD-07 LUKS TPM2 auto-unlock path)
enable CONFIG_TCG_TPM
enable CONFIG_TCG_TIS
enable CONFIG_TCG_TIS_I2C_CR50
enable CONFIG_TCG_CR50_I2C

# pstore-RAM crash log (chromebook firmware reserves the region)
enable CONFIG_PSTORE
enable CONFIG_PSTORE_RAM
