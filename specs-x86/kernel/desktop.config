# amd64 CLIENT-DESKTOP kernel fragment — appended on top of hardened-k8s.config
# (+ gpu.config) ONLY for client roles (laptop/chromebook/desktop). The KMS/DRM
# drivers come from gpu.config (clients build GPU=true); this fragment adds the
# input / HID / sound / storage / laptop-power / radio / chromebook bits a person's
# device needs and a headless k8s node does not. Lines are applied with
# `scripts/config --<action> <CONFIG_x>` like gpu.config. See docs/CLIENT-IMAGES.md.

# Input: keyboard / mouse / touchpad (libinput reads evdev)
enable CONFIG_INPUT_EVDEV
enable CONFIG_INPUT_KEYBOARD
enable CONFIG_KEYBOARD_ATKBD
enable CONFIG_INPUT_MOUSE
enable CONFIG_MOUSE_PS2
enable CONFIG_INPUT_MOUSEDEV
enable CONFIG_INPUT_TOUCHSCREEN

# USB stack + HID (keyboards, mice, dongles, mass storage)
enable CONFIG_USB_SUPPORT
enable CONFIG_USB
enable CONFIG_USB_XHCI_HCD
enable CONFIG_USB_EHCI_HCD
enable CONFIG_USB_OHCI_HCD
enable CONFIG_USB_HID
enable CONFIG_HID_GENERIC
enable CONFIG_USB_STORAGE

# Sound: ALSA + HD-audio + USB audio
enable CONFIG_SOUND
enable CONFIG_SND
enable CONFIG_SND_HDA_INTEL
enable CONFIG_SND_HDA_CODEC_REALTEK
enable CONFIG_SND_HDA_CODEC_HDMI
module CONFIG_SND_USB_AUDIO

# Storage controllers: NVMe + SATA/AHCI + eMMC/SD (laptops + chromebooks)
enable CONFIG_BLK_DEV_NVME
enable CONFIG_ATA
enable CONFIG_SATA_AHCI
enable CONFIG_ATA_PIIX
enable CONFIG_MMC
enable CONFIG_MMC_BLOCK
enable CONFIG_MMC_SDHCI
enable CONFIG_MMC_SDHCI_PCI

# Laptop power: ACPI battery/AC/buttons, backlight, thermal, cpufreq, suspend
enable CONFIG_ACPI
enable CONFIG_ACPI_BATTERY
enable CONFIG_ACPI_AC
enable CONFIG_ACPI_BUTTON
enable CONFIG_BACKLIGHT_CLASS_DEVICE
enable CONFIG_THERMAL
enable CONFIG_CPU_FREQ
enable CONFIG_X86_INTEL_PSTATE
enable CONFIG_X86_ACPI_CPUFREQ
enable CONFIG_SUSPEND

# CPU microcode loading (Intel + AMD)
enable CONFIG_MICROCODE
enable CONFIG_MICROCODE_INTEL
enable CONFIG_MICROCODE_AMD

# Framebuffer console (the KMS drivers themselves are in gpu.config)
enable CONFIG_FRAMEBUFFER_CONSOLE
enable CONFIG_DRM_FBDEV_EMULATION

# Generic display fallback: simpledrm binds the UEFI GOP (or VESA) framebuffer the
# firmware hands us, so Xorg's `modesetting` driver renders even when no native KMS
# driver attaches — covers QEMU/OVMF boot-verification AND any UEFI laptop/chromebook
# where i915/amdgpu/nouveau fail to bind. bochs/qxl cover QEMU `-vga std|qxl`;
# virtio-gpu is already enabled in the base hardened-k8s.config fragment.
enable CONFIG_SYSFB
enable CONFIG_SYSFB_SIMPLEFB
enable CONFIG_DRM_SIMPLEDRM
module CONFIG_DRM_BOCHS
module CONFIG_DRM_QXL

# Wireless: cfg80211/mac80211 + common laptop/chromebook NICs (as modules)
enable CONFIG_CFG80211
enable CONFIG_MAC80211
module CONFIG_IWLWIFI
module CONFIG_IWLMVM
module CONFIG_ATH9K
module CONFIG_ATH10K
module CONFIG_ATH10K_PCI
module CONFIG_RTW88_8822CE
module CONFIG_MT7921E

# Bluetooth
enable CONFIG_BT
module CONFIG_BT_HCIBTUSB
module CONFIG_BT_INTEL

# Chromebook platform (ADR-16 coreboot-UEFI target: EC + keyboard + pstore)
enable CONFIG_CHROME_PLATFORMS
module CONFIG_CHROMEOS_LAPTOP
module CONFIG_CHROMEOS_PSTORE
enable CONFIG_CROS_EC
module CONFIG_KEYBOARD_CROS_EC
enable CONFIG_MFD_CROS_EC_DEV
enable CONFIG_I2C
enable CONFIG_I2C_I801

# Wired NICs common on laptops/docks (as modules)
module CONFIG_E1000E
module CONFIG_R8169
module CONFIG_IGB

# USB ethernet (docks/dongles)
enable CONFIG_USB_NET_DRIVERS
module CONFIG_USB_USBNET
module CONFIG_USB_NET_CDCETHER
