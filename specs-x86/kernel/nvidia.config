# amd64 kernel fragment — PROPRIETARY NVIDIA driver support.
# Appended on top of gpu.config ONLY when --nvidia-driver proprietary. The
# x11-drivers/nvidia-drivers kmod is built out-of-tree by Portage against these
# sources, so the kernel just has to (a) support loadable modules, (b) NOT bind
# nouveau as a builtin (so the blob owns the GPU — nouveau stays a modular,
# runtime-blacklisted fallback), and (c) provide DRM/KMS + PAT/MTRR for the
# framebuffer + memory typing the driver needs.

# Loadable-module support for the out-of-tree nvidia.ko (x86_64 defconfig sets
# CONFIG_MODULES=y, but assert it explicitly so a defconfig change can't silently
# strip it and leave nvidia-drivers unbuildable).
enable CONFIG_MODULES
enable CONFIG_MODULE_UNLOAD

# nouveau MODULAR (not builtin): a builtin nouveau would bind the GPU before the
# proprietary driver loads. As a module it is blacklisted at runtime via
# /etc/modprobe.d/hugmesh-nvidia.conf, leaving the blob in control while still
# available as a fallback for diagnostics.
module CONFIG_DRM_NOUVEAU

# DRM/KMS + framebuffer plumbing the NVIDIA driver and the boot console need.
enable CONFIG_DRM
enable CONFIG_DRM_FBDEV_EMULATION
enable CONFIG_FB_SIMPLE
enable CONFIG_FRAMEBUFFER_CONSOLE

# Page-Attribute-Table + MTRR: correct write-combining for VRAM/BAR mappings.
enable CONFIG_X86_PAT
enable CONFIG_MTRR
