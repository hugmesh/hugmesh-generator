# amd64 kernel fragment — vendor-agnostic GPU (DRM, open drivers).
# Appended on top of hardened-k8s.config ONLY for the be+gpu / omnibus roles.
# Headless roles (pki/be/fe) keep just the virtio-gpu console framebuffer from
# the base fragment and skip this whole DRM driver stack.

enable CONFIG_DRM
enable CONFIG_DRM_FBDEV_EMULATION
enable CONFIG_DRM_AMDGPU
enable CONFIG_DRM_AMDGPU_SI
enable CONFIG_DRM_AMDGPU_CIK
enable CONFIG_DRM_I915
enable CONFIG_DRM_NOUVEAU
enable CONFIG_FB
enable CONFIG_FRAMEBUFFER_CONSOLE
