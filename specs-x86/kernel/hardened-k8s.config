# amd64 kernel fragment — hardened + Kubernetes (BASE, role-independent).
# Applied on top of `make defconfig` via scripts/config. One action per line.
#
# The GPU/DRM block lives in a SEPARATE fragment (gpu.config) that the builder
# appends ONLY for the be+gpu / omnibus roles. A console framebuffer for headless
# VMs (virtio-gpu) is kept HERE in the base so pki/be/fe still get a usable
# console without dragging in the full DRM driver stack.

# ── Hardened ───────────────────────────────────────────────────────
enable CONFIG_SECURITY
enable CONFIG_SECURITY_NETWORK
enable CONFIG_SECURITY_SELINUX
enable CONFIG_SECURITY_SELINUX_BOOTPARAM
enable CONFIG_SECURITY_SELINUX_DEVELOP
enable CONFIG_DEFAULT_SECURITY_SELINUX
# lockdown is listed FIRST so it activates before any other LSM
set-str CONFIG_LSM "lockdown,yama,selinux,bpf"
# EVERY name in CONFIG_LSM must have its module COMPILED IN, because the kernel
# does not diagnose a name it cannot resolve — it silently initializes a SHORTER
# stack and boots on. yama and bpf rode this string (and the cmdline) as pure
# decoration until 2026-08-14: the pki image booted
#   Command line: ... lsm=lockdown,yama,selinux,bpf lockdown=integrity ...
#   LSM: initializing lsm=lockdown,capability,selinux
# (out/qemu-runs/runs/newbuild2_x86-pki/launch/console.log:11 and :181) because
# neither CONFIG_SECURITY_YAMA nor CONFIG_BPF_LSM was ever set here. Yama is the
# ptrace_scope restriction (a process may only be ptraced by its own ancestors),
# which is the point of naming it at all. The builder now derives the required
# symbols FROM this string, so adding a name without its symbol fails the build.
enable CONFIG_SECURITY_YAMA
disable CONFIG_SECURITY_APPARMOR
enable CONFIG_AUDIT
enable CONFIG_AUDITSYSCALL
enable CONFIG_SECCOMP
enable CONFIG_SECCOMP_FILTER
enable CONFIG_STACKPROTECTOR
enable CONFIG_STACKPROTECTOR_STRONG
enable CONFIG_FORTIFY_SOURCE
enable CONFIG_HARDENED_USERCOPY
enable CONFIG_SLAB_FREELIST_RANDOM
enable CONFIG_SLAB_FREELIST_HARDENED
enable CONFIG_SHUFFLE_PAGE_ALLOCATOR
enable CONFIG_RANDOMIZE_BASE
enable CONFIG_RANDOMIZE_MEMORY
enable CONFIG_INIT_ON_ALLOC_DEFAULT_ON
enable CONFIG_PAGE_TABLE_ISOLATION
enable CONFIG_STRICT_KERNEL_RWX
enable CONFIG_STRICT_MODULE_RWX
disable CONFIG_DEVKMEM
disable CONFIG_PROC_KCORE
disable CONFIG_COMPAT_BRK
enable CONFIG_BUG_ON_DATA_CORRUPTION
set-val CONFIG_DEFAULT_MMAP_MIN_ADDR 65536

# ── Kernel lockdown LSM (cmdline: lockdown=integrity) ──────────────
# Prevents modification of the running kernel (loading unsigned modules,
# writing to /dev/mem, kprobes that redirect, etc.). integrity level is
# safe for K8s: eBPF JIT and signed/unsigned module loading still work.
enable CONFIG_SECURITY_LOCKDOWN_LSM
enable CONFIG_SECURITY_LOCKDOWN_LSM_EARLY

# ── GCC hardening plugins (compile-time mitigations) ──────────────
# Require CONFIG_GCC_PLUGINS parent; Gentoo toolchain includes plugin headers.
enable CONFIG_GCC_PLUGINS
enable CONFIG_GCC_PLUGIN_LATENT_ENTROPY
enable CONFIG_GCC_PLUGIN_STRUCTLEAK
enable CONFIG_GCC_PLUGIN_STRUCTLEAK_BYREF_ALL
enable CONFIG_GCC_PLUGIN_STACKLEAK
enable CONFIG_GCC_PLUGIN_RANDSTRUCT

# ── Additional hardening ───────────────────────────────────────────
# Zero call-used registers on function exit (kernel >= 5.15).
enable CONFIG_ZERO_CALL_USED_REGS
# Detect list_head corruption (double-remove, bad prev/next pointers).
enable CONFIG_DEBUG_LIST
# Disable vsyscall (x86 JOP/ROP gadget source; mirrors cmdline vsyscall=none).
disable CONFIG_X86_VSYSCALL_EMULATION
# Disable hibernation — resume-from-disk bypasses LUKS2 disk encryption.
disable CONFIG_HIBERNATION
# Disable kexec — can be used to load an unsigned kernel, bypassing secure boot.
disable CONFIG_KEXEC
disable CONFIG_KEXEC_FILE
# Panic on kernel oops (prevents privilege escalation from undefined kernel state).
enable CONFIG_PANIC_ON_OOPS
# Auto-reboot 10 s after a kernel panic (matches RPi; keeps nodes self-healing).
set-val CONFIG_PANIC_TIMEOUT 10
# Remove /proc/config.gz (kernel config extraction path).
disable CONFIG_IKCONFIG
disable CONFIG_IKCONFIG_PROC

# ── Cgroup v2 + namespaces (Kubernetes / containers) ──────────────
# Parity with the Pi cgroup-v2 surface (specs-rpi5 lines 90-117): the x86 copy
# was missing the net_cls/net_prio classid controllers (CNI QoS/policy), the
# hugetlb/perf controllers, CGROUP_WRITEBACK (kubelet I/O accounting/eviction),
# and FAIR_GROUP_SCHED (the backend that makes CFS quota actually ENFORCE per-pod
# CPU limits). All =y, all arch-neutral; correctness/parity for CPU-limit
# enforcement + the full cgroup controller set kubelet feature-detects.
# NOTE (kernel >=6.x): PROC_PID_CPUSET now depends on the deprecated CPUSETS_V1
# (cgroup-v1 legacy /proc file) and CGROUP_NS was REMOVED entirely (cgroup
# namespaces are unconditional once NAMESPACES is on). Neither is needed for
# cgroup-v2 k8s — the CPUSETS controller (below) + NAMESPACES provide the real
# functionality — so both were dropped from this fragment AND the build guard.
enable CONFIG_CGROUPS
enable CONFIG_CGROUP_FREEZER
enable CONFIG_CGROUP_PIDS
enable CONFIG_CGROUP_DEVICE
enable CONFIG_CGROUP_CPUACCT
enable CONFIG_CGROUP_PERF
enable CONFIG_CGROUP_SCHED
enable CONFIG_CGROUP_BPF
enable CONFIG_MEMCG
enable CONFIG_BLK_CGROUP
enable CONFIG_CGROUP_WRITEBACK
enable CONFIG_CGROUP_HUGETLB
enable CONFIG_CPUSETS
enable CONFIG_CGROUP_NET_PRIO
enable CONFIG_CGROUP_NET_CLASSID
enable CONFIG_FAIR_GROUP_SCHED
enable CONFIG_CFS_BANDWIDTH
enable CONFIG_NAMESPACES
enable CONFIG_UTS_NS
enable CONFIG_IPC_NS
enable CONFIG_USER_NS
enable CONFIG_PID_NS
enable CONFIG_NET_NS

# ── Misc container requirements ───────────────────────────────────
# POSIX message queues (/dev/mqueue): container-IPC the OCI runtime mounts into
# every pod; was =y on the Pi reference (specs-rpi5) but had drifted OUT of x86.
enable CONFIG_POSIX_MQUEUE

# ── Networking (CNI / kube-proxy / IPVS) ──────────────────────────
# BOOT-CRITICAL for k8s Service networking. This block was a TRUNCATED copy of
# the Pi fragment: it had the CORE enablers (NETFILTER/NF_CONNTRACK/NF_NAT/
# NF_TABLES/IP_NF_*/BRIDGE/VXLAN/IP_VS/VETH/...) but was MISSING the entire
# xtables match/target layer kube-proxy's iptables mode emits, the nft NAT/MASQ/
# CT expressions, NF_NAT_MASQUERADE, the IPv6 netfilter tables, and IP_NF_MANGLE
# — so ClusterIP/NodePort/MASQUERADE/dual-stack/NetworkPolicy were DEAD on x86.
# The added symbols below mirror the Pi reference fragment
# (specs-rpi5/kernel/hardened-k8s.config) one-for-one, all =y (the fragment
# vocabulary has NO module/=m action, so kube-proxy never has to wait for a
# modprobe at early bring-up). A fail-closed guard in build-x86-host-stage4.sh
# asserts the load-bearing subset survives `make olddefconfig`.
enable CONFIG_NETFILTER
enable CONFIG_NETFILTER_ADVANCED
enable CONFIG_NF_CONNTRACK
enable CONFIG_NF_NAT
# NF_NAT_MASQUERADE: the shared NAT-masquerade engine backing BOTH the xtables
# MASQUERADE target and the nft `masquerade` statement. Without it NF_NAT exists
# but cannot masquerade — pod egress SNAT is dead. (Pi line 124)
enable CONFIG_NF_NAT_MASQUERADE
# xtables core + the match/target modules kube-proxy iptables-mode emits. Without
# NETFILTER_XTABLES the whole x_tables layer is absent and kube-proxy cannot
# program ANY rule (KUBE-SERVICES/KUBE-MARK-MASQ chains fail to load). (Pi 125-134)
enable CONFIG_NETFILTER_XTABLES
enable CONFIG_NETFILTER_XT_MATCH_COMMENT
enable CONFIG_NETFILTER_XT_MATCH_MULTIPORT
enable CONFIG_NETFILTER_XT_MATCH_STATISTIC
enable CONFIG_NETFILTER_XT_MATCH_MARK
enable CONFIG_NETFILTER_XT_MATCH_CONNTRACK
enable CONFIG_NETFILTER_XT_MATCH_ADDRTYPE
enable CONFIG_NETFILTER_XT_TARGET_MARK
# XT_TARGET_MASQUERADE: the `-j MASQUERADE` iptables-mode SNAT for pod egress and
# ClusterIP→pod return traffic — the headline MASQUERADE symbol missing on x86.
enable CONFIG_NETFILTER_XT_TARGET_MASQUERADE
enable CONFIG_NETFILTER_XT_TARGET_REDIRECT
enable CONFIG_NF_TABLES
# Per-family nf_tables (IPv4/IPv6): kernel >=6.x gates NFT_NAT/NFT_MASQ on
# NF_TABLES_IPV4 || NF_TABLES_IPV6 — without a family, olddefconfig prunes them.
enable CONFIG_NF_TABLES_IPV4
enable CONFIG_NF_TABLES_IPV6
# nftables NAT/masquerade/conntrack expressions — kube-proxy nftables mode
# (default-eligible in k8s >=1.31) and modern CNIs emit nft `nat`/`masquerade`/
# `ct` rules. x86 had the NF_TABLES base but none of the expressions. (Pi 144-146)
enable CONFIG_NFT_NAT
enable CONFIG_NFT_MASQ
enable CONFIG_NFT_CT
# LEGACY iptables core (kernel >=6.16 split the legacy x_tables out): the
# legacy IPv4/IPv6 *filter/mangle/raw* tables now `depends on
# IP{,6}_NF_IPTABLES_LEGACY`, which in turn `depends on NETFILTER_XTABLES_LEGACY`
# (gated only by !PREEMPT_RT). Without these three parents, `make olddefconfig`
# SILENTLY DROPS IP_NF_MANGLE / IP_NF_FILTER / IP6_NF_{FILTER,MANGLE} (kube-proxy
# iptables-mode mark/mangle chains would be dead). IP_NF_IPTABLES (the new umbrella
# symbol) survives without them but does NOT pull the legacy tables. (6.18 fix.)
enable CONFIG_NETFILTER_XTABLES_LEGACY
enable CONFIG_IP_NF_IPTABLES_LEGACY
enable CONFIG_IP6_NF_IPTABLES_LEGACY
enable CONFIG_IP_NF_IPTABLES
enable CONFIG_IP_NF_NAT
enable CONFIG_IP_NF_FILTER
# IP_NF_MANGLE: the IPv4 mangle table where the KUBE-MARK chains live (mark
# manipulation). x86 had IP_NF_NAT+FILTER but NOT mangle. (Pi line 138)
enable CONFIG_IP_NF_MANGLE
# IPv6 netfilter tables — dual-stack Services + IPv6 NetworkPolicy/masquerade.
# Without these, IPv6/dual-stack service networking is dead. (Pi 139-142)
enable CONFIG_IP6_NF_IPTABLES
enable CONFIG_IP6_NF_FILTER
enable CONFIG_IP6_NF_NAT
enable CONFIG_IP6_NF_MANGLE
enable CONFIG_BRIDGE
enable CONFIG_BRIDGE_NETFILTER
# 802.1Q VLAN driver — VLAN-based CNI underlays / multus / tagged node nets. (Pi 149)
enable CONFIG_VLAN_8021Q
enable CONFIG_VXLAN
enable CONFIG_VETH
enable CONFIG_MACVLAN
enable CONFIG_IPVLAN
enable CONFIG_DUMMY
enable CONFIG_IP_VS
enable CONFIG_IP_VS_NFCT
enable CONFIG_IP_VS_RR
enable CONFIG_IP_VS_WRR
enable CONFIG_IP_VS_SH
# L3 master device (VRF) — calico/overlay/policy + IP_VS routing rely on it. (Pi 162)
enable CONFIG_NET_L3_MASTER_DEV
# HTB qdisc + net_cls cgroup classifier — pod bandwidth annotations (the
# bandwidth CNI plugin) and per-cgroup traffic classification. (Pi 156-157)
enable CONFIG_NET_SCH_HTB
enable CONFIG_NET_CLS_CGROUP

# ── Overlay + BPF (Cilium-ready) ──────────────────────────────────
enable CONFIG_OVERLAY_FS
# overlayfs redirect_dir + index — the containerd overlay snapshotter relies on
# redirect for cross-layer rename support and index for hardlink/copy-up
# correctness; absent can break image layering for some images. (Pi 166-167)
enable CONFIG_OVERLAY_FS_REDIRECT_DIR
enable CONFIG_OVERLAY_FS_INDEX
enable CONFIG_FUSE_FS
enable CONFIG_BPF
enable CONFIG_BPF_SYSCALL
enable CONFIG_BPF_JIT
# Force JIT-only — removes the BPF interpreter (a known kernel attack surface).
enable CONFIG_BPF_JIT_ALWAYS_ON
# BPF_EVENTS: tracepoint/perf-event attach for cilium/CNI BPF programs + bpf
# observability. The non-BTF eBPF prerequisite. (Pi line 176)
enable CONFIG_BPF_EVENTS
# BPF_LSM is what makes the trailing `bpf` in CONFIG_LSM/lsm= resolve to a real
# LSM slot instead of being dropped on the floor (see the CONFIG_LSM note above).
# Its Kconfig deps — SECURITY, BPF_SYSCALL, BPF_JIT, BPF_EVENTS — are ALL enabled
# in this same fragment, so it survives olddefconfig.
# ATTACHING a BPF_PROG_TYPE_LSM program additionally needs BTF; the BTF block just
# below provides it. A booted-image proof that a program really attaches is a
# separate manual test: the build only proves the kernel config.
enable CONFIG_BPF_LSM
enable CONFIG_CGROUP_BPF
enable CONFIG_XDP_SOCKETS
# ── BTF (bpf-LSM attach, eBPF CO-RE) ───────────────────────────────
# CONFIG_DEBUG_INFO_BTF is a hard Kconfig dependency chain, so the whole block
# moves together (tests/scripts/test-btf-pahole-pairing.sh pins every line):
#  * DEBUG_INFO_BTF needs DEBUG_INFO, which only a DWARF choice turns on (the
#    default is DEBUG_INFO_NONE). Selecting DWARF_TOOLCHAIN_DEFAULT is enough: the
#    resolve test shows olddefconfig drops BTF without that line.
#  * DEBUG_INFO_BTF needs dev-util/pahole at CONFIG time (PAHOLE_VERSION is read
#    when Kconfig runs), so pahole must be installed BEFORE `make defconfig`:
#    specs-x86/portage/packages.list plus the guarded top-up emerge in
#    build-x86-host-stage4.sh. If pahole is absent olddefconfig drops BTF
#    silently; the post-olddefconfig guard in the builder turns that into a
#    build failure instead of an image whose bpf LSM can register but not attach.
#  * DEBUG_INFO_BTF depends on !GCC_PLUGIN_RANDSTRUCT. RANDSTRUCT is NOT on in
#    this kernel (the `enable CONFIG_GCC_PLUGIN_RANDSTRUCT` line above is a no-op:
#    the symbol is derived, the choice is RANDSTRUCT_NONE), which is the only
#    reason BTF resolves. Turning struct layout randomisation on later costs BTF,
#    and with it bpf-LSM enforcement. That is a trade-off to decide, not to drift
#    into; the builder guard fails the build if the two collide.
enable CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT
enable CONFIG_DEBUG_INFO_BTF
enable CONFIG_DEBUG_INFO_BTF_MODULES

# ── SquashFS (live-ISO boot: dmsquash-live squashfs root) ─────────
# The live ISO packs the rootfs as LiveOS/squashfs.img (zstd via mksquashfs,
# xz via the tar2sqfs fallback) — the kernel must mount both.
enable CONFIG_SQUASHFS
enable CONFIG_SQUASHFS_XZ
enable CONFIG_SQUASHFS_ZSTD
# ★ XATTR is LOAD-BEARING for the SELinux-enforcing live boot: the rootfs is packed
# WITH security.selinux labels (tar --xattrs-include='*.*' + mksquashfs preserves
# xattrs), but WITHOUT this the kernel prints "squashfs: Xattrs in filesystem, these
# will be ignored" and drops EVERY label → the entire live root is UNLABELED → under
# SELinux enforcing the first confined op is denied and the boot DEADLOCKS at OpenRC
# init-early (confirmed by QEMU: enforcing hangs at init-early, enforcing=0 reaches
# agetty). Honoring the xattrs lets the labeled live root boot enforcing cleanly.
enable CONFIG_SQUASHFS_XATTR

# ── Console framebuffer for headless VMs (no full DRM driver stack) ─
# Kept in the base so pki/be/fe images still get a working console on a VM/host
# without the AMD/Intel/Nouveau DRM drivers (those move to gpu.config).
enable CONFIG_DRM
enable CONFIG_DRM_VIRTIO_GPU
enable CONFIG_FB
enable CONFIG_FRAMEBUFFER_CONSOLE

# ── Storage / virt / KEYS USB ─────────────────────────────────────
enable CONFIG_DEVTMPFS
enable CONFIG_DEVTMPFS_MOUNT
enable CONFIG_BLK_DEV_NVME
enable CONFIG_SATA_AHCI
enable CONFIG_USB_STORAGE
enable CONFIG_USB_UAS
enable CONFIG_EXT4_FS
enable CONFIG_VFAT_FS
enable CONFIG_FAT_FS
enable CONFIG_EXFAT_FS
enable CONFIG_NLS_CODEPAGE_437
enable CONFIG_NLS_ISO8859_1
enable CONFIG_TUN
enable CONFIG_VIRTIO_PCI
enable CONFIG_VIRTIO_BLK
enable CONFIG_VIRTIO_NET
enable CONFIG_KVM
enable CONFIG_KVM_INTEL
enable CONFIG_KVM_AMD

# ── Encryption-at-rest: LUKS2 / dm-crypt + TPM2 auto-unlock ────────
# Device-mapper + dm-crypt back the LUKS2 data partition keys-provision creates
# (provision_storage). aes-xts-plain64 needs CRYPTO_XTS + AES; argon2id PBKDF +
# sha512 hashing run in userspace (cryptsetup) but the cipher runs in-kernel.
# TPM2 (TCG_TPM + TCG_TIS/CRB) + TRUSTED_KEYS let systemd-cryptenroll bind the
# LUKS key to the TPM so x86 nodes auto-unlock at boot (USB keyfile = recovery).
enable CONFIG_MD
enable CONFIG_BLK_DEV_DM
enable CONFIG_DM_CRYPT
enable CONFIG_CRYPTO_XTS
enable CONFIG_CRYPTO_AES
enable CONFIG_CRYPTO_AES_NI_INTEL
enable CONFIG_CRYPTO_SHA512
enable CONFIG_CRYPTO_USER_API_HASH
enable CONFIG_CRYPTO_USER_API_SKCIPHER
enable CONFIG_KEYS
enable CONFIG_TRUSTED_KEYS
enable CONFIG_TCG_TPM
enable CONFIG_TCG_TIS
enable CONFIG_TCG_CRB

# ── EFI Secure Boot / Unified Kernel Image ────────────────────────
# EFI stub embeds the kernel as a PE/EFI binary that UEFI can load directly;
# required for UKI (dracut --uefi) and for shim → kernel secure boot chain.
enable CONFIG_EFI_STUB
enable CONFIG_EFI_GENERIC_STUB
# Lockdown enforced by the kernel itself when booted under secure boot:
# if UEFI secure boot is on, the kernel auto-activates lockdown=integrity.
enable CONFIG_LOCK_DOWN_IN_EFI_SECURE_BOOT
