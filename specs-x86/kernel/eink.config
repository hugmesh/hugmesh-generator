# amd64 kernel fragment — E-INK / E-PAPER display support.
# Appended on top of desktop.config for client desktops. All built as MODULES so
# they cost nothing until a panel is attached. Symbol names verified against the
# current mainline kernel (7.0) — the older FB_AUO_K190x drivers were removed from
# mainline, and RePaper is CONFIG_TINYDRM_REPAPER (not DRM_REPAPER).
#   TINYDRM_REPAPER : Pervasive Displays RePaper (SPI e-ink panels)
#   DRM_PIXPAPER    : Mayqueen Pixpaper (SPI e-ink panel)
#   FB_METRONOME    : E-Ink Metronome/8track controller (legacy fbdev)
#   FB_BROADSHEET   : E-Ink Broadsheet / Epson S1D13521 controller (legacy fbdev)
# Most small e-paper panels are SPI-attached, so ensure the SPI bus is available.
enable CONFIG_SPI
enable CONFIG_SPI_MASTER
module CONFIG_TINYDRM_REPAPER
module CONFIG_DRM_PIXPAPER
module CONFIG_FB_METRONOME
module CONFIG_FB_BROADSHEET
