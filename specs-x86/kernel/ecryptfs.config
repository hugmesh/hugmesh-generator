# eCryptfs kernel fragment — appended ONLY when --home-encrypted is set.
# Provides the per-user encrypted home (~/.Private) that pam_ecryptfs mounts at
# login, layered on top of the LUKS2 full-disk root (the same double-layer posture
# the build host uses). Format matches the other fragments: "<verb> CONFIG_SYMBOL"
# replayed through scripts/config (see the kernel-build loop). The hardened guard
# loop will FAIL the build if olddefconfig prunes a load-bearing symbol, so keep
# the eCryptfs deps explicit here.
#
# Key-retention service: eCryptfs wraps its mount passphrase in the kernel keyring.
enable CONFIG_KEYS
# The filesystem itself (module — loaded on demand by mount.ecryptfs_private).
module CONFIG_ECRYPT_FS
# Ciphers/hashes eCryptfs uses by default (AES payload + ECB/CBC + MD5 for the
# filename-encryption key signature). Assert them so olddefconfig can't drop them.
enable CONFIG_CRYPTO_AES
enable CONFIG_CRYPTO_ECB
enable CONFIG_CRYPTO_CBC
enable CONFIG_CRYPTO_MD5
