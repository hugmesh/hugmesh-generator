# WireGuard kernel fragment — appended ONLY when --egress-vpn is a WireGuard conf.
# NetworkManager drives WireGuard natively against the in-kernel module (no userspace
# data path), so the kernel must provide CONFIG_WIREGUARD. Format matches the other
# fragments: "<verb> CONFIG_SYMBOL" replayed through scripts/config in the kernel-build
# loop. WIREGUARD `select`s its crypto deps, but assert the load-bearing ones so the
# hardened guard loop / olddefconfig cannot silently prune them.
module CONFIG_WIREGUARD
enable CONFIG_CRYPTO
# WIREGUARD `select`s its own crypto libs (CRYPTO_LIB_CURVE25519 / _CHACHA20POLY1305 /
# _BLAKE2S), so they cannot be pruned while WIREGUARD is set — no manual assert needed.
# (The older standalone CRYPTO_CURVE25519/CRYPTO_BLAKE2S symbols no longer exist.)
# NetworkManager's connectivity check + the tunnel itself ride normal UDP; nothing
# extra needed beyond the inet stack the hardened base already enables.
