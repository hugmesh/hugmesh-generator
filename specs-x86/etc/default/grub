# GRUB defaults for the installed x86_64 host image.
#
# Mirrors the SELinux + KSPP hardening kernel parameters that the RPi5 image
# bakes into specs-rpi5/boot/cmdline.txt, so both architectures boot with the same
# LSM, audit and slab/ASLR hardening. The installer's grub-mkconfig reads this.
# (root= and console= are derived by grub-mkconfig, so they're not set here.)
GRUB_TIMEOUT=5
GRUB_CMDLINE_LINUX="lsm=yama,selinux,bpf selinux=1 audit=1 cgroup_enable=cpuset cgroup_enable=memory cgroup_memory=1 slab_nomerge init_on_alloc=1 page_alloc.shuffle=1 randomize_kstack_offset=on"
