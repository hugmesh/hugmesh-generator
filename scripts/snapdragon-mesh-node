#!/usr/bin/env bash
# snapdragon-mesh-node — the spec's literal face for the wizard's fourth choice
# ("Local Docker mesh"): run a Snapdragon mesh node on THIS machine in Docker,
# building NO image. A THIN wrapper that execs the SAME Qt-free entrypoint the
# Studio wizard/tray and `make mesh-node-up` drive, so all channels share one
# LocalMeshConfig -> LocalMeshNode object graph (studio/…/core/local_mesh.py).
#
#   scripts/snapdragon-mesh-node up --authkey-file <file> [--node-name …] [--login-server …]
#   scripts/snapdragon-mesh-node {down,status,logs}
#
# NAME-COLLISION NOTE: `snapdragon-mesh-node` is ALSO the binary name the shipped
# END-USER joiner appliance installs to ~/.local/bin (clients/docker-mesh-node/
# install.sh) — a DIFFERENT product surface (a baked joiner image + KEYS profile).
# This generator-host build-time face is therefore invoked BY PATH ONLY
# (scripts/snapdragon-mesh-node) and is NEVER installed onto PATH, so the two never
# clobber each other. To permanently enroll a desktop, use the installed appliance.
set -eu

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"

# Default --generator-dir to this checkout unless the caller overrides it.
case " $* " in
    *" --generator-dir "*) gen=() ;;
    *)                     gen=(--generator-dir "${REPO_DIR}") ;;
esac

exec env PYTHONPATH="${REPO_DIR}/studio" python3 -m snapdragon_studio.core.local_mesh \
    "$@" "${gen[@]}"
