#!/usr/bin/env bash
# hugmesh-mesh-node — the spec's literal face for the wizard's fourth choice
# ("Local Docker mesh"): run a HugMesh mesh node on THIS machine in Docker,
# building NO image. A THIN wrapper that execs the SAME Qt-free entrypoint the
# Studio wizard/tray and `make mesh-node-up` drive, so all channels share one
# LocalMeshConfig -> LocalMeshNode object graph (studio/…/core/local_mesh.py).
#
#   scripts/hugmesh-mesh-node up --authkey-file <file> [--node-name …] [--login-server …]
#   scripts/hugmesh-mesh-node {down,status,logs}
#
# NAME-COLLISION NOTE: `hugmesh-mesh-node` is ALSO the binary name the shipped
# END-USER joiner appliance installs to ~/.local/bin (clients/docker-mesh-node/
# install.sh) — a DIFFERENT product surface (a baked joiner image + KEYS profile).
# This generator-host build-time face is therefore invoked BY PATH ONLY
# (scripts/hugmesh-mesh-node) and is NEVER installed onto PATH, so the two never
# clobber each other. To permanently enroll a desktop, use the installed appliance.
set -eu

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"

# First-run bootstrap (issue #49): idempotent (one `cat` once stamped), advisory
# by contract (always returns 0, prints only to stderr — safe under set -e).
# --redo-first-run is launcher-local: honour it, then STRIP it before forwarding
# (local_mesh's argparse does not know it).
# shellcheck source=scripts/_first-run-lib.sh
. "${SCRIPT_DIR}/_first-run-lib.sh"
first_run_bootstrap "${REPO_DIR}" "$(first_run_wants_redo "$@")"
fwd=()
for a in "$@"; do [ "${a}" = "--redo-first-run" ] || fwd+=("${a}"); done
set -- ${fwd[@]+"${fwd[@]}"}

# Default --generator-dir to this checkout unless the caller overrides it.
case " $* " in
    *" --generator-dir "*) gen=() ;;
    *)                     gen=(--generator-dir "${REPO_DIR}") ;;
esac

exec env PYTHONPATH="${REPO_DIR}/studio" python3 -m hugmesh_studio.core.local_mesh \
    "$@" "${gen[@]}"
