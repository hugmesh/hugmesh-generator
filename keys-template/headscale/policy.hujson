{
  // OPTIONAL headscale ACL policy override placed on the KEYS USB.
  //
  // If present, provisioning copies this to /etc/headscale/policy.hujson and
  // (when headscale config has `policy.mode: file`) loads it with
  // `headscale policy set -f /etc/headscale/policy.hujson`. This is the fleet
  // full-mesh policy: every member of tag:snapdragon reaches every other member
  // on all ports, plus the cluster pod/service CIDRs, and nothing else
  // (default-deny; no internet-wide grant).
  //
  // Membership: nodes self-apply tag:snapdragon at join
  // (--advertise-tags=tag:snapdragon,tag:<role>). With OIDC join (Casdoor
  // /headscale group) the IdP gates who can enrol; the tagOwners below gate
  // which tags an enrolled node may claim. Both layers must agree.
  //
  // hujson = JSON + comments + trailing commas. Also valid strict JSON here so
  // it lints with `jq` after stripping comments.

  "tagOwners": {
    // The owner MUST be a principal that owns the node's preauth/OIDC identity.
    // For preauth-key joins that is the headscale user the key was minted under
    // ("snapdragon"). For OIDC joins you may instead use a group, e.g.
    // "group:headscale" mapped from the Casdoor /headscale group.
    "tag:snapdragon": ["snapdragon"],
    "tag:pki": ["snapdragon"],
    "tag:be": ["snapdragon"],
    "tag:fe": ["snapdragon"],
    "tag:host": ["snapdragon"]
  },

  // Auto-approve exactly the cluster pod + service CIDRs advertised by fleet
  // nodes. Keep these in sync with kubernetes/kubeadm-config.yaml
  // (podSubnet/serviceSubnet) and provision.json .calico.pod_cidr.
  "autoApprovers": {
    "routes": {
      "10.244.0.0/16": ["tag:snapdragon"],
      "10.96.0.0/12": ["tag:snapdragon"]
    }
  },

  "acls": [
    {
      "action": "accept",
      "src": ["tag:snapdragon"],
      "dst": ["tag:snapdragon:*"]
    },
    {
      "action": "accept",
      "src": ["tag:snapdragon"],
      "dst": ["10.244.0.0/16:*", "10.96.0.0/12:*"]
    }
  ]
}
