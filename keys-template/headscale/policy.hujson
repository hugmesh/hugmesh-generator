{
  // OPTIONAL headscale ACL policy override placed on the KEYS USB.
  //
  // If present, provisioning copies this to /etc/headscale/policy.hujson and
  // (when headscale config has `policy.mode: file`) loads it with
  // `headscale policy set -f /etc/headscale/policy.hujson`. Members of
  // tag:hugmesh reach the cluster pod/service CIDRs on all ports, tag:superadmin
  // reaches :22 for Tailscale SSH, and nothing else is open (default-deny; no
  // node-to-node rule, no internet-wide grant).
  //
  // Membership: nodes self-apply tag:hugmesh at join
  // (--advertise-tags=tag:hugmesh,tag:<role>). With OIDC join (Casdoor
  // /headscale group) the IdP gates who can enrol; the tagOwners below gate
  // which tags an enrolled node may claim. Both layers must agree.
  //
  // hujson = JSON + comments + trailing commas. Also valid strict JSON here so
  // it lints with `jq` after stripping comments.

  "tagOwners": {
    // The owner MUST be a principal that owns the node's preauth/OIDC identity.
    // For preauth-key joins that is the headscale user the key was minted under
    // ("hugmesh"). For OIDC joins you may instead use a group, e.g.
    // "group:headscale" mapped from the Casdoor /headscale group.
    //
    // Only MEMBERSHIP/role tags belong to that principal. If you add a tag that
    // grants access (tag:superadmin, tag:mesh_*, tag:dev_*, tag:dom_*), give it
    // an EMPTY owner list ("tag:superadmin": []) and let the control node force
    // it: headscale 0.23 grants a node every advertised tag its user owns on
    // top of its forced tags, so an owned access tag is one any key holder can
    // claim. keys-provision refuses to load an override that does this.
    "tag:hugmesh": ["hugmesh"],
    "tag:pki": ["hugmesh"],
    "tag:be": ["hugmesh"],
    "tag:fe": ["hugmesh"],
    "tag:host": ["hugmesh"],
    // The only SSH source (see the ssh block), owned by nobody: the control node
    // force-assigns it (hugmesh-headscale-forcetags). headscale 0.23 builds no
    // node's map while a rule names a tag that is neither listed here nor forced.
    "tag:superadmin": []
  },

  // Auto-approve exactly the cluster pod + service CIDRs advertised by fleet
  // nodes. Keep these in sync with kubernetes/kubeadm-config.yaml
  // (podSubnet/serviceSubnet) and provision.json .calico.pod_cidr.
  "autoApprovers": {
    "routes": {
      "10.244.0.0/16": ["tag:hugmesh"],
      "10.96.0.0/12": ["tag:hugmesh"]
    }
  },

  // Layer-A (device-license registry): the any-to-any
  //   {src:[tag:hugmesh], dst:[tag:hugmesh:*]}
  // rule is DROPPED [FIX-DROPMESHRULE]. It exposed EVERY node's :22 to every
  // other node; that hole need not exist at any time. k8s pod/ClusterIP traffic
  // rides the CIDR data-plane rule below (NOT :22); SSH rides the ssh[] block.
  // This override file is now a bootstrap-equivalent; the control node's first
  // verified Layer-A sync re-renders /etc/headscale/policy.hujson with the
  // generated default-deny per-edge ssh block + the SUPERADMIN mesh rule.
  "acls": [
    {
      "action": "accept",
      "src": ["tag:hugmesh"],
      "dst": ["10.244.0.0/16:*", "10.96.0.0/12:*"]
    },
    // The ONLY way to :22, and only from tag:superadmin: a Tailscale SSH session
    // is a TCP connection to :22, so without this the ssh rule below can never be
    // used. Never widen its src: see the ssh block.
    {
      "action": "accept",
      "src": ["tag:superadmin"],
      "dst": ["tag:hugmesh:22"]
    }
  ],

  // Tailscale SSH — privileged-user-only. ONLY the image's privileged user
  // (@@TS_SSH_USER@@, rewritten by keys-provision from provision.json
  // .tailscale.ssh_user) may open a Tailscale-SSH session; root + other accounts
  // are denied. Pair with `tailscale up --ssh` (provision.json tailscale.up_args
  // / the keys-provision default). SSH is tailnet-only.
  //
  // WHO may open that session: tag:superadmin, nothing else. Tailscale SSH
  // answers :22 itself, so the device's sshd key checks are not on this path;
  // whoever src names gets a session as the privileged user. Do NOT put
  // tag:hugmesh, a role tag, autogroup:member, "*" or a user/group here: every
  // node holding a pre-auth key has those. keys-provision refuses to load a
  // policy whose ssh rules name any source but tag:superadmin.
  "ssh": [
    {
      "action": "accept",
      "src": ["tag:superadmin"],
      "dst": ["tag:hugmesh"],
      "users": ["@@TS_SSH_USER@@"]
    }
  ]
}
