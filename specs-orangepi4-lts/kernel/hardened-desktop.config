# Kernel config fragment — Orange Pi 4 LTS (Rockchip RK3399) light desktop.
# EXPERIMENTAL PLATFORM — see specs-orangepi4-lts/README.md: this board has
# NEVER been booted with an image from this repo. Every RK3399-specific symbol
# below was checked to EXIST by direct fetch of the relevant upstream Kconfig
# file (the driver choices are researched, the symbol SPELLINGS are verified),
# NOT hardware-verified; treat every "verify" note as a real gap a reviewer
# must close before trusting this on real hardware.
#
# NOTE FOR REVIEWERS: this fragment was forked from the RK3588 (Orange Pi 5)
# one, and RK3588's driver set is WRONG for RK3399 in almost every subsystem
# that matters for booting — GPU, eMMC/SD, ethernet and PCIe all use different
# mainline drivers on this SoC. Do not "restore" an RK3588 symbol here.
#
# Applied on top of the chosen base defconfig by build-orangepi4-lts-stage4.sh using
# scripts/kconfig/merge_config.sh (the Frite/Jetson convention — real Kconfig
# dependency-aware merging — NOT the x86/RPi5 `scripts/config --action` replay
# DSL). Three jobs:
#   1) Keep the SAME hardening posture as the rest of the fleet (SELinux LSM,
#      lockdown-friendly, audit) — the SELinux guard in the builder enforces it.
#   2) Enable the RK3399 platform + eMMC/SD + GPU/DRM + networking + USB so the
#      board actually boots, displays, and takes input.
#   3) LUKS2/dm-crypt (--encrypt-root) + the lean-desktop input/HID/sound bits.
#
# Format: standard .config fragment (CONFIG_FOO=y / # CONFIG_FOO is not set /
# CONFIG_FOO="string") — consumed by merge_config.sh, NOT by scripts/config.

# ── Rockchip RK3399 platform ───────────────────────────────────────
# CONFIG_ARCH_ROCKCHIP is the arm64 platform-select symbol (arch/arm64/Kconfig.platforms);
# it covers the whole Rockchip SoC family (RK3399/RK3568/RK3588/...), not just this chip.
CONFIG_ARCH_ROCKCHIP=y
CONFIG_ROCKCHIP_SARADC=y

# ── PCIe (RK3399 has a PCIe 2.1 x4 controller) ─────────────────────
# CHANGED FROM THE RK3588 FORK — different controller IP, different driver:
# RK3399 uses the NON-DesignWare Rockchip PCIe host controller,
# CONFIG_PCIE_ROCKCHIP_HOST (drivers/pci/controller/Kconfig, selects
# PCIE_ROCKCHIP). The RK3588's CONFIG_PCIE_ROCKCHIP_DW_HOST lives in the
# separate dwc/ directory and does NOT drive this SoC.
# The Orange Pi 4 LTS exposes NO M.2/NVMe slot, so this is enabled only for
# completeness of the SoC platform, not for any onboard device.
CONFIG_PCI=y
CONFIG_PCIEPORTBUS=y
CONFIG_PCIE_ROCKCHIP_HOST=y
CONFIG_PCIEASPM=y

# ── eMMC / microSD / SDIO ──────────────────────────────────────────
# CHANGED FROM THE RK3588 FORK — RK3399 uses TWO different mainline host
# drivers, and CONFIG_MMC_SDHCI_OF_DWCMSHC (the RK3568/RK3588 controller) is
# NOT either of them. Getting this wrong means no eMMC and no SD card, i.e.
# the board cannot boot or be installed to at all:
#   * eMMC  -> Arasan SDHCI  (CONFIG_MMC_SDHCI_OF_ARASAN)
#   * SD/SDIO -> Rockchip DesignWare MMC (CONFIG_MMC_DW + CONFIG_MMC_DW_ROCKCHIP)
# The SDIO half is also what the onboard brcmfmac WiFi hangs off (&sdio0 in the
# device tree), so MMC_DW_ROCKCHIP is a prerequisite for --enable-wifi too.
CONFIG_MMC=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_OF_ARASAN=y
CONFIG_MMC_DW=y
CONFIG_MMC_DW_ROCKCHIP=y

# ── USB (USB3 DWC3 controllers + xHCI; USB-A ports + a USB-C port) ────────────
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PLATFORM=y
CONFIG_USB_DWC3=y
CONFIG_USB_STORAGE=y
CONFIG_USB_HID=y
CONFIG_HID_GENERIC=y

# ── Networking ──────────────────────────────────────────────────────
# CHANGED FROM THE RK3588 FORK — and this one is easy to get wrong. The Orange
# Pi 5 Plus's 2.5GbE is a PCIe-attached Realtek RTL8125 (r8169). The Orange Pi
# 4 LTS's gigabit ethernet is NOT a PCIe NIC at all: it is the RK3399's
# INTEGRATED GMAC, described in the device tree this image boots as
# &gmac { compatible = "rockchip,rk3399-gmac"; phy-mode = "rgmii"; status =
# "okay"; } (confirmed by direct fetch of rk3399-base.dtsi + rk3399-orangepi.dts).
# That is a Synopsys DesignWare MAC, driven by stmmac + the Rockchip glue
# layer. CONFIG_R8169 would leave this board with NO ethernet whatsoever.
CONFIG_STMMAC_ETH=y
CONFIG_STMMAC_PLATFORM=y
CONFIG_DWMAC_ROCKCHIP=y

# ── WiFi / Bluetooth (modules only — OFF by default, hardened posture) ───────
# UNLIKE the Orange Pi 5 (whose M.2 AP6275P this repo researched as having
# INCOMPLETE mainline support), the radio here is described AND enabled in the
# very device tree this image boots: rk3399-orangepi.dts has an enabled &sdio0
# with a `brcm,bcm4329-fmac` wifi@1 child and an enabled &uart0 with a
# `brcm,bcm43438-bt` bluetooth child (both confirmed by direct fetch).
# So the OFF default here is PURELY the fleet hardened posture, not a
# workaround. Built as MODULES so `--enable-wifi` has something to load.
# UNVERIFIED: brcmfmac needs a matching per-board firmware+NVRAM blob from
# linux-firmware at runtime; not checked on hardware.
CONFIG_BRCMFMAC=m
CONFIG_BRCMFMAC_SDIO=y
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_BT=m
CONFIG_BT_HCIUART=m

# ── GPU / Display ───────────────────────────────────────────────────
# CHANGED FROM THE RK3588 FORK, and this is the single most important
# correction in this file. The RK3399's GPU is a Mali-T860 (MIDGARD), declared
# in rk3399-base.dtsi as compatible = "rockchip,rk3399-mali", "arm,mali-t860"
# and enabled by rk3399-orangepi.dts (both confirmed by direct fetch).
# Midgard is driven by PANFROST. The RK3588's Mali-G610 is Valhall/CSF and is
# driven by the SEPARATE, newer PANTHOR driver. CONFIG_DRM_PANTHOR does not
# bind to a T860 at all, so inheriting it would have left this "desktop"
# platform with no GPU.
# The Mesa/Gentoo USERSPACE Gallium driver is called "panfrost" for BOTH
# kernel drivers, so VIDEO_CARDS="panfrost" in make.conf.tmpl is correct here
# for the ordinary reason rather than the confusing one.
CONFIG_DRM=y
CONFIG_DRM_PANFROST=y
# Display pipeline: RK3399 uses VOP (v1), NOT the VOP2 block — upstream
# Kconfig states plainly that "The VOP2 hardware is first found on the RK3568".
# rk3399-base.dtsi has &vopb "rockchip,rk3399-vop-big" + &vopl
# "rockchip,rk3399-vop-lit", both enabled by the board DTS.
# HDMI is the PLAIN Synopsys dw-hdmi ("rockchip,rk3399-dw-hdmi"), NOT the
# "HDMI QP" variant that RK3588 needs — so ROCKCHIP_DW_HDMI, not the QP symbol.
# Consequence worth noting: none of the RK3588 ">= 6.13 or HDMI is dead"
# version sensitivity applies to this board; the RK3399 display stack has been
# in mainline for years.
CONFIG_DRM_ROCKCHIP=y
CONFIG_ROCKCHIP_VOP=y
CONFIG_ROCKCHIP_DW_HDMI=y
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_DRM_FBDEV_EMULATION=y

# ── Input ────────────────────────────────────────────────────────────
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_INPUT_MOUSE=y

# ── Audio (HDMI audio + generic ALSA/USB; ALSA only, no pulseaudio/pipewire) ──
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_SOC_ROCKCHIP=y
CONFIG_SND_USB_AUDIO=y

# ── Hardware crypto engine: DELIBERATELY NOT ENABLED ────────────────────────
# The RK3588 fork enabled CONFIG_CRYPTO_DEV_ROCKCHIP2 on the rationale that the
# V2 engine registers xts(aes) — "exactly LUKS's cipher" — so it would
# accelerate FDE. That rationale DOES NOT CARRY OVER and the symbol is wrong
# twice over:
#   1) CRYPTO_DEV_ROCKCHIP2 covers RK3566/RK3568/RK3588, not RK3399.
#   2) The v1 driver that would apply, CONFIG_CRYPTO_DEV_ROCKCHIP, advertises
#      (upstream Kconfig help, fetched) only "cbc/ecb chainmode, and
#      aes/des/des3_ede cipher mode" — NO xts. It therefore would NOT
#      accelerate LUKS2 at all.
# So there is nothing to gain here, and enabling a crypto driver that cannot
# serve the one workload we care about is pure attack surface. LUKS/FDE relies
# solely on CRYPTO_AES_ARM64_CE_BLK below.

# ── LUKS2 root (dm-crypt) — --encrypt-root builds ──────────────────
# Same CONFIG_MD/BLK_DEV_DM/DM_CRYPT/CRYPTO_XTS/CRYPTO_AES pattern every other
# platform in this repo uses (x86/frite/rpi5/jetson). CONFIG_MD gates the whole
# drivers/md/Kconfig subtree that BLK_DEV_DM/DM_CRYPT depend on (directly or
# transitively) — without it, `make olddefconfig` silently drops them regardless
# of what's requested here. CRYPTO_AES_ARM64_CE_BLK is the ARMv8 Crypto
# Extensions accelerator. HONEST CAVEAT, weaker than the RK3588 fork's claim:
# ARMv8 CE is an OPTIONAL extension, and the Cortex-A53 half of this SoC is the
# same core family where Frite's config already notes CE is implementation-
# defined. It is widely present on RK3399 but is NOT architecturally
# guaranteed here the way it was claimed for A76/A55; the kernel falls back to
# the generic AES implementation if absent, so this is a performance question,
# not a correctness one. Mirrors specs-frite/kernel/hardened-desktop.config.
CONFIG_MD=y
CONFIG_DM_CRYPT=y
CONFIG_CRYPTO_XTS=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_AES_ARM64_CE_BLK=y
CONFIG_CRYPTO_SHA512=y
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y
# Disable hibernation — resume-from-disk bypasses LUKS2 disk encryption.
# Mirrors every other hardened-*.config in this repo.
# CONFIG_HIBERNATION is not set

# ── Hardening posture (MUST match the fleet; guarded by the builder) ─
# SECURITY_NETWORK must come before SECURITY_SELINUX — selinux depends on it.
CONFIG_SECURITY=y
CONFIG_SECURITY_NETWORK=y
CONFIG_SECURITY_SELINUX=y
CONFIG_SECURITY_SELINUX_BOOTPARAM=y
CONFIG_SECURITY_YAMA=y
CONFIG_AUDIT=y
CONFIG_AUDITSYSCALL=y
CONFIG_BPF_SYSCALL=y
# `bpf` is deliberately NOT in this list. The kernel silently DROPS an LSM name
# whose module is absent — it prints a SHORTER "LSM: initializing lsm=..." and
# boots on — and CONFIG_BPF_LSM has never been set in ANY board fragment in this
# repo, nor are its Kconfig deps (BPF_JIT, BPF_EVENTS) enabled here. So the name
# only ever advertised a posture the running kernel did not have. yama IS real on
# this board (CONFIG_SECURITY_YAMA=y above). Re-add `bpf` only together with
# CONFIG_BPF_LSM + its deps AND a verified board build; the builder guard now
# derives the required CONFIG_* set from this very string and will fail without it.
CONFIG_LSM="yama,selinux"
# ASLR / stack / slab hardening
CONFIG_RANDOMIZE_BASE=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_SLAB_FREELIST_HARDENED=y
CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_FORTIFY_SOURCE=y

# ── tun + iptables (tailscale needs /dev/net/tun + nf) ─────────────
CONFIG_TUN=y
CONFIG_NETFILTER=y
CONFIG_NF_CONNTRACK=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_NETFILTER_XTABLES=y

# ── Squashfs + overlay + loop (the LIVE flavor boots a squashfs) ──
# Same dmsquash-live boot design as Frite/RPi5: the LIVE/INSTALLER medium boots
# a dracut dmsquash-live initramfs that mounts LiveOS/squashfs.img read-only
# (loop + squashfs) and stacks a writable overlay = the ephemeral root.
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_OVERLAY_FS=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_ISO9660_FS=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_SNAPSHOT=y
CONFIG_BLK_DEV_RAM=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_BLK_DEV_INITRD=y
