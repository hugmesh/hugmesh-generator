# extlinux.conf — U-Boot distro-boot config for the Orange Pi 4 LTS
# (Rockchip RK3399). U-Boot's distro-boot scans the first partition of
# whatever block device it finds (microSD/eMMC/USB) for /extlinux/extlinux.conf
# and boots the entry below — the SAME mechanism build-frite-stage4.sh uses (NOT
# the RPi5 config.txt/cmdline.txt model, and NOT UEFI/GRUB — see the builder's
# header for the full boot-chain research/rationale).
#
# Variables substituted at build time (render_template in build-orangepi4-lts-stage4.sh):
#   @@OPI4LTS_KERNEL_IMG@@   Kernel image filename in /boot (e.g. Image)
#   @@OPI4LTS_DTB@@          Board DTB path under /dtb (e.g.
#                         rockchip/rk3399-orangepi.dtb)
#   @@OPI4LTS_INITRD_LINE@@  INITRD line (live/installer/encrypted-disk boot) or a
#                         comment (plaintext installed system)
#   @@BRAND_TITLE@@       Menu label brand
#
# IMPORTANT: boot the DTB that ships WITH THE KERNEL (copied to /boot/dtb by the
# builder), NOT any DTB baked into U-Boot itself — mainline RK3399 device-tree
# support is still evolving fast (see specs-orangepi4-lts/README.md); a stale
# in-u-boot DTB is a common source of "boots to nothing" on these boards.

DEFAULT orangepi4-lts
TIMEOUT 20
MENU TITLE @@BRAND_TITLE@@ — Orange Pi 4 LTS

LABEL orangepi4-lts
    MENU LABEL @@BRAND_TITLE@@ light desktop
    LINUX /@@OPI4LTS_KERNEL_IMG@@
    FDT /dtb/@@OPI4LTS_DTB@@
@@OPI4LTS_INITRD_LINE@@
    APPEND @@OPI4LTS_APPEND@@
