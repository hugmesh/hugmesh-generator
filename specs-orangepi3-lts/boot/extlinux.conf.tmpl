# extlinux.conf — U-Boot distro-boot config for the Orange Pi 3 LTS (Allwinner
# H6). U-Boot's distro-boot scans the first partition of whatever block
# device it finds (microSD/eMMC/USB) for /extlinux/extlinux.conf and boots the entry
# below — the SAME mechanism build-frite-stage4.sh / build-orangepi5-stage4.sh
# use (NOT the RPi5 config.txt/cmdline.txt model, and NOT UEFI/GRUB).
#
# Variables substituted at build time (render_template in
# build-orangepi3-lts-stage4.sh):
#   @@OPI3LTS_KERNEL_IMG@@   Kernel image filename in /boot (e.g. Image)
#   @@OPI3LTS_DTB@@          Board DTB path under /dtb (e.g.
#                          allwinner/sun50i-h6-orangepi-3.dtb)
#   @@OPI3LTS_INITRD_LINE@@  INITRD line (live/installer/encrypted-disk boot) or a
#                          comment (plaintext installed system)
#   @@BRAND_TITLE@@        Menu label brand
#
# IMPORTANT: boot the DTB that ships WITH THE KERNEL (copied to /boot/dtb by the
# builder), NOT any DTB baked into U-Boot itself.

DEFAULT orangepi3-lts
TIMEOUT 20
MENU TITLE @@BRAND_TITLE@@ — Orange Pi 3 LTS (headless appliance)

LABEL orangepi3-lts
    MENU LABEL @@BRAND_TITLE@@ headless appliance
    LINUX /@@OPI3LTS_KERNEL_IMG@@
    FDT /dtb/@@OPI3LTS_DTB@@
@@OPI3LTS_INITRD_LINE@@
    APPEND @@OPI3LTS_APPEND@@
