#!/bin/bash
# First-boot finaliser — runs once, then self-destructs.
#
# Ordering: the keys-provision service runs earlier in the boot (it is
# declared "before local"), so by the time this fires the USB KEYS
# partition has already been processed. This script only fills in the
# gaps:
#
#   * locale generation
#   * Kubernetes kernel modules + sysctl
#   * CNI plugin staging
#   * a FALLBACK default user — created ONLY when keys-provision did not
#     create any users (e.g. you booted without a KEYS stick). It can log in
#     but is NOT an administrator unless the image was built with
#     --local-admin; root stays locked, and there is no other admin path.
#
# SUPPLY-CHAIN / OWASP: this finaliser NO LONGER bakes a known default password
# into the image. Earlier, the builders substituted the brand.conf DEFAULT_USER_PASS /
# ROOT_PASS values (e.g. "raspberry"/"gentoo"/"hugmesh") into the line below, so
# every image of a given flavour shipped with the SAME well-known credentials —
# a classic "default creds baked into image" finding. The real credentials come
# from the KEYS USB (users.json $6$-hashes via keys-provision; see
# scripts/gen-provision-keys.sh + specs/etc/keys-provision/provision.sh). The
# fallback below exists ONLY for a keyless boot and now mints a RANDOM one-time
# password at first boot (never a known default), locks root, and forces a
# password change on first login. Nothing secret is in the image or in git.
#
# Variables substituted at build time:
#   @@HOSTNAME@@           Target hostname
#   @@DEFAULT_USER@@       Fallback non-root user (NAME ONLY — no baked password)
#   @@STANDALONE@@         "true" for a self-contained STANDALONE desktop image
#   @@LOCAL_PASSHASH@@     crypt(3) hash of the --local-pass password, on ANY
#                          image (yescrypt $y$ where the build host supports
#                          it, SHA-512 crypt $6$ fallback — scripts/_passhash-lib.sh;
#                          the plaintext is NEVER baked). Non-empty => the local
#                          account logs in with it. Empty on a STANDALONE image =>
#                          random one-time password; empty elsewhere => no local
#                          account beyond the keyless fallback.
#   @@LOCAL_ADMIN@@        "true" (--local-admin) => the local account is an
#                          administrator (may sudo). Anything else => it is NOT,
#                          on every image: standalone, keyless, KEYS-provisioned.

locale-gen
eselect locale set en_US.utf8
env-update && source /etc/profile

# ── The LOCAL login account: the password typed in the Studio/TUI (--local-pass) ──
# Every desktop image offers a LOCAL account login — standalone, tailnet-only and
# mesh-associated alike (operator requirement 2026-11-04). The builder hashes the
# --local-pass password into @@LOCAL_PASSHASH@@ and this block puts that hash on
# the local account @@DEFAULT_USER@@ whenever it is non-empty, on EVERY image. It
# used to run only on STANDALONE images, so a cloud/mesh desktop built with a Login
# Password dropped the hash and took the keyless random-password fallback instead.
#
# ADMIN IS OPT-IN (operator rule: the local login account is not an administrator
# unless the build asked for one). Only --local-admin (@@LOCAL_ADMIN@@=true) makes
# it one, on every shape below. It used to get `wheel` on every keyless and
# standalone boot regardless (2026-11-09 prover: a cloud laptop booted without a
# KEYS stick gave the local account wheel; the same image WITH a stick did not).
# Without --local-admin, root stays locked and nobody on a keyless/standalone box
# can sudo; first boot says so on the console (docs/STANDALONE-DESKTOP.md).
#
# Three shapes, decided here at first boot:
#   * STANDALONE image (no KEYS stick, no SSO, no mesh): the account is the only
#     login. --local-admin => in `wheel` (the sudo path on an ungoverned image: no
#     SSO desktop-sudo governance here). No password given => a RANDOM one-time
#     password, shown on the console.
#   * any other image, and KEYS provisioning created NO users (keyless boot): the
#     account replaces the keyless fallback below, and root is locked.
#     --local-admin => in `wheel`, as on a standalone image.
#   * any other image, and KEYS provisioning DID create users: the local account is
#     ADDITIONAL. The KEYS users are untouched. It is NOT in wheel; --local-admin
#     is granted through /etc/sudoers.d/<user> — never the shared `%wheel` line,
#     which keys-provision comments out on a governed image (re-adding it would
#     hand standing root to every KEYS wheel member). If KEYS already created an
#     account with this NAME, the KEYS account and its password win: nothing is
#     changed and the console says so.
#
# EVERY STEP IS CHECKED, and the 2026-10-30 standalone-thick x86 image is why. This
# block used to run `useradd -G wheel,audio,video,usb,plugdev,games` unchecked. That
# image has no `games` group (no acct-group/games exists in ::gentoo), so useradd
# exited 6 and created NOBODY; `chpasswd -e` then had no user to put the Studio's
# hash on, the "ready" line printed anyway, and `touch users.created` failed because
# /var/lib/keys-provision did not exist either. The keyless fallback below then
# created the user with a RANDOM password whose banner OpenRC's `local` service sent
# to /dev/null, and the script deleted itself. The password typed in the Studio
# could never log in. Now: missing supplementary groups are created first (the same
# move keys-provision makes, provision.sh), success is marked only when the account
# exists AND its password landed, and on failure the script says so on the console
# and stays in place so the next boot retries — never falling back to a random
# password over the one typed at build time.
#
# The hash is tested in SINGLE quotes: inside double quotes its `$y$`/`$6$` salt
# segments are parameter expansions, and a hash whose tail happened to be all word
# characters would expand to "" and silently take the random-password branch.
SA_RETRY=false
LL_RUN=false
LL_KEYS=false
if [ "@@STANDALONE@@" = "true" ]; then
    [ ! -f /var/lib/keys-provision/users.created ] && LL_RUN=true
elif [ -n '@@LOCAL_PASSHASH@@' ]; then
    LL_RUN=true
    [ -f /var/lib/keys-provision/users.created ] && LL_KEYS=true
fi
if ${LL_RUN}; then
    SA_OK=false
    LL_SKIP=false
    # Admin only when the build asked (--local-admin). A KEYS image gets its admin
    # grant through sudoers.d below, never through wheel.
    LL_WHEEL=false
    [ "@@LOCAL_ADMIN@@" = "true" ] && ! ${LL_KEYS} && LL_WHEEL=true
    LL_WANT="audio video usb plugdev games"
    ${LL_WHEEL} && LL_WANT="wheel ${LL_WANT}"
    SA_GROUPS=""
    for g in ${LL_WANT}; do
        getent group "${g}" >/dev/null 2>&1 || groupadd -r "${g}" >/dev/null 2>&1 || true
        getent group "${g}" >/dev/null 2>&1 && SA_GROUPS="${SA_GROUPS:+${SA_GROUPS},}${g}"
    done
    mkdir -p /var/lib/keys-provision
    if id "@@DEFAULT_USER@@" &>/dev/null; then
        # Already there. Ours from an earlier, failed attempt (marker) -> retry the
        # password. Made by KEYS provisioning -> leave that account alone.
        if ${LL_KEYS} && [ ! -f /var/lib/keys-provision/local-user.created ]; then
            LL_SKIP=true
        fi
    elif [ -n "${SA_GROUPS}" ]; then
        useradd -m -G "${SA_GROUPS}" -s /bin/bash "@@DEFAULT_USER@@" \
            && touch /var/lib/keys-provision/local-user.created
    else
        useradd -m -s /bin/bash "@@DEFAULT_USER@@" \
            && touch /var/lib/keys-provision/local-user.created
    fi
    if ${LL_SKIP}; then
        SA_OK=true
        {
            echo "Local login: KEYS provisioning already created @@DEFAULT_USER@@ — its KEYS password is kept;"
            echo "  the build-time Login Password was NOT applied to it."
        } | tee /dev/console 2>/dev/null || true
    elif id "@@DEFAULT_USER@@" &>/dev/null; then
        if ! ${LL_KEYS}; then
            # The `%wheel` line is how `wheel` means "may sudo" on an ungoverned
            # (keyless/standalone) image — for this account when --local-admin put it
            # there, and for an SSO user the greeter gives wheel for the IdP admin
            # role (docs/DESKTOP-LOGIN-SSO.md). Being IN wheel is the opt-in part.
            grep -q '^%wheel ALL=(ALL) ALL' /etc/sudoers || echo "%wheel ALL=(ALL) ALL" >> /etc/sudoers
        fi
        if [ "@@LOCAL_ADMIN@@" = "true" ] && ${LL_KEYS}; then
            mkdir -p /etc/sudoers.d
            echo "@@DEFAULT_USER@@ ALL=(ALL) ALL" > /etc/sudoers.d/90-local-@@DEFAULT_USER@@
            chmod 0440 /etc/sudoers.d/90-local-@@DEFAULT_USER@@
        fi
        if [ -n '@@LOCAL_PASSHASH@@' ]; then
            # Apply the build-time crypt(3) hash (NOT plaintext) to /etc/shadow.
            # chpasswd -e takes the hash verbatim ($y$ and $6$ both land as-is).
            if echo '@@DEFAULT_USER@@:@@LOCAL_PASSHASH@@' | chpasswd -e; then
                SA_OK=true
                {
                    echo "Local login: user @@DEFAULT_USER@@ ready (password set at build time)."
                } | tee /dev/console 2>/dev/null || true
            fi
        else
            if command -v openssl >/dev/null 2>&1; then FB_PW="$(openssl rand -base64 18)"; else FB_PW="$(head -c 18 /dev/urandom | base64 | tr -dc 'A-Za-z0-9' | head -c 24)"; fi
            if echo "@@DEFAULT_USER@@:${FB_PW}" | chpasswd; then
                SA_OK=true
                chage -d 0 "@@DEFAULT_USER@@" 2>/dev/null || true
                # OpenRC's `local` service discards this script's stdout unless
                # rc_verbose=yes, so the one-time password goes to the console too.
                {
                    echo ""; echo "############################################################"
                    echo "#  STANDALONE desktop — no --local-pass was set at build."
                    echo "#    user: @@DEFAULT_USER@@   pass: ${FB_PW}   (CHANGE IT)"
                    echo "############################################################"; echo ""
                } | tee /dev/console 2>/dev/null || true
            fi
            unset FB_PW
        fi
    fi
    if ${SA_OK}; then
        if ! ${LL_KEYS}; then
            # The local account is the only login: lock root, and tell the keyless
            # fallback below not to mint a second, random-password account.
            passwd -l root
            touch /var/lib/keys-provision/users.created
            if ! ${LL_WHEEL}; then
                # Never silently unadministrable: say so where the operator looks.
                # -a: after a one-time password banner, never in place of it.
                {
                    echo "Local login: @@DEFAULT_USER@@ is NOT an administrator (image built without --local-admin)."
                    echo "  root is locked, so no local account on this device can use sudo."
                } | tee -a /dev/console 2>/dev/null || true
            fi
        fi
    else
        SA_RETRY=true
        {
            echo "Local login: FAILED to set up local user @@DEFAULT_USER@@ (groups: ${SA_GROUPS:-none})."
            echo "  First boot will retry on the next boot."
        } | tee /dev/console 2>/dev/null || true
    fi
    unset LL_SKIP LL_WHEEL LL_WANT
fi

# ── Fallback user (only when KEYS provisioning created none) ───────
# Not after a FAILED local-account setup: that would replace the password typed at
# build time with a random one (exactly what the 2026-10-30 image did).
if ${SA_RETRY}; then
    echo "Local user setup failed — fallback user NOT created; retrying next boot"
elif [ ! -f /var/lib/keys-provision/users.created ]; then
    echo "No users provisioned from KEYS — creating fallback @@DEFAULT_USER@@ with a RANDOM one-time password"
    if ! id "@@DEFAULT_USER@@" &>/dev/null; then
        # Admin only when the build asked (--local-admin), like the local account above.
        FB_ADMIN=false
        [ "@@LOCAL_ADMIN@@" = "true" ] && FB_ADMIN=true
        FB_GROUPS="audio,video,usb"
        ${FB_ADMIN} && FB_GROUPS="wheel,${FB_GROUPS}"
        useradd -m -G "${FB_GROUPS}" -s /bin/bash "@@DEFAULT_USER@@"
        # Mint a random one-time password at FIRST BOOT — never a baked default.
        # Prefer openssl; fall back to /dev/urandom so this works on a minimal
        # image. The plaintext is printed ONCE to the boot console below and is
        # NOT stored anywhere (only the crypt hash lands in /etc/shadow).
        if command -v openssl >/dev/null 2>&1; then
            FB_PW="$(openssl rand -base64 18)"
        else
            FB_PW="$(head -c 18 /dev/urandom | base64 | tr -dc 'A-Za-z0-9' | head -c 24)"
        fi
        echo "@@DEFAULT_USER@@:${FB_PW}" | chpasswd
        # Root login stays LOCKED on a keyless boot (matches the hardened
        # keys-provision default: root is `passwd -l`'d unless a hash is supplied).
        passwd -l root
        # Force the fallback user to change the random password at first login.
        chage -d 0 "@@DEFAULT_USER@@" 2>/dev/null || passwd -e "@@DEFAULT_USER@@" 2>/dev/null || true
        # Same `%wheel` line as above (idempotent); membership is the opt-in part.
        grep -q '^%wheel ALL=(ALL) ALL' /etc/sudoers || echo "%wheel ALL=(ALL) ALL" >> /etc/sudoers
        echo ""
        {
            echo "###############################################################"
            echo "#  KEYLESS BOOT — random one-time login (CHANGE IT IMMEDIATELY) "
            echo "#    user: @@DEFAULT_USER@@"
            echo "#    pass: ${FB_PW}"
            echo "#  root is LOCKED. This password is shown ONCE and not stored.  "
            if ! ${FB_ADMIN}; then
                echo "#  @@DEFAULT_USER@@ is NOT an administrator (built without --local-admin):"
                echo "#  no local account on this device can use sudo.               "
            fi
            echo "###############################################################"
            echo ""
        } | tee /dev/console 2>/dev/null || true
        unset FB_PW FB_ADMIN FB_GROUPS
    fi
else
    echo "Users were provisioned from KEYS — skipping fallback user"
fi

# ── Kubernetes kernel modules + sysctl ─────────────────────────────
for mod in overlay br_netfilter ip_vs ip_vs_rr ip_vs_wrr ip_vs_sh nf_conntrack vxlan; do
    modprobe "${mod}" 2>/dev/null || true
done
sysctl --system

if [ -d /usr/libexec/cni ] && [ -z "$(ls -A /opt/cni/bin 2>/dev/null)" ]; then
    cp /usr/libexec/cni/* /opt/cni/bin/
fi

# ── nullmailer ownership re-fix (cross-build postinst casualty, issue #60) ────
# mail-mta/nullmailer's pkg_postinst runs `chown nullmail:nullmail … || die` BY
# NAME. On the CROSS builders (rpi5/jetson/orangepi*/frite: ROOT=<sysroot>
# merges, crossdev wrapper appends --root-deps=rdeps and cross_emerge passes
# --with-bdeps=n, so the ebuild's own `BDEPEND="acct-user/nullmail"` never
# merges to /) that chown executes on the x86 BUILD HOST and resolves the name
# against the HOST's passwd — so it dies "chown: invalid user: 'nullmail'"
# (2026-08-19 mesh run). Portage treats a postinst die as NON-critical: the vdb
# entry and the package FILES stay, emerge just exits non-zero. The damage,
# measured in the real 08-15 cross sysroots, is exactly:
#     /var/log/nullmailer               root:root (mode 770 — fperms had run)
#     /var/spool/nullmailer/{tmp,queue,failed}  root:root 755 (chmod never ran)
#     /var/spool/nullmailer/trigger     root:root 660 (mkfifo ran BEFORE the die)
# i.e. the fifo IS created; it is only ever the ownership + the spool modes that
# are lost, because the die aborts pkg_postinst at its first chown.
#
# The clean fix is upstream-shaped (a ROOT-aware postinst in the ebuild — the
# `egetent group X | cut -d: -f3` numeric-id idiom sys-apps/shadow, sys-libs/pam
# and acct-group/shadow already use for precisely this hazard) or a host-side
# pre-seed of acct-{user,group}/nullmail. Until then, re-run the postinst's
# idempotent tail HERE, at first boot on the REAL system, where acct-user/
# nullmail IS in /etc/passwd (uid 88 — it merges into the sysroot fine; only the
# host-side name lookup broke). No-op when nullmailer isn't installed or
# ownership is already right; native x86 builds were never affected (their
# chroot IS the sysroot, so the name resolves).
if getent passwd nullmail >/dev/null 2>&1 && [ -d /var/spool/nullmailer ]; then
    # Every step is CHECKED and counted. The previous revision suppressed all
    # stderr and `|| true`'d each command, then printed its success line
    # unconditionally — so a re-fix that repaired NOTHING still reported
    # "re-applied". A silent no-op here ships a spool the nullmail daemon cannot
    # write to, which is the whole defect this block exists to undo.
    _nm_fail=0
    if [ ! -p /var/spool/nullmailer/trigger ]; then
        mkfifo --mode=0660 /var/spool/nullmailer/trigger || _nm_fail=$((_nm_fail + 1))
    fi
    for _nm_p in /var/log/nullmailer /var/spool/nullmailer/tmp \
                 /var/spool/nullmailer/queue /var/spool/nullmailer/failed; do
        if [ ! -d "${_nm_p}" ]; then
            echo "nullmailer: MISSING ${_nm_p} — package merge is incomplete" >&2
            _nm_fail=$((_nm_fail + 1)); continue
        fi
        chown nullmail:nullmail "${_nm_p}" || _nm_fail=$((_nm_fail + 1))
        chmod 770 "${_nm_p}"               || _nm_fail=$((_nm_fail + 1))
    done
    if [ -p /var/spool/nullmailer/trigger ]; then
        chown nullmail:nullmail /var/spool/nullmailer/trigger || _nm_fail=$((_nm_fail + 1))
        chmod 660 /var/spool/nullmailer/trigger               || _nm_fail=$((_nm_fail + 1))
    else
        echo "nullmailer: MISSING /var/spool/nullmailer/trigger — mkfifo failed" >&2
        _nm_fail=$((_nm_fail + 1))
    fi
    if [ -f /etc/nullmailer/remotes ]; then
        # Holds relay passwords: root:nullmail 0640, same as the postinst tail.
        chown root:nullmail /etc/nullmailer/remotes || _nm_fail=$((_nm_fail + 1))
        chmod 0640 /etc/nullmailer/remotes          || _nm_fail=$((_nm_fail + 1))
    fi
    if [ "${_nm_fail}" -eq 0 ]; then
        echo "nullmailer: re-applied postinst ownership (cross-build sysroot fix — see the builder's ROOT= merge note)"
    else
        echo "nullmailer: WARNING — ownership re-fix INCOMPLETE (${_nm_fail} step(s) failed)." >&2
        echo "nullmailer:   The mail spool/log may still be root-owned and nullmailer-send will not" >&2
        echo "nullmailer:   be able to write to it. Recover with: emerge --config mail-mta/nullmailer" >&2
    fi
    unset _nm_fail _nm_p
elif [ -d /var/spool/nullmailer ]; then
    # The whole re-fix is premised on acct-user/nullmail having merged into the
    # IMAGE (it did on every cross sysroot measured: nullmail:x:88:88). If that
    # premise ever breaks, the guard above would simply vanish without a word and
    # the spool would ship root-owned with nothing in the log to say why.
    echo "nullmailer: WARNING — /var/spool/nullmailer exists but user 'nullmail' is absent;" >&2
    echo "nullmailer:   ownership NOT re-applied (acct-user/nullmail did not merge into the image)." >&2
fi

if [ -b /dev/nvme0n1 ]; then
    echo "NVMe detected: $(nvme id-ctrl /dev/nvme0n1 -H 2>/dev/null | grep 'Model Number' || echo '/dev/nvme0n1')"
fi

echo ""
echo "=== @@BRAND_TITLE@@ first boot (@@HOSTNAME@@) ==="
echo "  Hostname:    $(cat /etc/hostname 2>/dev/null || echo @@HOSTNAME@@)"
echo "  Kubernetes:  $(kubelet --version 2>/dev/null || echo 'installed')"
echo "  containerd:  $(containerd --version 2>/dev/null || echo 'installed')"
echo "  Headscale:   $(headscale version 2>/dev/null || echo 'installed')"
echo ""
echo "  Provisioned from USB KEYS:  see /var/log/keys-provision.log"
echo "  Control plane:  kubeadm init --config /etc/kubernetes/kubeadm-config.yaml"
echo "  Worker node:    kubeadm join <cp>:6443 --token <tok> --discovery-token-ca-cert-hash <hash>"
echo ""
echo "  SSH: key-only — keys come from the USB KEYS users.json / ssh/ directory."
# One line on purpose: the x86 unaffiliated build deletes it by this phrase.
echo "  If you booted WITHOUT a KEYS stick, log in as the local account above (not an administrator unless built with --local-admin)."
echo "========================================================"

# Stay in place when the standalone account could not be made, so the next boot
# retries instead of leaving an image nobody can log in to.
${SA_RETRY} || rm -f /etc/local.d/01-firstboot.start
