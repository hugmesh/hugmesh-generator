{
  // Snapdragon fleet mesh ACL policy (headscale 0.23.x, file mode).
  //
  // GOAL: a flat L3 mesh — every fleet node reaches every other fleet node on
  // every port, AND pods/ClusterIP services on one node are reachable from any
  // node as though on one LAN. Fleet-scoped and least-surprising: this is a
  // default-deny policy that ONLY opens fleet-internal traffic + the cluster's
  // pod/service CIDRs. There is NO internet-wide ("*") grant and NO autogroup
  // exit-node access.
  //
  // hujson = JSON with comments + trailing commas; headscale parses it natively.
  // This particular file is also strict JSON (no trailing commas) so it lints
  // with a plain `jq` after comments are stripped.

  // ── Who may apply which tags ──────────────────────────────────────────────
  // Tags are self-applied by each node at join via `tailscale up
  // --advertise-tags=...`. A node may only claim a tag whose owner is the
  // headscale user its preauth key was minted under — here, "snapdragon"
  // (see provision_headscale: `headscale users create snapdragon` + preauthkey
  // --user snapdragon). tag:snapdragon is the fleet-wide membership tag; the
  // per-role tags are reserved for future segmentation (all owned by the same
  // user, so any node can self-tag).
  "tagOwners": {
    "tag:snapdragon": ["snapdragon"],
    "tag:pki": ["snapdragon"],
    "tag:be": ["snapdragon"],
    "tag:fe": ["snapdragon"],
    "tag:host": ["snapdragon"]
  },

  // ── Subnet-route auto-approval ────────────────────────────────────────────
  // Each fleet node advertises the cluster-wide pod + service CIDRs
  // (--advertise-routes=10.244.0.0/16,10.96.0.0/12). Listing those exact
  // prefixes here, owned by tag:snapdragon, makes headscale auto-approve them
  // the moment a tagged node advertises them — no manual
  // `headscale nodes approve-routes` step. Routes outside these prefixes are
  // NOT auto-approved.
  "autoApprovers": {
    "routes": {
      "10.244.0.0/16": ["tag:snapdragon"],
      "10.96.0.0/12": ["tag:snapdragon"]
    }
  },

  // ── Access rules (default-deny; only these accepts apply) ─────────────────
  "acls": [
    // 1) Full intra-fleet mesh: any fleet node -> any fleet node, all ports.
    {
      "action": "accept",
      "src": ["tag:snapdragon"],
      "dst": ["tag:snapdragon:*"]
    },

    // 2) "One LAN" reachability: any fleet node -> any pod IP or ClusterIP,
    //    all ports. Combined with the advertised+auto-approved subnet routes
    //    above, this lets every tailnet member reach pods/services on any node
    //    (including non-k8s admin members and off-node ClusterIP access).
    {
      "action": "accept",
      "src": ["tag:snapdragon"],
      "dst": ["10.244.0.0/16:*", "10.96.0.0/12:*"]
    }
  ]
}
