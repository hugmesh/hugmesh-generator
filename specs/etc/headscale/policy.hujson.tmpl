{
  // ── HugMesh Layer-A GENERATED headscale policy (device-license registry) ──
  //
  // RENDERED at runtime by /usr/sbin/gen-headscale-policy.sh ONLY on the
  // headscale control (pki) node, from the SAME signed export Layer-B consumes
  // (GET /bff/admin/device-licenses/export?mesh=<MESH_ID>, detached-Ed25519
  // verified against the BAKED registry-pub.ed25519). The output path stays
  // /etc/headscale/policy.hujson; on a content change the renderer runs
  // `headscale policy set -f /etc/headscale/policy.hujson` (REQUIRED: headscale
  // runs policy mode:file, which is NOT hot-reloaded from the DB).
  //
  // This template carries the STATIC head (tagOwners + autoApprovers + the KEPT
  // k8s pod/service-CIDR data-plane rule) and TWO splice markers the renderer
  // replaces with jq-emitted, deterministically-sorted JSON arrays. The marker
  // strings appear EXACTLY ONCE each (at their splice point) — they are NOT
  // repeated in prose (an awk gsub would otherwise corrupt these comments). The
  // two markers are:
  //   * the tagOwners-dynamic marker — this mesh's tag:mesh_<MESH_ID> plus one
  //       per-node tag:dev_<fp>, each with the EMPTY owner list [] (NEVER
  //       self-applyable; they are SERVER-FORCED via hugmesh-headscale-forcetags
  //       at approval). tag:dom_<domain> gets no entry: no rule names it, and an
  //       unlisted tag is already refused when a node advertises it.
  //   * the ssh-edges marker — EXACTLY the predicate-permitted ssh accepts (one
  //       per export node: src=advisory tag:hugmesh, dst=tag:dev_<fp>,
  //       users=node-local privileged ssh user) PLUS the ALWAYS-emitted
  //       SUPERADMIN mesh rule (src:[tag:superadmin], dst:[tag:mesh_<MESH_ID>],
  //       users:[<ssh user>]).
  //
  // The FOUR FIXES embodied here:
  //   [FIX-SERVERTAG]  security tags (tag:superadmin, tag:mesh_*, tag:dev_*)
  //                    are server-forced and listed with the EMPTY owner list
  //                    [] in tagOwners. headscale 0.23 accepts a self-advertised
  //                    tag when the node's USER is listed as its owner, and every
  //                    node registers as the "hugmesh" user, so an owner of
  //                    ["hugmesh"] let ANY node claim the tag (measured: a node
  //                    advertising tag:superadmin got valid_tags=[tag:superadmin]
  //                    and became an SSH principal of the superadmin rule on
  //                    every tag:mesh_ node). With [] nobody owns them, so a
  //                    self-advertisement lands in invalid_tags; forced tags
  //                    (preauth-key tags and `headscale nodes tag -t`) bypass
  //                    tagOwners and still apply.
  //   [FIX-DROPMESHRULE] the any-to-any tag:hugmesh -> tag:hugmesh:* rule
  //                    is ABSENT; only the 10.244/10.96 CIDR data-plane rule is
  //                    kept (k8s, not SSH).
  //   [FIX-DENY22]     headscale ssh is itself default-deny, so the generated
  //                    ssh[] block (the ONLY accepts) IS the default-deny on :22.
  //   [FIX-OIDC-USERS] DEFERRED — src identity is still the advisory
  //                    tag:hugmesh (the reusable preauth key still gates JOIN);
  //                    per-operator SOURCE authenticity + per-key %f pinning stay
  //                    in Layer-B (the load-bearing boundary). See the PR body.
  //
  // hujson = JSON + comments + trailing commas; headscale parses it natively.

  // ── Who may apply which tags ──────────────────────────────────────────────
  // tag:hugmesh and the role tags (pki/be/fe/host) stay self-applied, so they
  // stay owned by "hugmesh" (data-plane membership: CIDR rule + route
  // auto-approval ONLY; tag:hugmesh is NO LONGER a :22 src/dst). This matters
  // after approval too: `headscale nodes tag -t` REPLACES the forced-tag list,
  // so once hugmesh-headscale-forcetags runs, a node keeps tag:hugmesh only
  // through its own --advertise-tags. tag:superadmin is owned by NOBODY ([])
  // and is force-assigned to superadmin OPERATOR machines only. The dynamic
  // tag:mesh_/tag:dev_ entries (also []) are spliced at the marker below.
  "tagOwners": {
    "tag:hugmesh": ["hugmesh"],
    "tag:pki": ["hugmesh"],
    "tag:be": ["hugmesh"],
    "tag:fe": ["hugmesh"],
    "tag:host": ["hugmesh"],
    "tag:superadmin": []@@HUGMESH_TAGOWNERS_DYNAMIC@@
  },

  // ── Subnet-route auto-approval (UNCHANGED) ────────────────────────────────
  "autoApprovers": {
    "routes": {
      "10.244.0.0/16": ["tag:hugmesh"],
      "10.96.0.0/12": ["tag:hugmesh"]
    }
  },

  // ── Access rules (default-deny) ───────────────────────────────────────────
  // KEPT: the k8s pod/ClusterIP "one-LAN" data-plane rule. The any-to-any
  // tag:hugmesh -> tag:hugmesh:* :22 hole is DROPPED [FIX-DROPMESHRULE].
  "acls": [
    {
      "action": "accept",
      "src": ["tag:hugmesh"],
      "dst": ["10.244.0.0/16:*", "10.96.0.0/12:*"]
    }
  ],

  // ── Tailscale SSH — generated default-deny per-edge block ─────────────────
  // headscale ssh is default-deny; the accepts spliced below are the ONLY SSH
  // surface. Each export operator yields exactly one accept to its node's
  // server-forced tag:dev_<fp>; the SUPERADMIN mesh rule is always appended.
  "ssh": [@@HUGMESH_SSH_EDGES@@
  ]
}
