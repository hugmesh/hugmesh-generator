{
  // ── HugMesh Layer-A BOOTSTRAP headscale policy (device-license registry) ──
  //
  // This is the MINIMAL policy baked into the image and applied by
  // provision_headscale during the bootstrap window — BEFORE the BFF
  // /bff/admin/device-licenses/export endpoint exists / is reachable, so the
  // mesh can still come up and the privileged operator can reach nodes during
  // provisioning. The FIRST verified Layer-A sync (gen-headscale-policy.sh)
  // WHOLESALE re-renders /etc/headscale/policy.hujson from policy.hujson.tmpl +
  // the signed export and re-applies it (`headscale policy set -f`), replacing
  // this bootstrap policy with the generated default-deny per-edge SSH block.
  //
  // DELIBERATE DIFFERENCE FROM #66's policy.hujson: the flat any-to-any
  //   {src:[tag:hugmesh], dst:[tag:hugmesh:*]}
  // ACL (which exposed EVERY node's :22 to every other node) is DROPPED even
  // here, pre-export. That hole need not exist at ANY time — k8s pod/ClusterIP
  // traffic rides the 10.244/10.96 data-plane rule below (NOT :22), and SSH
  // rides the explicit ssh[] block. The two-phase flip mirrors Layer-B's
  // selinux-style enforce gate: this conservative bootstrap policy holds until
  // the first verified export, then the generated per-edge edges replace it.
  //
  // hujson = JSON + comments + trailing commas; headscale parses it natively.

  // ── Who may apply which tags ──────────────────────────────────────────────
  // tag:hugmesh STAYS self-applied (the data-plane MEMBERSHIP tag gating the
  // CIDR rule + route auto-approval); the mesh-join flow (preauth key,
  // --advertise-tags=tag:hugmesh) is UNTOUCHED by Layer-A.
  //
  // The SECURITY tags — tag:superadmin, tag:mesh_*, tag:dev_*, tag:dom_* — are
  // owned by NO user (empty owner list) and are SERVER-FORCED via
  // `headscale nodes tag` at approval (hugmesh-headscale-forcetags). headscale
  // 0.23 gives a node its forced tags PLUS every advertised tag its own user
  // owns; a forced tag does not cancel a different advertised one. Every
  // pre-auth key is minted for the MEMBERSHIP user "hugmesh", so if "hugmesh"
  // owned tag:superadmin, any key holder could advertise it and get SSH as the
  // privileged user on every node. With an empty owner list an advertised
  // security tag is always invalid, while a forced one still applies (forcing
  // does not consult tagOwners). Never give these tags an owner.
  //
  // headscale tagOwners keys must be exact tag strings, so only the STATIC
  // tag:superadmin is listed here; the rendered policy adds tag:mesh_<id> and
  // the per-node tag:dev_<fp> entries, also with empty owner lists.
  "tagOwners": {
    "tag:hugmesh": ["hugmesh"],
    "tag:pki": ["hugmesh"],
    "tag:be": ["hugmesh"],
    "tag:fe": ["hugmesh"],
    "tag:host": ["hugmesh"],
    "tag:superadmin": []
  },

  // ── Subnet-route auto-approval (UNCHANGED from #66) ───────────────────────
  // Fleet nodes advertise the cluster pod + service CIDRs; auto-approve exactly
  // those prefixes for tag:hugmesh. Keep in sync with kubeadm-config.yaml.
  "autoApprovers": {
    "routes": {
      "10.244.0.0/16": ["tag:hugmesh"],
      "10.96.0.0/12": ["tag:hugmesh"]
    }
  },

  // ── Access rules (default-deny; only these accepts apply) ─────────────────
  // KEPT: the k8s "one-LAN" pod/ClusterIP data-plane rule. DROPPED: the
  // any-to-any tag:hugmesh -> tag:hugmesh:* rule (the :22 hole).
  "acls": [
    {
      "action": "accept",
      "src": ["tag:hugmesh"],
      "dst": ["10.244.0.0/16:*", "10.96.0.0/12:*"]
    }
  ],

  // ── Tailscale SSH — bootstrap window only (#66 behaviour) ─────────────────
  // A SINGLE conservative accept so the privileged operator can reach nodes
  // during provisioning. keys-provision rewrites @@TS_SSH_USER@@ to the
  // provisioned privileged user (provision.json .tailscale.ssh_user) before
  // `headscale policy set`. headscale SSH is itself default-deny, so this one
  // accept IS the whole SSH surface in the bootstrap window. The FIRST verified
  // Layer-A sync OVERWRITES this with the per-edge generated block (and removes
  // the @@TS_SSH_USER@@ placeholder entirely).
  "ssh": [
    {
      "action": "accept",
      "src": ["tag:hugmesh"],
      "dst": ["tag:hugmesh"],
      "users": ["@@TS_SSH_USER@@"]
    }
  ]
}
