#!/sbin/openrc-run

description="Detect + mount the external media-data device (Steam library + Vaults)"
command="/usr/sbin/snapdragon-media-detect"
# A one-shot that runs to completion at boot (re-runs every boot so a
# later-attached data disk is picked up); not a long-lived daemon.
command_background=false

depend() {
    need localmount
    after keys-provision
    before display-manager
    use logger
}
