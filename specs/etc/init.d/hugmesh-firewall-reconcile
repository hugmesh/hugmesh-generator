#!/sbin/openrc-run

description="Render + load the RELEASE_STATE host nftables backstop (Layer 3, independent of K8s NetworkPolicy + firewalld)"

# Runs ONCE at boot (a oneshot) via start(), ordered BEFORE containerd/
# kubelet/tailscaled so the backstop is live before any pod network / ingress
# controller comes up. AFTER firewalld (cosmetic layering only — the two own
# entirely separate nftables tables and never conflict). The 60s cron half
# (cron.d/hugmesh-firewall-reconcile) is the convergence floor for a LIVE
# RELEASE_STATE flip / go-live marker (no reboot/reflash required).

depend() {
    need net
    after firewall
    before containerd kubelet tailscaled
}

command="/usr/sbin/hugmesh-firewall-reconcile"
command_background=false

start() {
    ebegin "Reconciling the RELEASE_STATE host nftables backstop (fail-closed to the existing ruleset on error)"
    "${command}"
    # Non-zero ONLY when no hugmesh_release_gate table is live (a failed reload over
    # an existing table keeps it and exits 0): say UNPROTECTED, never "preserved".
    eend $? "NO RELEASE_STATE backstop is loaded (table inet hugmesh_release_gate absent) — this node is UNPROTECTED; see the ERROR above and /run/hugmesh/firewall-health/"
}

stop() {
    return 0
}
