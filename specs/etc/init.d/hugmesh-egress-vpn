#!/sbin/openrc-run

description="Egress VPN (split-tunnel, fail-closed) for OUTGOING public-facing traffic"

# NODE-level egress VPN: one wg-quick (WireGuard, first-class) / openvpn (fallback)
# interface carries the node's PUBLIC egress (coturn UDP audio/video, made-public
# services, and — only on explicit assignment — akkoma/matrix federation) while the
# tailnet control plane + cluster-internal traffic stay DIRECT (split-tunnel). The
# heavy lifting (type-sniff + ip-rule priorities + Table=off + fwmark 0x76 -> table
# 176 + blackhole kill-switch + v6) lives in /usr/sbin/hugmesh-vpn-runner.
#
# DEFAULT-OFF optional service: this script is BAKED into every node image but is
# NOT linked into a runlevel by the builder. It is enabled (rc-update add) only
# when the egress-VPN optional service is selected (PR6 gate) or flipped on by the
# signed reconcile agent per assignment (PR5). With no /etc/hugmesh/vpn/
# active.conf the runner is a no-op (public egress falls back to the Squid proxy /
# direct), so even a mistakenly-enabled service never faults the boot.
#
# FAIL-CLOSED: when the VPN is up, table 176's only route is `default dev wg0` +
# a blackhole guard — if wg0 drops, MARKED (0x76) public traffic has no route
# (EPERM) instead of leaking the node WAN IP. Tailnet/cluster traffic is on
# higher-priority DIRECT ip-rules and is unaffected.

command="/usr/sbin/hugmesh-vpn-runner"
command_background=false

depend() {
    need net
    use dns logger
    # After the mesh is up (so tailscale0 + the DIRECT carve-outs exist) and after
    # first-boot provisioning has staged /etc/hugmesh/vpn/active.conf.
    after keys-provision tailscaled firewall
}

start_pre() {
    # The runner + a config dir must exist; a missing active.conf is fine (no-op).
    if [ ! -x "${command}" ]; then
        eerror "${command} missing — egress VPN cannot start"
        return 1
    fi
    checkpath -d -m 0700 /etc/hugmesh/vpn
    modprobe wireguard 2>/dev/null || true
    modprobe tun 2>/dev/null || true
    return 0
}

start() {
    ebegin "Bringing up egress VPN (split-tunnel, fail-closed)"
    "${command}" up
    eend $? "egress VPN up failed (public egress fails closed; tailnet/cluster unaffected)"
}

stop() {
    ebegin "Tearing down egress VPN (back to DIRECT egress)"
    "${command}" down
    eend $? "egress VPN down reported an error"
}

status() {
    "${command}" status
}
