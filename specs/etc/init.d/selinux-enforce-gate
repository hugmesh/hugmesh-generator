#!/sbin/openrc-run

description="Gated permissive->enforcing flip after a clean SELinux settle"

depend() {
    after keys-provision auditd containerd kubelet
    before local
}

# Paths. `:=` defaults rather than bare assignments so OpenRC's
# /etc/conf.d/selinux-enforce-gate can retarget them on an odd image — and so the
# gate's start() can be executed for real against a fixture in
# tests/scripts/test-selinux-policy-install.sh instead of merely grepped. The
# DEFAULT-OFF switch below is deliberately NOT one of these overridable knobs in
# spirit: overriding it IS the opt-in.
: "${MARKER:=/var/lib/keys-provision/selinux-settled}"
: "${CONFIG:=/etc/selinux/config}"
: "${TYPE:=mcs}"
# The relabel-boot flag /.autorelabel — a variable for the same reason.
: "${AUTORELABEL:=/.autorelabel}"
# How "does this image run containers?" is answered (see required_modules()).
: "${CONTAINERD_INITD:=/etc/init.d/containerd}"
# Build-time manifest of the node-policy modules THIS image actually installed,
# written by scripts/_selinux-policy-lib.sh next to the .pp files it installs.
: "${MODULE_MANIFEST:=/usr/share/hugmesh/selinux-modules.list}"
# First-boot failure marker: provision_selinux() records here when an image
# BUILT selinux-aware (/usr/share/hugmesh/selinux-built) ended provisioning
# WITHOUT a loaded policy — its hard postcondition. The node still boots
# (degrade loudly, never brick), but it must never go enforcing while this
# stands. A successful re-provision (KEYS_FORCE=1 / .provision-force) clears it.
: "${PROVISION_FAILED:=/var/lib/keys-provision/selinux-load-failed}"

# ── DEFAULT-OFF SWITCH ───────────────────────────────────────────────────────
# Sourced by OpenRC from /etc/conf.d/selinux-enforce-gate, which the builders
# ship with SELINUX_ENFORCE_GATE="no". This is the SECOND of two independent
# locks: the first is that the builders do not link this service into any
# runlevel unless HUGMESH_SELINUX_ENFORCE_GATE=1 was set at build time. Both must
# be opened before a node can ever leave permissive, so an operator who
# `rc-update add`s the service by hand still gets a no-op until they also flip
# this — no surprise flips.
#
# WHY DEFAULT OFF: specs/selinux/*.te still carry rules tagged
# '# INFERRED-WIDE: narrow after QEMU enforcing AVC pass'. Those can only be
# narrowed against real AVC denials from a real protected build + boot. Going
# enforcing on unnarrowed rules risks a node that boots into a broken state,
# with no console to fix it from. Permissive + loaded modules + logged AVCs is
# the honest posture; enforcing is the follow-up once someone has run that pass.
: "${SELINUX_ENFORCE_GATE:=no}"

check_enabled() {
    case "${SELINUX_ENFORCE_GATE}" in
        [Yy][Ee][Ss]|1|[Tt][Rr][Uu][Ee]) return 0 ;;
    esac
    return 1
}

check_relabel_clean() {
    # /.autorelabel REQUESTS a relabel and is removed by whatever completes one
    # (standard semantics). provision_selinux() is the relabeler on these
    # images: it consumes the flag after its own successful relabel and leaves
    # it RAISED when the relabel failed — so "still present" means a relabel is
    # still owed and the labels on disk cannot be trusted. A dry-run must also
    # report no pending changes for the host-integration paths.
    [ -e "${AUTORELABEL}" ] && { ewarn "flip-gate: ${AUTORELABEL} still present"; return 1; }
    if command -v restorecon >/dev/null 2>&1; then
        out=$(restorecon -nrv /mnt/data/local-path /mnt/usb/local-path /var/log/pods 2>/dev/null)
        [ -n "${out}" ] && { ewarn "flip-gate: mislabel detected:"; ewarn "${out}"; return 1; }
    fi
    return 0
}

# ── required-module list, RECONCILED with what the build actually installed ──
# The original hardcoded list was `base container otel_collector
# localpath_provisioner`, which could never be satisfied: nothing compiled or
# installed otel_collector/localpath_provisioner, and `container` only exists on
# images that merge sec-policy/selinux-container. Now the list is DERIVED:
#   * `base`                      — always required; without it no policy loaded.
#   * every name in MODULE_MANIFEST — exactly the modules this image built and
#     installed (comment lines in the manifest record the ones that were skipped
#     WITH THE REASON, e.g. the two k8s exemplars on a non-container image, and
#     are deliberately NOT required here).
#   * `container`                 — required only on images that actually run
#     containers (containerd present), which is where the exemplar modules and
#     the container_t AVC surface live.
# An image with no manifest predates this wiring; refuse rather than flip on an
# unknown policy set.
required_modules() {
    echo base
    if [ -r "${MODULE_MANIFEST}" ]; then
        sed -e 's/#.*//' -e 's/[[:space:]]//g' "${MODULE_MANIFEST}" | grep -v '^$'
    fi
    [ -x "${CONTAINERD_INITD}" ] && echo container
    return 0
}

check_modules() {
    if [ ! -r "${MODULE_MANIFEST}" ]; then
        ewarn "flip-gate: ${MODULE_MANIFEST} absent — this image predates the policy-module"
        ewarn "flip-gate: install step, so the required set is unknown. Refusing to flip."
        return 1
    fi
    local l m; l=$(semodule -s "${TYPE}" -l 2>/dev/null) || return 1
    for m in $(required_modules); do
        printf '%s\n' "${l}" | grep -q "^${m}\b" || { ewarn "flip-gate: module ${m} not loaded"; return 1; }
    done
    return 0
}

# Where the AVC record is read from. Variables for the same reason as the paths
# above: the D-run leg of test-selinux-policy-install.sh points them at fixtures to
# execute every branch, including the fail-closed one.
: "${AUSEARCH:=ausearch}"
: "${AUDIT_LOG:=/var/log/audit/audit.log}"
: "${DMESG:=dmesg}"
# Scratch file for ausearch's stderr (its verdict lives there, see below).
: "${AVC_SCRATCH_DIR:=/run}"

# ausearch_records — print this boot's AVC/USER_AVC records from ausearch, or return
# 1 when ausearch's answer cannot be trusted (the caller then falls back).
#
# ausearch's exit status alone does NOT tell "clean" from "could not read":
#   rc=0  records found;
#   rc=1  "<no matches>" on stderr — but ALSO every error path: an unopenable log
#         ("Error opening /var/log/audit/audit.log (...)"), a bad option or message
#         type ("Invalid ..."), no memory. The source returns 1 for those BEFORE it
#         prints "<no matches>", so the two never appear together.
# The old `rc <= 1 => clean` therefore passed a node whose audit log could not be
# read. Now rc=1 is clean ONLY when stderr carries "<no matches>" and nothing that
# reads like an error; anything else is "not answered".
#
# --input-logs is load-bearing: without it ausearch reads STDIN whenever stdin is a
# pipe (is_pipe(0) in ausearch.c), finds nothing there, and answers "<no matches>".
# Never add --raw/-r: raw output suppresses the "<no matches>" line this relies on.
ausearch_records() {
    local out rc err ef
    command -v "${AUSEARCH}" >/dev/null 2>&1 || return 1
    ef="$(mktemp "${AVC_SCRATCH_DIR}/selinux-enforce-gate.XXXXXX" 2>/dev/null)" || {
        ewarn "flip-gate: cannot create a scratch file in ${AVC_SCRATCH_DIR} for ausearch's stderr — not trusting ausearch"
        return 1
    }
    out="$("${AUSEARCH}" --input-logs -m AVC,USER_AVC -ts boot 2>"${ef}" </dev/null)"; rc=$?
    err="$(cat "${ef}" 2>/dev/null)"; rm -f "${ef}"
    case "${rc}" in
        0)
            # Records found. An error line next to them means a PARTIAL read (one of
            # the rotated logs could not be opened): the missing part is unknown.
            if printf '%s\n' "${err}" | grep -iE 'error|invalid|cannot|can.t|denied|no memory' >/dev/null; then
                ewarn "flip-gate: ${AUSEARCH} found records but also said: ${err}"
                return 1
            fi
            printf '%s\n' "${out}"; return 0 ;;
        1)
            if printf '%s\n' "${err}" | grep -E '^<no matches>$' >/dev/null \
               && ! printf '%s\n' "${err}" | grep -iE 'error|invalid|cannot|can.t|denied|no memory' >/dev/null; then
                return 0   # a clean boot: no AVC/USER_AVC record at all
            fi
            ewarn "flip-gate: ${AUSEARCH} rc=1 without a clean '<no matches>' (stderr: ${err:-<empty>}) — not a clean boot, an unread log" ;;
        *)
            ewarn "flip-gate: ${AUSEARCH} failed (rc=${rc}; stderr: ${err:-<empty>})" ;;
    esac
    return 1
}

# avc_records — print this node's AVC/USER_AVC records on stdout, or return 1 when
# NO source can be read. Sources:
#   ausearch -ts boot     this boot only (the check the gate was written for), when
#                         ausearch_records() trusts its answer; otherwise
#   audit.log             every boot auditd ever logged here — STRICTER than "this
#                         boot", which is the right way to be wrong;
#   dmesg                 ALWAYS added when readable, not only as a last resort.
#                         Before auditd connects the kernel printk's every record
#                         (kauditd_hold_skb) and holds at most audit_backlog_limit
#                         of them for auditd; the overflow is DROPPED from the audit
#                         stream and survives only in the ring buffer. A boot-path
#                         denial from early boot can therefore be missing from
#                         audit.log and present in dmesg. Duplicates are harmless:
#                         any one denial blocks.
# Used to be `command -v ausearch || return 0`: an image without audit tools passed
# the AVC check by construction. An image where nothing can be read refuses to flip.
avc_records() {
    local out have=0
    if out="$(ausearch_records)"; then
        printf '%s\n' "${out}"; have=1
    else
        if [ -r "${AUDIT_LOG}" ]; then
            ewarn "flip-gate: reading ${AUDIT_LOG} directly: every boot's AVCs count, not just this one"
            grep -E '^type=(AVC|USER_AVC) ' "${AUDIT_LOG}"
            have=1
        fi
    fi
    if command -v "${DMESG}" >/dev/null 2>&1 && out="$("${DMESG}" 2>/dev/null)"; then
        [ "${have}" = 1 ] || ewarn "flip-gate: reading AVCs from the kernel ring buffer only (no trusted ausearch, no ${AUDIT_LOG}): it may have wrapped"
        printf '%s\n' "${out}" | grep -E 'avc: +denied'
        have=1
    fi
    [ "${have}" = 1 ]
}

# ── THE ALLOW-LIST: denials that may stand at flip time ─────────────────────────
# EMPTY, and a plain assignment on purpose: /etc/conf.d/selinux-enforce-gate is
# sourced BEFORE this file, so an operator's conf.d cannot widen it. An entry is an
# ERE matched against one denial record. Add one only with (a) the measured record
# quoted in the comment next to it, (b) why it is dontaudit-equivalent noise (the
# access is not needed and its denial changes nothing under enforcing), and (c) a
# reviewed PR. "It shows up on every boot" is not (b): that is what enforcing breaks.
AVC_ALLOW_ERE=''

check_avc_clean() {
    # EVERY boot-path denial counts, whatever its source domain. This check used to
    # look only at container/kernel_t/init_t/hugmesh_* domains, so the 25 denials
    # behind #863 (NetworkManager_t, systemd_tmpfiles_t, local_login_t, udev_t) were
    # all outside it and the original boot would still have FLIPPED. A denial in any
    # domain is a service that enforcing breaks.
    # Keyed on the decision ('avc:  denied'), not on the record type: USER_AVC also
    # carries "avc:  received policyload notice" (dbus, every boot) and auditallow
    # instruments log "avc:  granted"; neither is a denial.
    local recs denials
    if ! recs="$(avc_records)"; then
        ewarn "flip-gate: no trusted ${AUSEARCH}, no readable ${AUDIT_LOG}, no ${DMESG} — the AVC record cannot be read, refusing to flip"
        return 1
    fi
    denials="$(printf '%s\n' "${recs}" | grep -E 'avc: +denied')"
    # Apply the allow-list only when it has an entry: `grep -vE ''` drops EVERY line.
    if [ -n "${AVC_ALLOW_ERE}" ] && [ -n "${denials}" ]; then
        denials="$(printf '%s\n' "${denials}" | grep -vE "${AVC_ALLOW_ERE}")"
    fi
    if [ -n "${denials}" ]; then
        ewarn "flip-gate: $(printf '%s\n' "${denials}" | wc -l) outstanding AVC denial(s) this boot — staying permissive. First ones:"
        printf '%s\n' "${denials}" | head -n 5 | while read -r _d; do ewarn "flip-gate:   ${_d}"; done
        return 1
    fi
    return 0
}

check_mode_sane() {
    selinuxenabled || { ewarn "flip-gate: SELinux disabled (policy never loaded) — refusing flip"; return 1; }
    [ "$(getenforce 2>/dev/null)" = "Permissive" ] || { ewarn "flip-gate: not in Permissive (got $(getenforce))"; return 1; }
    return 0
}

check_provision_ok() {
    # provision_selinux()'s hard postcondition failed: a selinux-aware image
    # finished first boot without a working policy load. The reasons are IN the
    # marker file — surface them here rather than making the operator dig.
    if [ -e "${PROVISION_FAILED}" ]; then
        ewarn "flip-gate: ${PROVISION_FAILED} present — first-boot policy load FAILED on this selinux-aware image:"
        while read -r _pf_line; do ewarn "flip-gate:   ${_pf_line}"; done < "${PROVISION_FAILED}"
        ewarn "flip-gate: fix the load, then re-provision (KEYS_FORCE=1 / .provision-force) to clear it"
        return 1
    fi
    return 0
}

start() {
    ebegin "SELinux enforce-gate"
    # OPT-IN LOCK — checked FIRST, before the marker is even written, so a
    # default image can never take a step down this path.
    if ! check_enabled; then
        einfo "disabled (SELINUX_ENFORCE_GATE=${SELINUX_ENFORCE_GATE} in /etc/conf.d/selinux-enforce-gate)"
        einfo "node stays PERMISSIVE with its policy modules loaded and AVCs logged"
        eend 0; return 0
    fi
    # Marker guard: write it the FIRST time we run so the flip can only
    # happen on the SECOND (or later) boot, never the relabel boot.
    if [ ! -e "${MARKER}" ]; then
        mkdir -p "$(dirname "${MARKER}")"; touch "${MARKER}"
        einfo "first settle boot recorded; flip deferred to next boot"
        eend 0; return 0
    fi
    if check_mode_sane && check_provision_ok && check_modules && check_relabel_clean && check_avc_clean; then
        setenforce 1 && sed -i 's/^SELINUX=permissive/SELINUX=enforcing/' "${CONFIG}"
        einfo "all gate checks passed — flipped to enforcing (persisted)"
        rc-update del selinux-enforce-gate default 2>/dev/null || true
        eend 0
    else
        eend 0 "gate not satisfied — staying permissive, will retry next boot"
    fi
}

stop() { return 0; }
