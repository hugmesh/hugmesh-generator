#!/sbin/openrc-run

description="Materialise the v3 Tor onion service (managed torrc + off-git onion keypair)"

# Tor onion-service reconcile: renders + verifies the managed /etc/tor/torrc and
# ensures the onion state dirs (/var/lib/tor/hugmesh-onion[.d/<slug>], tor:tor 0700).
# Runs ONCE at boot (a oneshot); the refresh half is a cron.d drop-in (an `@reboot`
# entry plus a 24h one — OpenRC has no native timer; cronie is in the node image).
#
# Linked (with the distro `tor` service itself — decision 70 = B on
# hugmesh-generator#347) ONLY when the 'tor' optional service is selected on a
# cluster-node role; otherwise it stays a baked-but-inert no-op. OpenRC supervises
# the daemon; this oneshot is ordered `before tor` so the managed torrc exists when
# tor first reads it. Because of that ordering, tor is `iafter` this service: the
# agent therefore NEVER runs `rc-service tor start|restart` from inside this start()
# (openrc-run exports RC_SVCNAME=hugmesh-tor-reconcile, which the agent checks) — a
# nested start would wait the 60 s WAIT_TIMEOUT on this oneshot's own lock. OpenRC
# starts tor right after this returns; the cron's `@reboot` run exports a first-boot
# hostname once tor has minted it. A running tor (a by-hand restart of this service)
# is only reloaded, and only when the torrc changed. The agent is FAIL-SOFT: any
# error preserves the existing keypairs + torrc and exits 0, so a failed reconcile
# never faults the boot or tears down a working onion service.

command="/usr/sbin/hugmesh-tor-reconcile"
command_background=false

depend() {
    need net
    use dns logger
    # After first-boot provisioning, and BEFORE the distro tor service so the managed
    # torrc + onion state dir exist when tor first reads its config.
    after keys-provision tailscaled
    before tor
}

start() {
    ebegin "Reconciling the Tor v3 onion service (off-git keypair; stable .onion hostname)"
    "${command}"
    eend $? "Tor reconcile reported an error (cached keypair + torrc preserved)"
}

stop() {
    return 0
}
