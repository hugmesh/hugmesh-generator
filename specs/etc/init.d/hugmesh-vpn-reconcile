#!/sbin/openrc-run

description="Sync + verify the signed egress-VPN per-node export, then reconcile the local VPN"

# Egress-VPN convergence service: runs the fetch/verify/write-Secret/flip-active/
# restart/leak-check/report agent ONCE at boot (a oneshot). The 60s timer half is
# a cron.d drop-in (OpenRC has no native timer; cronie is already in the node
# image). The BFF drives fast propagation; this boot-oneshot + cron pull is the
# convergence FLOOR.
#
# Enabled (rc-update add) ONLY when the egress-VPN optional service is selected
# (PR6 gate) — or it stays a baked-but-inert no-op. The agent is FAIL-CLOSED: on
# any fetch/verify failure it keeps the last-good cache + leaves the running tunnel
# as-is and exits 0, so a failed sync never faults the boot or tears a working
# tunnel down.

depend() {
    need net
    use dns logger
    # After first-boot provisioning (which bakes node.env + the public key + the
    # key-USB configs) and after the egress-VPN service exists.
    after keys-provision tailscaled hugmesh-egress-vpn
}

command="/usr/sbin/hugmesh-vpn-reconcile"
command_background=false

start() {
    ebegin "Reconciling egress VPN from the signed per-node export (fail-closed; keeps last-good on error)"
    "${command}"
    eend $? "egress-vpn reconcile reported an unexpected error (cache + tunnel preserved)"
}

stop() {
    return 0
}
