#!/sbin/openrc-run

description="Render + apply the signed device-license-registry headscale policy (Layer-A tailnet ACL)"

# Layer-A convergence service: runs the fetch/verify/render/apply agent ONCE at
# boot (a oneshot). The 60s timer half is a cron.d drop-in
# (/etc/cron.d/hugmesh-policy-sync) — OpenRC has no native timer and cronie is
# already in the node image. The BFF push-with-ack (FIX-REVOKE) drives FAST
# propagation; this boot-oneshot + cron pull is the convergence FLOOR.
#
# CENTRALIZED: installed (rc-update add) ONLY on the headscale CONTROL (pki) node
# by provision_headscale_policy_sync() — unlike Layer-B, which every ADMIN node
# runs. The agent is FAIL-CLOSED: on any fetch/verify failure it KEEPS the last
# applied policy (or the baked bootstrap policy if never synced) and exits 0, so a
# failed sync never faults the boot and never widens the ACL to allow-all.

depend() {
    need net
    use dns logger
    # Run AFTER first-boot provisioning (which bakes node.env + the public key +
    # the bootstrap policy) and after tailscaled + headscale are up so the socket
    # is reachable and the control node has joined its own tailnet.
    after keys-provision tailscaled headscale
}

command="/usr/sbin/gen-headscale-policy.sh"
command_background=false

start() {
    ebegin "Rendering device-license-registry headscale policy (fail-closed; keeps last-applied policy on error)"
    "${command}"
    # The agent always exits 0 (fail-closed = keep last-applied policy, never fault
    # boot). A non-zero here would only be an unexpected crash; surface it but
    # don't block.
    eend $? "Layer-A policy sync reported an unexpected error (current policy preserved)"
}

stop() {
    return 0
}
