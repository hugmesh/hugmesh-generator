# hugmesh_tor.fc
# Label the Tor onion-service reconcile binary as the entrypoint of its domain and
# its private export dir as the type it manages. The binary is copied to /usr/sbin
# by the (protected) build script; the OpenRC oneshot init script
# (hugmesh-tor-reconcile) + the 24h reconcile cron are baked alongside.
# provision_selinux()'s first-boot relabel (setfiles / restorecon -RF /) applies these.
#
# The Tor DAEMON's own files (/etc/tor/torrc, /var/lib/tor + the onion keypair under
# /var/lib/tor/hugmesh-onion) are labelled by the UPSTREAM tor policy
# (sec-policy/selinux-tor: tor_etc_t / tor_var_lib_t) — NOT relabelled here; the
# reconcile domain is granted manage access to those upstream types in the .te.
#
# /var/lib/hugmesh/tor is created 0700 at runtime by the reconcile agent; labelling
# it hugmesh_tor_var_lib_t lets the agent publish the exported .onion hostname there.
# /etc/hugmesh/tor (the optional upstream-override file) is hugmesh_tor_etc_t.

/usr/sbin/hugmesh-tor-reconcile    --    gen_context(system_u:object_r:hugmesh_tor_reconcile_exec_t,s0)
/usr/bin/hugmesh-tor-reconcile    --    gen_context(system_u:object_r:hugmesh_tor_reconcile_exec_t,s0)

/etc/hugmesh/tor(/.*)?                   gen_context(system_u:object_r:hugmesh_tor_etc_t,s0)

/var/lib/hugmesh/tor(/.*)?               gen_context(system_u:object_r:hugmesh_tor_var_lib_t,s0)
