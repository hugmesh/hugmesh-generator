# hugmesh_vpn.fc
# Label the egress-VPN node binaries as the entrypoints of their domains and
# the VPN config dir + /run staging as the types the domains manage. The
# binaries are copied to /usr/sbin by the (protected) build script; the
# OpenRC init script (hugmesh-egress-vpn) + the reconcile init/cron are
# baked alongside. provision_selinux()'s first-boot relabel (setfiles /
# restorecon -RF /) applies these.
#
# /etc/hugmesh/vpn is created 0700 at runtime by the runner's start_pre /
# the reconcile agent; labelling it hugmesh_vpn_etc_t lets the reconcile
# agent (writer) drop 0600 .conf files + flip the active.conf symlink and the
# runner (reader) read active.conf. The /run staging conf the runner writes is
# hugmesh_vpn_runtime_t. The reconcile agent's own /var/lib cache is left
# var_lib_t in v1 (see the .te INFERRED-WIDE note — narrow to a private type
# after the AVC pass if AVCs show a cross-type denial).
#
# /etc/hugmesh/vpn-secret is the reconcile agent's VPN_SECRET_DIR — the
# hostPath the egress-vpn secret-projector DaemonSet (manifests/egress-vpn)
# writes the cluster Secret's config bytes into, and the ONLY input the agent
# reads from outside /etc/hugmesh/vpn. It needs its OWN pattern: the regex
# above is anchored on `/etc/hugmesh/vpn` + `/` or end-of-name, so
# `vpn-secret` does NOT match it and would otherwise stay plain etc_t. Same
# type as the config dir so the agent's existing read/manage pattern covers
# both without a new rule.

/usr/sbin/hugmesh-vpn-runner       --    gen_context(system_u:object_r:hugmesh_vpn_runner_exec_t,s0)
/usr/bin/hugmesh-vpn-runner       --    gen_context(system_u:object_r:hugmesh_vpn_runner_exec_t,s0)
/usr/sbin/hugmesh-vpn-reconcile    --    gen_context(system_u:object_r:hugmesh_vpn_reconcile_exec_t,s0)
/usr/bin/hugmesh-vpn-reconcile    --    gen_context(system_u:object_r:hugmesh_vpn_reconcile_exec_t,s0)
/usr/sbin/hugmesh-vpn-mark         --    gen_context(system_u:object_r:bin_t,s0)
/usr/bin/hugmesh-vpn-mark         --    gen_context(system_u:object_r:bin_t,s0)

/etc/hugmesh/vpn(/.*)?                   gen_context(system_u:object_r:hugmesh_vpn_etc_t,s0)
/etc/hugmesh/vpn-secret(/.*)?            gen_context(system_u:object_r:hugmesh_vpn_etc_t,s0)

/run/hugmesh-egress-.*\.conf       --    gen_context(system_u:object_r:hugmesh_vpn_runtime_t,s0)
/run/hugmesh-egress-vpn\.ovpn\.pid --    gen_context(system_u:object_r:hugmesh_vpn_runtime_t,s0)
