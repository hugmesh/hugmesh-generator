################################################################
# snapdragon_device_registry_sync.te
# Confined domain for the snapdragon-device-registry-sync daemon
# (/usr/sbin/snapdragon-device-registry-sync), an OpenRC service (+cron
# copy) on registry-enforced ADMIN-owned / mesh-extension nodes. It:
#   1. fetches + verifies the signed device-license-registry export,
#   2. writes the verified export to the signed-export cache
#      (/etc/snapdragon/registry/*, labelled snapdragon_authkeys_cache_t
#      by snapdragon_authkeys.fc — the shared on-disk handoff to the
#      AuthorizedKeysCommand domain),
#   3. on the FIRST verified sync, COPIES the staged device-registry.conf
#      into /etc/ssh/sshd_config.d/ and RELOADS sshd (the bootstrap gate
#      flip — mirrors selinux-enforce-gate's marker pattern).
#
# WHY a dedicated domain: today it runs as an UNCONFINED initrc domain with
# a default bin_t script — no confinement at all. A confined daemon writing
# etc_t (the sshd_config.d drop-in) + the export cache + signalling sshd_t
# needs those exact allows; granting only them keeps the daemon least-priv
# while still letting the bootstrap flip work under enforcing.
#
# v1 derived from the device-registry.conf header + the sync contract;
# INFERRED lines refined in the permissive AVC pass.
#
# NOTE (load path): authored in refpolicy style; NOT yet compiled/installed
# by any build step — see SECURITY.md §3 + the PR flaggedForFleet wiring.
################################################################
policy_module(snapdragon_device_registry_sync, 1.0.0)

require {
	type snapdragon_authkeys_cache_t;   # shared signed-export cache (the .fc above)
	type sshd_t;                        # the daemon it reloads
	type etc_t;                         # /etc/ssh/sshd_config.d/* drop-in target
}

########################################
# 1. The confined daemon domain + entrypoint, started by init/OpenRC.
########################################
type snapdragon_device_registry_sync_t;
type snapdragon_device_registry_sync_exec_t;
init_daemon_domain(snapdragon_device_registry_sync_t, snapdragon_device_registry_sync_exec_t)

########################################
# 2. Write the verified signed-export cache (CERTAIN: it produces the cache
#    that the AuthorizedKeysCommand reads). Shares the authkeys cache type.
########################################
manage_files_pattern(snapdragon_device_registry_sync_t, snapdragon_authkeys_cache_t, snapdragon_authkeys_cache_t)
manage_dirs_pattern(snapdragon_device_registry_sync_t, snapdragon_authkeys_cache_t, snapdragon_authkeys_cache_t)
manage_lnk_files_pattern(snapdragon_device_registry_sync_t, snapdragon_authkeys_cache_t, snapdragon_authkeys_cache_t)

########################################
# 3. Copy the staged device-registry.conf into /etc/ssh/sshd_config.d/ on
#    the first verified sync (CERTAIN: conf header). The target is etc_t.
########################################
files_search_etc(snapdragon_device_registry_sync_t)
allow snapdragon_device_registry_sync_t etc_t:dir { search read write add_name remove_name };
allow snapdragon_device_registry_sync_t etc_t:file { create open read write getattr setattr rename unlink };
files_read_etc_files(snapdragon_device_registry_sync_t)

########################################
# 4. Reload sshd after the gate flip (CERTAIN: conf header "reloads sshd").
########################################
ssh_signal(snapdragon_device_registry_sync_t)
init_signal_script(snapdragon_device_registry_sync_t)

########################################
# 5. Fetch the export over the mesh: DNS + TCP egress. INFERRED-WIDE port
#    set (the registry endpoint); narrow to the declared port post-AVC.
########################################
sysnet_dns_name_resolve(snapdragon_device_registry_sync_t)
auth_use_nsswitch(snapdragon_device_registry_sync_t)
allow snapdragon_device_registry_sync_t self:tcp_socket create_stream_socket_perms;
corenet_tcp_sendrecv_generic_node(snapdragon_device_registry_sync_t)
corenet_tcp_connect_all_ports(snapdragon_device_registry_sync_t)   # INFERRED-WIDE; narrow post-AVC

########################################
# 6. Run helpers (signature verify) + read own usr files; INFERRED.
########################################
files_read_usr_files(snapdragon_device_registry_sync_t)
corecmd_search_bin(snapdragon_device_registry_sync_t)
logging_send_syslog_msg(snapdragon_device_registry_sync_t)

########################################
# NO privileged_container, NO mount, NO setenforce, NO raw storage, NO
# write outside the export cache + the single sshd_config.d drop-in. The
# etc_t file allows are deliberately scoped to create/rename/unlink of the
# drop-in; if AVCs show a tighter sshd_config_t type is available on the
# target, narrow etc_t to it after the permissive pass.
################################################################
