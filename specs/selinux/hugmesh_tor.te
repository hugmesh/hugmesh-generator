################################################################
# hugmesh_tor.te
# Confined domain for the Tor onion-service reconcile agent (the node-level
# v3 hidden-service materialiser). ONE host domain:
#   hugmesh_tor_reconcile_t - /usr/sbin/hugmesh-tor-reconcile, the
#                                OpenRC-oneshot + 24h-cron agent that writes
#                                the managed /etc/tor/torrc, ensures the onion
#                                state dir (/var/lib/tor/hugmesh-onion,
#                                tor:tor 0700), restarts the DISTRO tor service
#                                so it mints/refreshes the v3 keypair, and
#                                exports the .onion hostname to
#                                /var/lib/hugmesh/tor.
#
# WHY a dedicated domain: today it would run as an UNCONFINED initrc domain with
# a default bin_t script. It needs to write /etc/tor/torrc, chown/chmod the Tor
# state dirs to tor:tor, signal/restart the tor init script, and read an optional
# /etc/hugmesh/tor/upstream override. Granting only those keeps it least-priv
# on enforcing.
#
# The DISTRO Tor DAEMON itself is NOT confined here — it is confined by the
# upstream refpolicy `tor_t` domain (sec-policy/selinux-tor, pulled by USE=selinux
# on net-vpn/tor). The onion keypair lives under /var/lib/tor (upstream
# tor_var_lib_t), so the daemon's own access is covered by the upstream module;
# this file adds ONLY the hugmesh reconcile agent that prepares its config.
#
# v1 derived from hugmesh-tor-reconcile + the hugmesh_vpn.te reconcile
# domain; INFERRED-WIDE lines are best-effort and refined in the permissive AVC
# pass.
#
# NOTE (load path): like hugmesh_vpn / localpath_provisioner / otel_collector,
# this is authored in refpolicy style and is NOT yet compiled/installed by any
# build step — see docs/selinux-module-loading.md (the fleet build-script wiring)
# and SECURITY.md §3.
################################################################
policy_module(hugmesh_tor, 1.0.0)

require {
	type tor_t;                          # upstream Tor daemon domain (sec-policy/selinux-tor)
	type tor_var_lib_t;                  # /var/lib/tor (upstream onion-key + DataDirectory)
	type tor_etc_t;                      # /etc/tor (upstream torrc location)
	type bin_t;                          # default label of /usr/sbin until .fc relabel
}

########################################
# 1. The reconcile agent domain + entrypoint (OpenRC oneshot + cron).
########################################
type hugmesh_tor_reconcile_t;
type hugmesh_tor_reconcile_exec_t;
init_daemon_domain(hugmesh_tor_reconcile_t, hugmesh_tor_reconcile_exec_t)

# Its private export dir (/var/lib/hugmesh/tor — the .onion hostname it
# publishes for cluster/admin consumption) is labelled by the .fc below.
type hugmesh_tor_etc_t;
files_type(hugmesh_tor_etc_t)
type hugmesh_tor_var_lib_t;
files_type(hugmesh_tor_var_lib_t)

########################################
# 2. Write the managed torrc + manage the Tor state dirs (chown/chmod to tor:tor).
#    CERTAIN: the agent writes /etc/tor/torrc and creates/owns
#    /var/lib/tor/{data,hugmesh-onion}.
########################################
allow hugmesh_tor_reconcile_t self:capability { chown fowner dac_override fsetid };  # INFERRED-WIDE: chown state dirs to tor:tor; narrow after QEMU AVC pass
manage_files_pattern(hugmesh_tor_reconcile_t, tor_etc_t, tor_etc_t)                   # write /etc/tor/torrc
manage_files_pattern(hugmesh_tor_reconcile_t, tor_var_lib_t, tor_var_lib_t)           # onion keypair dir (mint/persist)
manage_dirs_pattern(hugmesh_tor_reconcile_t, tor_var_lib_t, tor_var_lib_t)
read_files_pattern(hugmesh_tor_reconcile_t, tor_var_lib_t, tor_var_lib_t)             # read back the minted hostname

# Its OWN private export dir + an optional /etc/hugmesh/tor/upstream override.
manage_files_pattern(hugmesh_tor_reconcile_t, hugmesh_tor_var_lib_t, hugmesh_tor_var_lib_t)
manage_dirs_pattern(hugmesh_tor_reconcile_t, hugmesh_tor_var_lib_t, hugmesh_tor_var_lib_t)
read_files_pattern(hugmesh_tor_reconcile_t, hugmesh_tor_etc_t, hugmesh_tor_etc_t)
files_search_var_lib(hugmesh_tor_reconcile_t)

########################################
# 3. Validate the config (`tor --verify-config`) + restart the distro tor service.
#    CERTAIN: the agent runs `tor --verify-config` and `rc-service tor restart`.
########################################
init_signal_script(hugmesh_tor_reconcile_t)
init_telinit(hugmesh_tor_reconcile_t)                                                 # INFERRED-WIDE: rc-service tor restart
allow hugmesh_tor_reconcile_t tor_t:process signal;                                   # INFERRED-WIDE: restart path
corecmd_exec_bin(hugmesh_tor_reconcile_t)                                             # /usr/bin/tor --verify-config + rc-service
corecmd_exec_shell(hugmesh_tor_reconcile_t)
files_read_etc_files(hugmesh_tor_reconcile_t)
files_read_usr_files(hugmesh_tor_reconcile_t)
logging_send_syslog_msg(hugmesh_tor_reconcile_t)

########################################
# NO privileged_container, NO setenforce, NO net_admin, NO raw sockets, NO write
# outside /etc/tor + /var/lib/tor + its own /var/lib/hugmesh/tor export dir.
# The chown of the Tor state dirs to tor:tor is the only privileged operation;
# everything tagged INFERRED-WIDE is to be narrowed against real AVCs once the
# devel Makefile + the QEMU enforcing pass exist on the fleet build host. The Tor
# DAEMON's own confinement is the upstream tor_t module (USE=selinux on net-vpn/tor).
################################################################
