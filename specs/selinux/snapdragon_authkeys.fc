# snapdragon_authkeys.fc
# Label the device-registry AuthorizedKeysCommand binary as the entrypoint
# of snapdragon_authkeys_t, and the signed-export cache it reads as
# snapdragon_authkeys_cache_t (sshd_t->snapdragon_authkeys_t domtrans + the
# nobody-domain read in the .te then apply). provision_selinux()'s
# first-boot relabel (setfiles / restorecon -RF /) applies these.
#
# The binary is copied to /usr/sbin by the (protected) build script; the
# signed export + baked public key + node.env live under
# /etc/snapdragon/registry (staged by provision_device_registry + written
# by the sync agent).

/usr/sbin/snapdragon-authorized-keys-lookup    --    gen_context(system_u:object_r:snapdragon_authkeys_exec_t,s0)

/etc/snapdragon/registry(/.*)?                       gen_context(system_u:object_r:snapdragon_authkeys_cache_t,s0)
