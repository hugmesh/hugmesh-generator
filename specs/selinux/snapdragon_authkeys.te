################################################################
# snapdragon_authkeys.te
# Confined domain for the device-license-registry AuthorizedKeysCommand
# (/usr/sbin/snapdragon-authorized-keys-lookup). sshd_t execs this binary
# as AuthorizedKeysCommandUser nobody on registry-enforced ADMIN-owned /
# mesh-extension nodes (specs/etc/ssh/sshd_config.d/device-registry.conf,
# `AuthorizedKeysFile none` => the command is the SOLE key source). The
# command verifies the baked-signed device-registry export and re-emits
# the offered key ONLY iff an active license pins it onto this node;
# empty-on-error = fail-closed deny.
#
# WHY a dedicated domain: under enforcing, sshd_t exec'ing an arbitrary
# bin_t command + the nobody-domain reading the signed-export cache is NOT
# allowed by base refpolicy and AVC-denies, which silently breaks the
# fail-closed registry (every login denied, including licensed ones). This
# module gives the command its own entrypoint type, a domtrans from sshd_t,
# and a tightly-scoped read of the world-readable export cache + node.env.
#
# v1 derived from device-registry.conf + the lookup contract; INFERRED
# lines are best-effort and refined in the permissive AVC pass.
#
# NOTE (load path): like localpath_provisioner/otel_collector, this module
# is authored in refpolicy style and is NOT yet compiled/installed by any
# build step — see SECURITY.md §3 and the PR's flaggedForFleet wiring.
################################################################
policy_module(snapdragon_authkeys, 1.0.0)

require {
	type sshd_t;                 # the calling sshd daemon
	type bin_t;                  # default label of /usr/sbin until .fc relabel
}

########################################
# 1. The confined command domain + its entrypoint
########################################
# A standard application domain (NOT a container domain — this is a host
# process, unlike the pod modules). application_domain wires the exec type
# as an entrypoint and gives the base self/process rules.
type snapdragon_authkeys_t;
type snapdragon_authkeys_exec_t;
application_domain(snapdragon_authkeys_t, snapdragon_authkeys_exec_t)

# The signed-export cache + baked public key + node.env that the command
# reads. Labelled by the .fc so the nobody-running command can read them.
type snapdragon_authkeys_cache_t;
files_type(snapdragon_authkeys_cache_t)

########################################
# 2. sshd_t enters this domain on AuthorizedKeysCommand exec
########################################
# Make sshd_t transition INTO snapdragon_authkeys_t when it execs the
# labelled binary, instead of running it in sshd_t (base refpolicy denies
# sshd_t executing an arbitrary command).
domtrans_pattern(sshd_t, snapdragon_authkeys_exec_t, snapdragon_authkeys_t)
# sshd reads the key line written to stdout (inherited pipe) — base.
allow snapdragon_authkeys_t sshd_t:fd use;
allow snapdragon_authkeys_t sshd_t:fifo_file { read write getattr };
allow snapdragon_authkeys_t sshd_t:process sigchld;

########################################
# 3. Read the signed-export cache (CERTAIN: device-registry.conf states the
#    command reads ONLY world-readable inputs — the signed export cache, the
#    baked public key, node.env). No private material.
########################################
read_files_pattern(snapdragon_authkeys_t, snapdragon_authkeys_cache_t, snapdragon_authkeys_cache_t)
read_lnk_files_pattern(snapdragon_authkeys_t, snapdragon_authkeys_cache_t, snapdragon_authkeys_cache_t)
list_dirs_pattern(snapdragon_authkeys_t, snapdragon_authkeys_cache_t, snapdragon_authkeys_cache_t)

# Read /etc for node.env-style config + nsswitch (runs as nobody => NSS).
files_read_etc_files(snapdragon_authkeys_t)
auth_use_nsswitch(snapdragon_authkeys_t)

########################################
# 4. Signature verification needs to read its own libs/usr files; INFERRED.
########################################
files_read_usr_files(snapdragon_authkeys_t)
corecmd_search_bin(snapdragon_authkeys_t)

########################################
# NO Linux capabilities, NO network, NO write anywhere, NO setenforce. The
# command is a pure read+verify+echo; anything beyond this surfaces in the
# AVC pass and is added narrowly. dac_read_search for the cache (if it is
# not world-readable in practice) is DELIBERATELY omitted pending the AVC
# pass — the conf asserts world-readable inputs.
################################################################
