#!/bin/bash
# hugmesh-vpn-reconcile — the fetch / verify / write-Secret / flip-active /
# restart / leak-check / report agent for the egress-VPN signed per-node export.
# Runs on a node that has the egress-VPN service enabled:
#   * once at boot via the hugmesh-vpn-reconcile OpenRC service, and
#   * on a 60s cron (the convergence floor; the BFF drives fast propagation, this
#     pull guarantees eventual consistency).
#
# It CLONES /usr/sbin/hugmesh-device-registry-sync (the Layer-B sync agent) and
# shares its fail-closed posture + the SAME baked registry-pub.ed25519 verifying
# key, via the parallel /usr/lib/hugmesh/vpn-verify.sh (which mirrors
# registry-verify.sh — only the canonical reconstruction differs).
#
# FLOW (every step FAIL-CLOSED — on ANY fetch/verify/rollback failure KEEP the
# last-good cache + leave the running service AS-IS; never tear a working tunnel
# down on a transient BFF/verify failure):
#   1. fetch GET <BFF>/bff/admin/egress-vpn/export?node=<MACHINE_KEY_FP> over the
#      in-cluster mTLS SUPERADMIN identity (the same transport node.env Layer-B
#      uses). The PER-NODE export returns ONLY the configs assigned onto THIS node.
#      A missing cert / unreachable BFF => keep cache, exit 0 (offline tolerance).
#   2. verify: signed==true, detached Ed25519 over the EXACT canonical bytes
#      against the BAKED public key, AND STRICT-monotonic generation.
#   3. node guard: body.node must equal the baked MACHINE_KEY_FP.
#   4. resolve the config: each entry names a K8s Secret (secretRef) that ESO
#      materialises; read its .conf/.ovpn bytes from the mounted Secret dir and
#      write them 0600 into /etc/hugmesh/vpn/<name>.conf. (The bytes are the
#      SECRET — they ride the Secret, never the export. With no mounted Secret dir
#      the node falls back to the key-USB-provisioned config already in place.)
#   5. atomically flip /etc/hugmesh/vpn/active.conf to the first entry's config
#      (WireGuard .conf wins), bump last-good-generation, then
#      `rc-service hugmesh-egress-vpn restart`.
#   6. mark the assigned service pods 0x76 (delegated to the split-tunnel runner /
#      a CNI hook — recorded here as the desired service set for the runner).
#   7. leak-check: `hugmesh-vpn-runner check` (egress IP != node WAN IP). On a
#      leak, report 'failed' (the kill-switch already fails closed; we just flag).
#   8. report the propagation state back (best-effort) so the UI can show it.
#
# An EMPTY export (no entries — the node was un-assigned) tears the egress DOWN
# (back to direct) and clears active.conf: the node should NOT egress via a VPN it
# is no longer assigned.

set -uo pipefail

NODE_ENV="/etc/hugmesh/registry/node.env"
PUB_KEY="/etc/hugmesh/registry/registry-pub.ed25519"
CACHE_DIR="/var/lib/hugmesh/egress-vpn"
EXPORT_JSON="${CACHE_DIR}/export.json"
LAST_GOOD="${CACHE_DIR}/last-good-generation"
STATE_FILE="${CACHE_DIR}/state"                 # last reported propagation state
VPN_ETC="/etc/hugmesh/vpn"
ACTIVE="${VPN_ETC}/active.conf"
SECRET_DIR="${VPN_SECRET_DIR:-/etc/hugmesh/vpn-secret}"   # ESO-mounted Secret (optional)
VERIFY_LIB="/usr/lib/hugmesh/vpn-verify.sh"
RUNNER="/usr/sbin/hugmesh-vpn-runner"
MARKER="/usr/sbin/hugmesh-vpn-mark"
LOG_TAG="hugmesh-vpn-reconcile"

log()  { echo "[${LOG_TAG} $(date -u '+%Y-%m-%dT%H:%M:%SZ')] $*"; command -v logger >/dev/null 2>&1 && logger -t "${LOG_TAG}" -- "$*" 2>/dev/null || true; }
warn() { log "WARNING: $*"; }
have() { command -v "$1" >/dev/null 2>&1; }

read_env() {
    local k="$1" line
    line="$(grep -E "^${k}=" "${NODE_ENV}" 2>/dev/null | head -1)" || return 1
    [ -n "${line}" ] || return 1
    printf '%s' "${line#*=}" | tr -d '"'"'"' '
}

# Report the propagation state (best-effort; never fatal). Records locally for the
# next sync + the OpenRC status; a future PR can PUT it back to the BFF.
report_state() {
    local st="$1"
    mkdir -p "${CACHE_DIR}" 2>/dev/null || true
    printf '%s\n' "${st}" > "${STATE_FILE}" 2>/dev/null || true
    log "propagation_state=${st}"
}

# ── Pre-flight (every miss => keep cache, exit 0) ──────────────────────────────
[ -r "${VERIFY_LIB}" ] || { warn "verify lib missing (${VERIFY_LIB}) — keeping cache"; exit 0; }
[ -r "${NODE_ENV}" ]   || { warn "node.env missing — not a mesh node? keeping cache"; exit 0; }
[ -r "${PUB_KEY}" ]    || { warn "baked public key missing (${PUB_KEY}) — keeping cache (fail-closed)"; exit 0; }
# shellcheck source=/dev/null
. "${VERIFY_LIB}" 2>/dev/null || { warn "failed to source verify lib — keeping cache"; exit 0; }
have jq      || { warn "jq absent — keeping cache"; exit 0; }
have openssl || { warn "openssl absent — keeping cache"; exit 0; }
have curl    || { warn "curl absent — keeping cache"; exit 0; }

mkdir -p "${CACHE_DIR}" "${VPN_ETC}" 2>/dev/null || true
chmod 0700 "${VPN_ETC}" 2>/dev/null || true

FP="$(read_env MACHINE_KEY_FP)" || { warn "node.env missing MACHINE_KEY_FP — keeping cache"; exit 0; }
[ -n "${FP}" ]                  || { warn "empty MACHINE_KEY_FP — keeping cache"; exit 0; }

BFF_URL="$(read_env BFF_EXPORT_URL)"
BFF_CERT="$(read_env BFF_CLIENT_CERT)"
BFF_KEY="$(read_env BFF_CLIENT_KEY)"
BFF_CA="$(read_env BFF_CA)"
# Derive the egress-vpn export URL from the device-registry export base (same host;
# the device-registry URL ends .../device-licenses/export). Fall back to the BFF
# origin + the egress-vpn path.
EGRESS_URL=""
if [ -n "${BFF_URL}" ]; then
    case "${BFF_URL}" in
        */device-licenses/export*) EGRESS_URL="${BFF_URL/device-licenses\/export/egress-vpn/export}" ;;
        */bff/admin/*)             EGRESS_URL="${BFF_URL%%/bff/admin/*}/bff/admin/egress-vpn/export" ;;
        *)                         EGRESS_URL="${BFF_URL%/}/bff/admin/egress-vpn/export" ;;
    esac
fi
if [ -z "${EGRESS_URL}" ] || [ -z "${BFF_CERT}" ] || [ ! -r "${BFF_CERT}" ]; then
    warn "no reachable BFF export transport (URL/cert) — bootstrap/offline, keeping cache + service as-is"
    exit 0
fi

# ── 1. fetch the per-node export over in-cluster mTLS ──────────────────────────
TMP="$(mktemp 2>/dev/null)" || { warn "mktemp failed — keeping cache"; exit 0; }
trap 'rm -f "${TMP}" 2>/dev/null' EXIT
CURL_ARGS=(--silent --show-error --fail --max-time 15
           --cert "${BFF_CERT}" --key "${BFF_KEY}")
[ -n "${BFF_CA}" ] && [ -r "${BFF_CA}" ] && CURL_ARGS+=(--cacert "${BFF_CA}")
if ! curl "${CURL_ARGS[@]}" "${EGRESS_URL}?node=${FP}" -o "${TMP}" 2>/dev/null; then
    warn "fetch failed (${EGRESS_URL}?node=...) — keeping cache + service as-is"
    exit 0
fi

# ── 2. verify: signed + Ed25519 + STRICT-monotonic generation ──────────────────
if ! vpn_verify_export "${TMP}" "${PUB_KEY}" "${LAST_GOOD}"; then
    warn "export verify/rollback failed — REJECTING (keeping last-good cache + service as-is)"
    exit 0
fi

# ── 3. node guard: body.node must equal our baked fp ───────────────────────────
BODY_NODE="$(vpn_node "${TMP}")"
if [ "${BODY_NODE}" != "${FP}" ]; then
    warn "export node '${BODY_NODE}' != our fp '${FP}' (foreign export) — REJECTING"
    exit 0
fi
GEN="$(vpn_gen "${TMP}")"

# ── empty export => un-assigned => tear the egress DOWN (back to direct) ───────
ENTRY_COUNT="$(jq -r '.body.entries | length' "${TMP}" 2>/dev/null || echo 0)"
if [ "${ENTRY_COUNT}" = "0" ]; then
    log "export carries NO entries (node un-assigned) — tearing egress VPN down (back to direct)"
    # Unmark/unlabel FIRST. If the marker cannot cleanly clear (labels stuck),
    # do NOT tear the tunnel down and do NOT accept the export: a loosened-but-
    # untunnelled pod would egress via the node WAN. Keeping last-good un-bumped
    # makes the 60s cron retry this teardown until it succeeds.
    if [ -x "${MARKER}" ] && ! "${MARKER}" clear; then
        warn "vpn-mark clear failed — KEEPING tunnel + marks (fail-closed); teardown retries next cycle"
        report_state "failed"
        exit 0
    fi
    : > "${CACHE_DIR}/marked-services" 2>/dev/null || true
    [ -x "${RUNNER}" ] && "${RUNNER}" down 2>/dev/null || true
    rm -f "${ACTIVE}" 2>/dev/null || true
    rc-service hugmesh-egress-vpn stop 2>/dev/null || true
    cp -f "${TMP}" "${EXPORT_JSON}" 2>/dev/null || true
    printf '%s' "${GEN}" > "${LAST_GOOD}" 2>/dev/null || true
    report_state "applied"
    exit 0
fi

# ── 4. resolve config bytes from the mounted ESO Secret (or fall back to the
#       key-USB-provisioned config already in /etc/hugmesh/vpn) ──────────────
FIRST_NAME=""
FIRST_KIND=""
N="${ENTRY_COUNT}"
for ((i = 0; i < N; i++)); do
    name="$(jq -r ".body.entries[$i].configName // empty" "${TMP}" 2>/dev/null)"
    kind="$(jq -r ".body.entries[$i].kind // empty" "${TMP}" 2>/dev/null)"
    secret="$(jq -r ".body.entries[$i].secretRef // empty" "${TMP}" 2>/dev/null)"
    [ -n "${name}" ] || continue
    ext="conf"; [ "${kind}" = "openvpn" ] && ext="ovpn"
    dst="${VPN_ETC}/${name}.${ext}"
    # The bytes live in the mounted Secret (ESO): ${SECRET_DIR}/<secretRef>. With
    # no mounted Secret, keep whatever provision_vpn() already installed (key-USB).
    if [ -n "${secret}" ] && [ -r "${SECRET_DIR}/${secret}" ]; then
        install -m 0600 /dev/null "${dst}"
        cat "${SECRET_DIR}/${secret}" > "${dst}" 2>/dev/null && chmod 0600 "${dst}" \
            && log "wrote ${dst} from Secret ${secret} (0600)" \
            || warn "failed to write ${dst} from Secret ${secret}"
    elif [ -r "${dst}" ]; then
        log "Secret for ${name} not mounted — using key-USB-provisioned ${dst}"
    else
        warn "no Secret + no key-USB config for ${name} — entry skipped"
        continue
    fi
    [ -z "${FIRST_NAME}" ] && { FIRST_NAME="${name}.${ext}"; FIRST_KIND="${kind}"; }
done

if [ -z "${FIRST_NAME}" ] || [ ! -r "${VPN_ETC}/${FIRST_NAME}" ]; then
    warn "no usable config materialised — keeping service as-is (fail-closed)"
    report_state "failed"
    exit 0
fi

# ── 5. flip active.conf + accept cache + restart the service ───────────────────
ln -sfn "${VPN_ETC}/${FIRST_NAME}" "${ACTIVE}"
cp -f "${TMP}" "${EXPORT_JSON}" 2>/dev/null || true
printf '%s' "${GEN}" > "${LAST_GOOD}" 2>/dev/null || true
log "accepted export gen=${GEN}: active.conf -> ${FIRST_NAME} (${FIRST_KIND}); ${ENTRY_COUNT} entry(ies)"

rc-update add hugmesh-egress-vpn default 2>/dev/null || true
if rc-service hugmesh-egress-vpn restart 2>/dev/null; then
    log "restarted hugmesh-egress-vpn"
else
    warn "rc-service hugmesh-egress-vpn restart failed"
    report_state "degraded"
    exit 0
fi

# ── 6. mark the assigned service pods 0x76 (tunnel is up from step 5) ──────────
# Record the desired marked-service set from the VERIFIED export, then hand it
# to hugmesh-vpn-mark, which resolves the slugs to running pod IPs, installs
# the fwmark nft rules, and sets the hugmesh.net/vpn-egress labels in
# the SAME pass (marks BEFORE labels — no loosened-but-uncaptured pod). On a
# marker failure NOTHING is half-applied (the marker rolls back to the cleared
# state), so report 'failed' and keep the tunnel as-is for the next cycle.
jq -r '[.body.entries[].serviceSlugs[]?] | unique | join(",")' "${TMP}" 2>/dev/null \
    > "${CACHE_DIR}/marked-services" || true
if [ -x "${MARKER}" ]; then
    if ! "${MARKER}" apply; then
        warn "vpn-mark apply failed — no pods marked/labelled (fail-closed: public egress stays locked/proxied)"
        report_state "failed"
        exit 0
    fi
fi

# ── 7. leak-check: egress IP must differ from the node WAN IP ──────────────────
if [ -x "${RUNNER}" ]; then
    if "${RUNNER}" check 2>/dev/null; then
        report_state "applied"
    else
        # The kill-switch already fails closed; flag the leak/outage for the UI.
        warn "leak-check failed (egress==WAN or tunnel down) — kill-switch fails closed; flagging"
        report_state "failed"
    fi
else
    report_state "applied"
fi
exit 0
