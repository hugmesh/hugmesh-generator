#!/bin/bash
# hugmesh-go-live-reconcile — the WEB-UI go-live effector (item 6, 4-interface
# parity for the go-live wizard). admin-bff-api's GoLiveController/GoLiveService
# (PR #200) let a superadmin RECORD a go-live/rollback intent through the web
# console, but admin-bff runs inside a Kubernetes pod and cannot itself write
# /etc/hugmesh/go-live on the physical/VM host node. The CLI (hugmesh-go-live),
# ncurses (hugmesh-go-live-menu) and Studio wizard all effect posture directly
# because they run ON the host; the web UI structurally cannot. This agent is the
# missing fourth leg: it fetches the SIGNED go-live-intent export, verifies it,
# and — for ITS OWN node's cluster domain only — drives the SAME canonical
# `hugmesh-go-live commit`/`rollback` subcommands a human operator would run.
# It NEVER reimplements posture-flipping logic itself (mirrors domain-reconcile's
# "drives the EXISTING generators" idiom): the driver script remains the ONE place
# that knows how to write the marker / persist release-state.
#
# WHAT IT DELIBERATELY DOES NOT DO: run `hugmesh-go-live plan` (provider
# artifact emission — DNS record CSVs, tunnel-token drops, deep-links). That is
# the web WIZARD's own job (client-side guidance BEFORE the superadmin records a
# "public" intent) or the human operator's job via the CLI/ncurses/Studio
# front-ends. By the time an intent reaches `recorded`, any manual out-of-band
# provider setup (registering DNS, obtaining a tunnel token) is assumed already
# done — this agent's sole, narrow, load-bearing job is tripping the ONE switch
# none of the other three interfaces can reach for a web-originated intent: the
# host-local marker file. Narrower scope = smaller blast radius for an
# unattended, cron-driven writer of security-sensitive host state.
#
# Runs on every fleet node (same gate as domain-reconcile/device-registry-sync —
# `if ! UNAFFILIATED` in the stage4 builders): a boot oneshot + a 60s cron floor,
# fetch over the in-cluster mTLS SUPERADMIN identity (node.env's BFF_EXPORT_URL/
# BFF_CLIENT_CERT/BFF_CLIENT_KEY/BFF_CA — the SAME core-provisioned transport
# domain-reconcile and device-registry-sync already use), the SHARED Ed25519
# verify + strict-monotonic rollback guard (golive-verify.sh -> registry-verify.sh
# + the baked registry-pub.ed25519), and FAIL-CLOSED-keep-last-good on ANY error.
#
# SINGLE-TENANT PER NODE: unlike the domain-registry export (cross-domain, a node
# may act on several entries), a node's go-live marker is for its OWN cluster
# domain only (/etc/hugmesh/cluster-domain — the same file the driver reads).
# The export may carry entries for OTHER domains in a multi-brand deployment;
# this agent filters to the single entry (if any) matching its own domain and
# ignores the rest.
#
# ABSENCE CONTRACT (GoLiveExportModels.java doc, mirrored here): the export
# carries only currently-RECORDED intents — a WITHDRAWN or already-APPLIED
# intent is OMITTED. Absence of an entry for this node's domain means "nothing
# NEW to apply", NOT "roll back". Only an EXPLICIT targetState=internal entry
# triggers rollback.
#
# IDEMPOTENT: before calling commit/rollback, checks the marker's OWN recorded
# provider= line (written by cmd_commit) against the desired state, so a
# recorded-but-unchanged intent does not re-trip the driver (and re-log/re-touch
# the marker's written_at) every single 60s cron cycle — only a REAL state
# transition invokes the driver.
#
# WRITEBACK (WIRED): admin-bff-api now exposes POST <ACK>/bff/internal/go-live/
# <intentId>/applied-ack {generation, appliedBy} over the SAME in-cluster mTLS
# channel /export uses (permitAll()+mTLS on /bff/internal/**, same idiom as
# ImageBuildIngestController). ack_intent() is called from apply_entry() right
# after a commit/rollback it drove actually succeeds — never on a no-op
# (already-converged) cycle, since that branch returns before ever reaching the
# driver invocation. It is BEST-EFFORT: any curl failure (timeout, non-2xx) is
# logged and swallowed — the posture change already happened; only the BFF
# row's applied_at/applied_by write-back is at risk, and the endpoint is CAS-
# idempotent server-side, so a retried/duplicate ack is harmless. GOLIVE_ACK_URL
# has NO separate default of its own: unless explicitly overridden (tests), it
# resolves to the SAME base URL as the /export fetch (BFF_URL, i.e. node.env's
# BFF_EXPORT_URL) — operators never configure a second URL by hand, mirroring
# hugmesh-node-storage-reconcile's ack_generation(), which reuses BFF_URL
# directly rather than inventing its own ack-target variable.
#
# ── ENV SEAMS (for the offline logic test; mirrors the DR_*/GL_* idiom) ──────────
#   GLR_NODE_ENV        node.env path (def /etc/hugmesh/registry/node.env)
#   GLR_PUB_KEY         baked registry Ed25519 pubkey (def /etc/hugmesh/registry/registry-pub.ed25519)
#   GLR_CACHE_DIR       cache dir (def /var/lib/hugmesh/go-live-reconcile)
#   GLR_VERIFY_LIB      golive-verify.sh path (def /usr/lib/hugmesh/golive-verify.sh)
#   GLR_DRIVER          hugmesh-go-live driver path (def /usr/sbin/hugmesh-go-live)
#   GL_ETC_HUGMESH   passed straight through to the driver AND used for this
#                       agent's own marker/cluster-domain reads, so a test sandbox
#                       and the driver subprocess always agree on the same root.
#   GOLIVE_ACK_URL      applied-ack POST target override (def empty -> falls back
#                       to BFF_URL/node.env's BFF_EXPORT_URL at call time; see
#                       WRITEBACK above). Only needed when the ack endpoint is
#                       ever served from a DIFFERENT base than /export (tests).

set -uo pipefail

NODE_ENV="${GLR_NODE_ENV:-/etc/hugmesh/registry/node.env}"
PUB_KEY="${GLR_PUB_KEY:-/etc/hugmesh/registry/registry-pub.ed25519}"
CACHE_DIR="${GLR_CACHE_DIR:-/var/lib/hugmesh/go-live-reconcile}"
EXPORT_JSON="${CACHE_DIR}/export.json"
LAST_GOOD="${CACHE_DIR}/last-good-generation"
STATE_FILE="${CACHE_DIR}/state"
VERIFY_LIB="${GLR_VERIFY_LIB:-/usr/lib/hugmesh/golive-verify.sh}"
DRIVER="${GLR_DRIVER:-/usr/sbin/hugmesh-go-live}"
ETC="${GL_ETC_HUGMESH:-/etc/hugmesh}"
CLUSTER_DOMAIN_FILE="${ETC}/cluster-domain"
GO_LIVE_MARKER="${ETC}/go-live"
# WRITEBACK target override — empty by default. ack_intent() falls back to
# BFF_URL (the SAME base the /export fetch uses) at call time when this is
# unset, so operators do not configure a second URL; set this only to point
# the ack POST at a base DIFFERENT from /export (tests).
GOLIVE_ACK_URL="${GOLIVE_ACK_URL:-}"
LOG_TAG="hugmesh-go-live-reconcile"

log()  { echo "[${LOG_TAG} $(date -u '+%Y-%m-%dT%H:%M:%SZ')] $*"; command -v logger >/dev/null 2>&1 && logger -t "${LOG_TAG}" -- "$*" 2>/dev/null || true; }
warn() { log "WARNING: $*"; }
have() { command -v "$1" >/dev/null 2>&1; }

read_env() {
    local k="$1" line
    line="$(grep -E "^${k}=" "${NODE_ENV}" 2>/dev/null | head -1)" || return 1
    [ -n "${line}" ] || return 1
    printf '%s' "${line#*=}" | tr -d '"'"'"' '
}

read_file() { [ -r "$1" ] && tr -d '[:space:]' < "$1" 2>/dev/null || true; }

report_state() {
    local st="$1"
    mkdir -p "${CACHE_DIR}" 2>/dev/null || true
    printf '%s\n' "${st}" > "${STATE_FILE}" 2>/dev/null || true
    log "reconcile_state=${st}"
}

# ── fetch the signed go-live-intent export over in-cluster mTLS ─────────────────
# GET <BFF>/bff/admin/go-live/export?node=<MACHINE_KEY_FP>. ?node= is
# PROVENANCE-only; the body may carry entries for OTHER domains too (cross-domain
# export, filtered per-node below). Missing URL/cert => keep cache (bootstrap/offline).
fetch_export() {
    local out="$1"
    [ -n "${BFF_URL}" ] || { warn "BFF_EXPORT_URL unset — bootstrap/offline, keeping cache"; return 1; }
    have curl || { warn "curl absent — keeping cache"; return 1; }
    local url="${BFF_URL%/}/bff/admin/go-live/export?node=${MACHINE_KEY_FP}"
    local args=(-sS -m 15 --fail -o "${out}")
    [ -f "${MTLS_CA}" ] && args+=(--cacert "${MTLS_CA}")
    if [ -n "${MTLS_CERT}" ] && [ -n "${MTLS_KEY}" ] && [ -f "${MTLS_CERT}" ] && [ -f "${MTLS_KEY}" ]; then
        args+=(--cert "${MTLS_CERT}" --key "${MTLS_KEY}")
    else
        warn "mTLS client cert/key absent — /export rejected (SUPERADMIN|mTLS); keeping cache"; return 1
    fi
    if curl "${args[@]}" "${url}" 2>/dev/null; then
        [ -s "${out}" ] && return 0
        warn "empty export body — keeping cache"; return 1
    fi
    warn "fetch failed (${url}) — keeping cache"; return 1
}

commit_cache() {
    local newjson="$1" newgen="$2"
    local tmp="${EXPORT_JSON}.tmp.$$"
    cp -f "${newjson}" "${tmp}" 2>/dev/null || { warn "cache stage failed"; return 1; }
    have sync && sync 2>/dev/null || true
    mv -f "${tmp}" "${EXPORT_JSON}" 2>/dev/null || { warn "cache rename failed"; rm -f "${tmp}"; return 1; }
    local lgt="${LAST_GOOD}.tmp.$$"
    printf '%s\n' "${newgen}" > "${lgt}" 2>/dev/null && mv -f "${lgt}" "${LAST_GOOD}" 2>/dev/null || rm -f "${lgt}"
    log "accepted go-live export gen=${newgen}"
    return 0
}

# ── current_marker_provider -> stdout (empty if marker absent/unparseable) ──────
current_marker_provider() {
    [ -e "${GO_LIVE_MARKER}" ] || return 0
    grep -E '^provider=' "${GO_LIVE_MARKER}" 2>/dev/null | head -1 | cut -d= -f2-
}

# ── currently_public -> rc (0 iff EFFECTIVE posture is public) ─────────────────
# Mirrors the driver's own effective_posture(): public iff the marker exists OR
# release-state=public. A rollback intent is NOT converged just because the
# marker happens to be absent — release-state alone can still hold the host
# public (e.g. a prior --persist-public with the marker later deleted out of
# band). Checking marker-only here would silently strand release-state=public
# forever against an explicit rollback intent.
currently_public() {
    [ -e "${GO_LIVE_MARKER}" ] && return 0
    [ "$(read_file "${ETC}/release-state")" = "public" ]
}

# ── map_bff_provider <bff-key> -> stdout (shell provider id, or empty if unknown) ─
# admin-bff-api's GoLiveProviderCatalog (Java) and the shell provider registry
# (specs/usr/lib/hugmesh/go-live-providers.sh GO_LIVE_PROVIDER_IDS) grew
# independently the same day (2026-07-08, two parallel PRs) with a DRIFTED
# vocabulary. That drift is now RECONCILED BY IDENTITY: the Java catalog's
# `generic-registrar` row was RENAMED to `byo-domain` to match the shell
# registry, so the two catalogs now share the same key for that provider and
# this shim's `byo-domain) echo byo-domain` case is a straight IDENTITY map —
# the norm going forward.
#
# `generic-registrar) echo byo-domain` is RETAINED as a LEGACY ALIAS, NOT dead
# code: it still resolves (a) pre-rename node images that already emitted the
# old key, (b) any signed export cached before the BFF rename shipped, and
# (c) any go_live_intent DB row persisted with the old provider string (the
# BFF renamed the catalog key but did NOT re-key existing rows — deliberately,
# see that PR — so the old value still arrives verbatim in the export and MUST
# still map). Do NOT delete this case: dropping it would strand exactly those
# pre-rename artifacts (the "fleet skew" the rollout order is designed around).
#
# The BFF's `cloudflare-ddns` is a SEPARATE case and is NOT part of the rename:
# it is what the shell models as `duckdns --ddns-service cloudflare` (a
# driver-level sub-option, not a separate provider id — see go-live-providers.sh's
# glp_emit_duckdns / GL_DDNS_SERVICE). Its collapse to `duckdns` here is a
# DELIBERATE driver-suboption mapping, not catalog drift, and stays as-is.
#
# Safe to collapse cloudflare-ddns -> duckdns for THIS purpose specifically
# because `cmd_commit()` (specs/usr/sbin/hugmesh-go-live) only ever checks
# `glp_known "${provider}"` and stamps `provider=` into the marker — it never
# reads GL_DDNS_SERVICE (that only affects `plan`'s artifact emission, which
# this agent deliberately never runs, see the file header). A future change to
# cmd_commit that starts caring about the DDNS sub-service would invalidate
# this assumption — this comment is the tripwire to catch that.
map_bff_provider() {
    case "$1" in
    cloudflare-tunnel)  echo cloudflare-tunnel ;;
    byo-domain)         echo byo-domain ;;         # identity (post-rename norm)
    generic-registrar)  echo byo-domain ;;         # LEGACY ALIAS (pre-rename images/exports/rows)
    duckdns)            echo duckdns ;;
    cloudflare-ddns)    echo duckdns ;;             # deliberate driver-suboption (NOT the rename)
    tailscale-funnel)   echo tailscale-funnel ;;
    router-portforward) echo router-portforward ;;
    *)                  return 1 ;;
    esac
}

# ── apply_entry <entry-json> -> rc ───────────────────────────────────────────────
# Drive the canonical driver's commit/rollback for this node's OWN domain entry.
# IDEMPOTENT: only invokes the driver on an actual state transition.
#
# intent_id/gen are extracted here (same per-entry jq parse as dom/state/
# provider) and threaded straight into ack_intent() as args — NOT re-fetched or
# re-parsed inside ack_intent() itself. "gen" is THIS ROW's own generation
# field (entry.generation, the per-entry stamp golive_canonical_bytes signs as
# its trailing gen= column) — it is deliberately NOT the export envelope's
# top-level body.generation (a separate max-over-all-rows value gv_entry_for_domain
# never even exposes here); acking the wrong one would let the BFF's CAS guard
# match against a generation this row never actually carried.
apply_entry() {
    local entry="$1" state provider bff_provider dom intent_id gen
    state="$(printf '%s' "${entry}" | jq -r '.targetState // empty' 2>/dev/null)"
    bff_provider="$(printf '%s' "${entry}" | jq -r '.provider // empty' 2>/dev/null)"
    dom="$(printf '%s' "${entry}" | jq -r '.clusterDomain // empty' 2>/dev/null)"
    intent_id="$(printf '%s' "${entry}" | jq -r '.intentId // empty' 2>/dev/null)"
    gen="$(printf '%s' "${entry}" | jq -r '.generation // empty' 2>/dev/null)"
    [ -n "${state}" ] && [ -n "${dom}" ] || { warn "malformed entry (missing targetState/clusterDomain) — skipping"; return 1; }
    [ -r "${DRIVER}" ] || { warn "driver not baked at ${DRIVER} — cannot apply (recorded, keeping for next cycle)"; return 1; }

    case "${state}" in
    public)
        [ -n "${bff_provider}" ] || { warn "targetState=public entry for ${dom} has no provider — skipping (BFF should have rejected this at record time)"; return 1; }
        provider="$(map_bff_provider "${bff_provider}")" \
            || { warn "targetState=public entry for ${dom} has provider '${bff_provider}', unrecognized by map_bff_provider() — skipping (catalog drift? see the platform TODO queue)"; return 1; }
        if [ "$(current_marker_provider)" = "${provider}" ]; then
            report_state "converged-public"
            # (writeback) still ack even though no drive was needed this cycle —
            # a freshly-recorded intent whose target already matches the
            # currently-converged posture (re-affirmation, UI double-submit, or
            # re-recording after a withdraw) must not be suppressed from ever
            # being acked just because the driver call itself was a no-op.
            ack_intent "${intent_id}" "${gen}"
            return 0
        fi
        log "applying: domain=${dom} target=public provider=${provider} (driving driver commit)"
        # --domain is passed as an EXPLICIT CLI flag, not just the GL_DOMAIN_OVERRIDE
        # env var: the driver's own arg-parser unconditionally resets
        # GL_DOMAIN_OVERRIDE="" at the top of main() before reading flags (verified
        # against specs/usr/sbin/hugmesh-go-live) — an env-var-only override is
        # silently discarded. GL_ETC_HUGMESH is passed too (belt-and-suspenders;
        # it also sandboxes cluster-domain reads to agree with this agent's own).
        if GL_ASSUME_YES=1 GL_ETC_HUGMESH="${ETC}" \
            bash "${DRIVER}" commit --provider "${provider}" --domain "${dom}" --persist-public -y >>"${CACHE_DIR}/driver.log" 2>&1
        then
            log "applied: go-live tripped for ${dom} via ${provider}"
            report_state "applied-public"
            # (writeback) best-effort ack — the posture change above already
            # succeeded regardless of whether this POST lands.
            ack_intent "${intent_id}" "${gen}"
        else
            warn "driver commit FAILED for ${dom}/${provider} (see ${CACHE_DIR}/driver.log) — recorded intent stays pending, retried next cycle"
            report_state "apply-failed"
            return 1
        fi
        ;;
    internal)
        if ! currently_public; then
            report_state "converged-internal"
            # (writeback) same reasoning as the converged-public branch above.
            ack_intent "${intent_id}" "${gen}"
            return 0
        fi
        log "applying: domain=${dom} target=internal (driving driver rollback)"
        if GL_ASSUME_YES=1 GL_ETC_HUGMESH="${ETC}" \
            bash "${DRIVER}" rollback --domain "${dom}" --revert-release-state -y >>"${CACHE_DIR}/driver.log" 2>&1
        then
            log "applied: rolled back ${dom} to internal"
            report_state "applied-internal"
            # (writeback) best-effort ack — same idiom as the commit branch above.
            ack_intent "${intent_id}" "${gen}"
        else
            warn "driver rollback FAILED for ${dom} (see ${CACHE_DIR}/driver.log) — recorded intent stays pending, retried next cycle"
            report_state "apply-failed"
            return 1
        fi
        ;;
    *)
        warn "unknown targetState '${state}' for ${dom} — refusing (fail-closed; only public|internal are ever applied)"
        return 1
        ;;
    esac
    return 0
}

# ── ack_intent <intent-id> <row-gen> -> rc (always 0; best-effort) ──────────────
# WRITEBACK — WIRED. Called ONLY from apply_entry(), only right after a
# commit/rollback THIS run actually drove (never on an already-converged
# no-op cycle — see apply_entry()'s idempotency checks, which return before
# ever reaching the call sites below). POSTs
# <ack-base>/bff/internal/go-live/<intentId>/applied-ack {generation, appliedBy}
# over the SAME in-cluster mTLS transport /export uses (permitAll()+mTLS on
# /bff/internal/**, mirroring ImageBuildIngestController). <ack-base> is
# GOLIVE_ACK_URL if explicitly set, else BFF_URL — the SAME base the /export
# fetch already resolved, so a bare BFF_EXPORT_URL in node.env is enough; no
# second URL to configure. appliedBy is this node's own fingerprint
# (MACHINE_KEY_FP, the SAME identity ?node= provenance-tags the /export GET).
# rc is ALWAYS 0: a failed ack must never fail apply_entry() or abort the
# reconcile cycle — the posture change already succeeded; only the BFF row's
# applied_at/applied_by write-back is at risk, and the endpoint is CAS-
# idempotent server-side (a duplicate/retried ack just no-ops), so swallowing
# failure here costs nothing but a delayed status update.
ack_intent() {
    local intent_id="$1" gen="$2"
    [ -n "${intent_id}" ] || { warn "ack skipped: entry had no intentId — cannot POST applied-ack"; return 0; }
    [ -n "${gen}" ] || { warn "ack skipped for intent ${intent_id}: entry had no row-level generation"; return 0; }
    have curl || return 0
    # BFF_URL/MTLS_* are set unconditionally at the top of main() before
    # apply_entry() is ever reached on the real run path — but apply_entry()
    # (and thus ack_intent()) is also called DIRECTLY, without main(), by the
    # offline test harness, so every reference below is ":-"-guarded to stay
    # safe under this script's `set -u`.
    local ack_base="${GOLIVE_ACK_URL:-${BFF_URL:-}}"
    [ -n "${ack_base}" ] || { warn "ack skipped for intent ${intent_id}: no GOLIVE_ACK_URL/BFF_URL transport configured"; return 0; }
    local url="${ack_base%/}/bff/internal/go-live/${intent_id}/applied-ack"
    local body
    body="$(jq -nc --argjson g "${gen}" --arg by "${MACHINE_KEY_FP:-}" '{generation:$g, appliedBy:$by}' 2>/dev/null)" \
        || { warn "ack skipped for intent ${intent_id}: failed to build JSON body (gen=${gen})"; return 0; }
    local args=(-sS -m 10 --fail -X POST -H 'Content-Type: application/json' -d "${body}" -o /dev/null)
    [ -f "${MTLS_CA:-}" ] && args+=(--cacert "${MTLS_CA}")
    if [ -n "${MTLS_CERT:-}" ] && [ -n "${MTLS_KEY:-}" ] && [ -f "${MTLS_CERT:-}" ] && [ -f "${MTLS_KEY:-}" ]; then
        args+=(--cert "${MTLS_CERT}" --key "${MTLS_KEY}")
    else
        warn "ack for intent ${intent_id} skipped: mTLS client cert/key absent (best-effort; BFF's row stays pending until acked)"
        return 0
    fi
    if curl "${args[@]}" "${url}" 2>/dev/null; then
        log "acked intent ${intent_id} gen=${gen} appliedBy=${MACHINE_KEY_FP:-}"
    else
        warn "ack for intent ${intent_id} best-effort FAILED (non-2xx/timeout, url=${url}) — posture already applied locally; BFF row write-back not confirmed"
    fi
    return 0
}

# ── Main ──────────────────────────────────────────────────────────────────────────
main() {
    [ -r "${VERIFY_LIB}" ] || { warn "verify lib missing (${VERIFY_LIB}) — keeping cache"; exit 0; }
    [ -r "${NODE_ENV}" ]   || { warn "node.env missing — not a registry node? keeping cache"; exit 0; }
    [ -r "${PUB_KEY}" ]    || { warn "baked public key missing (${PUB_KEY}) — keeping cache (fail-closed)"; exit 0; }
    # shellcheck source=/dev/null
    . "${VERIFY_LIB}" 2>/dev/null || { warn "failed to source verify lib — keeping cache"; exit 0; }
    have jq      || { warn "jq absent — keeping cache"; exit 0; }
    have openssl || { warn "openssl absent — keeping cache"; exit 0; }
    mkdir -p "${CACHE_DIR}" 2>/dev/null || true

    MACHINE_KEY_FP="$(read_env MACHINE_KEY_FP)" || { warn "node.env missing MACHINE_KEY_FP — keeping cache"; exit 0; }
    [ -n "${MACHINE_KEY_FP}" ] || { warn "empty MACHINE_KEY_FP — keeping cache"; exit 0; }
    BFF_URL="$(read_env BFF_EXPORT_URL)"   || BFF_URL=""
    MTLS_CERT="$(read_env BFF_CLIENT_CERT)" || MTLS_CERT=""
    MTLS_KEY="$(read_env BFF_CLIENT_KEY)"   || MTLS_KEY=""
    MTLS_CA="$(read_env BFF_CA)"            || MTLS_CA="/etc/hugmesh/pki/ca-chain.crt"

    local dom; dom="$(read_file "${CLUSTER_DOMAIN_FILE}")"
    if [ -z "${dom}" ]; then
        warn "this node's cluster domain is unset (${CLUSTER_DOMAIN_FILE} missing) — nothing to reconcile against"
        report_state "no-domain"; exit 0
    fi

    local fetched; fetched="$(mktemp 2>/dev/null)" || { warn "mktemp failed — keeping cache"; exit 0; }
    trap 'rm -f "${fetched}" 2>/dev/null || true' EXIT

    if ! fetch_export "${fetched}"; then report_state "inert"; exit 0; fi

    if ! golive_verify_export "${fetched}" "${PUB_KEY}" "${LAST_GOOD}"; then
        warn "fetched go-live export FAILED verification/rollback (unsigned/tampered/foreign/gen<=last-good) — keeping cache, applying nothing"
        report_state "rejected"
        exit 0
    fi
    local gen; gen="$(rv_gen "${fetched}")"
    commit_cache "${fetched}" "${gen}" || exit 0

    local entry
    entry="$(gv_entry_for_domain "${EXPORT_JSON}" "${dom}")"
    if [ -z "${entry}" ]; then
        # Absence contract: nothing NEW to apply. Steady state — NOT a rollback.
        report_state "no-pending-intent"
        log "no recorded intent for this node's domain (${dom}) — nothing to apply"
        exit 0
    fi

    apply_entry "${entry}"
    # (writeback: apply_entry() acks internally, right after a real commit/
    # rollback it drove — see ack_intent(). Nothing further to do here.)
    exit 0
}

# Guard main so the logic test can source the functions without executing the flow.
if [ "${BASH_SOURCE[0]:-$0}" = "${0}" ]; then
    main "$@"
fi
