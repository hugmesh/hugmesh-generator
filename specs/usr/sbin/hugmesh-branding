#!/usr/bin/env bash
# hugmesh-branding — apply a HugMesh brand theme to this system: the GRUB boot
# screen, the graphical login (lightdm greeter) background, the desktop wallpaper, and
# a consistent colour scheme / accent. Drop-in files and directories supplied at image
# generation OR by the user later flow through this single tool, so the look is the same
# whether it was baked into the image or changed afterwards.
#
# Two run contexts:
#   • BUILD TIME (inside the image chroot, no desktop running) — bakes the GRUB
#     background + greeter background + colour scheme + /etc/skel and per-user defaults,
#     and installs a one-shot login autostart that finishes the in-session pieces
#     (wallpaper + colour scheme) the first time a desktop session starts.
#   • POST-INSTALL (on the running desktop) — the user re-themes at will. The ONLY thing
#     that stops them is an administrator who built the image with branding LOCKED
#     (/etc/hugmesh/branding.lock present) — e.g. a managed tailnet/cloud brand image.
#
# Usage:
#   hugmesh-branding apply [DIR]              apply a whole brand dir (default: /etc/hugmesh/branding)
#   hugmesh-branding set-wallpaper FILE
#   hugmesh-branding set-login-background FILE
#   hugmesh-branding set-grub-background FILE
#   hugmesh-branding set-accent '#RRGGBB'
#   hugmesh-branding set-color-scheme FILE.colors
#   hugmesh-branding session-apply            (run from the login autostart; in-session wallpaper + colours)
#   hugmesh-branding lock|unlock              (admin: prevent / allow user re-theming)
#   hugmesh-branding show
#
# A brand DIR may contain (every file is OPTIONAL; wallpaper.png is the fallback for the
# GRUB and login backgrounds when those are absent):
#   brand.conf            KEY=VALUE — BRAND_NAME, BRAND_TITLE, ACCENT_COLOR, COLOR_SCHEME_NAME
#   wallpaper.png         desktop background
#   grub-background.png   GRUB menu background        (fallback: wallpaper.png)
#   login-background.png  lightdm greeter background  (fallback: wallpaper.png)
#   logo.png              brand logo (greeter / about)
#   colors.colors         KDE colour-scheme file
set -euo pipefail

# ROOT lets the SAME tool stage into a build sysroot from the host (set
# HUGMESH_BRANDING_ROOT=<sysroot>) as well as apply to the running system (unset).
# Every system path below is ROOT-prefixed; the brand DIR passed to `apply` is NOT
# (it is read as-is). Build-time runs also set HUGMESH_BRANDING_BUILD=1.
ROOT="${HUGMESH_BRANDING_ROOT:-}"
BRAND_ETC="${ROOT}/etc/hugmesh"
BRAND_DIR_DEFAULT="${BRAND_ETC}/branding"   # canonical asset store inside the image
BRAND_CONF="${BRAND_ETC}/brand.conf"
LOCK_FILE="${BRAND_ETC}/branding.lock"
SHARE_DIR="${ROOT}/usr/share/hugmesh/branding"  # world-readable copy (greeter runs as the lightdm user)
GRUB_BG="${ROOT}/boot/grub/hugmesh-background.png"
GRUB_DEFAULT="${ROOT}/etc/default/grub"
GREETER_CONF="${ROOT}/etc/lightdm/lightdm-gtk-greeter.conf"
COLORSCHEME_DST="${ROOT}/usr/share/color-schemes/HugMesh.colors"
# REAL (un-prefixed) paths — used as the VALUES written INTO config files, which are
# read on the live/installed system where ROOT does not exist. The files themselves
# are written to the ROOT-prefixed locations above.
SHARE_DIR_REAL=/usr/share/hugmesh/branding
GRUB_BG_REAL=/boot/grub/hugmesh-background.png
GRUB_THEME_DIR="${ROOT}/boot/grub/themes/hugmesh"
GRUB_THEME_DIR_REAL=/boot/grub/themes/hugmesh

log() { printf '[branding] %s\n' "$*"; }
warn() { printf '[branding] WARNING: %s\n' "$*" >&2; }

# Escape a string for the REPLACEMENT side of `sed s|...|...|`: backslash first, then
# the ampersand (whole-match) and the `|` delimiter. brand.conf values like "AT&T" or a
# title with `|` would otherwise corrupt the rewritten config or abort sed under set -e.
_sed_rep_escape() {
    local s="$1"
    s="${s//\\/\\\\}"   # \  -> \\
    s="${s//&/\\&}"     # &  -> \&
    s="${s//|/\\|}"     # |  -> \|
    printf '%s' "${s}"
}

# Validate/normalise an accent — a malformed value would abort the whole apply via the
# base-16 arithmetic (`$(( 16#.. ))`) in _kdeglobals_set / _grub_color_name under set -e.
_norm_accent() {
    case "${ACCENT_COLOR}" in
        '#'[0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f]) : ;;
        *) warn "invalid accent '${ACCENT_COLOR}'; using default #1f6feb"; ACCENT_COLOR="#1f6feb" ;;
    esac
}

# ── brand.conf loader (STRICT KEY=VALUE — never dot-source) ──────────────────────
# SECURITY: a brand.conf may come from an operator-supplied --branding-dir (the build
# flag's DIR flows through to `apply DIR`), i.e. it can be attacker-authored and is NOT
# guaranteed to be the root-authored, image-baked file. Dot-sourcing it would run any
# shell it contains verbatim as root ($(...), backticks, `rm -rf`, function defs, ...).
# Instead we parse it as strict `KEY=VALUE`, reading ONLY the four known identity keys
# into their already-declared variables. Anything else — command substitution, extra
# keys, executable statements — is ignored, so brand.conf can only ever set data, never
# run code. Legit values are unchanged: `BRAND_TITLE="Acme Corp"` (spaces) and
# `ACCENT_COLOR="#3366ff"` (a quoted #hex) parse exactly as they did when sourced.
_load_brand_conf() {
    local conf="$1" line key val
    [ -r "${conf}" ] || return 0
    while IFS= read -r line || [ -n "${line}" ]; do
        # strip a trailing CR (CRLF files) and leading/trailing horizontal whitespace
        line="${line%$'\r'}"
        line="${line#"${line%%[![:space:]]*}"}"
        line="${line%"${line##*[![:space:]]}"}"
        case "${line}" in
            ''|'#'*) continue ;;                 # blank / comment
        esac
        case "${line}" in
            *=*) key="${line%%=*}"; val="${line#*=}" ;;
            *) continue ;;                        # not a KEY=VALUE line — ignore
        esac
        # trim whitespace around the key; keys are simple identifiers only.
        key="${key#"${key%%[![:space:]]*}"}"
        key="${key%"${key##*[![:space:]]}"}"
        case "${key}" in
            BRAND_NAME|BRAND_TITLE|ACCENT_COLOR|COLOR_SCHEME_NAME) : ;;
            *) continue ;;                        # unknown key — ignore, do not set
        esac
        # strip ONE layer of matching surrounding quotes (double or single); the value is
        # taken literally otherwise — no expansion, no command substitution.
        case "${val}" in
            \"*\") val="${val#\"}"; val="${val%\"}" ;;
            \'*\') val="${val#\'}"; val="${val%\'}" ;;
        esac
        # Defensive: a control character (the line reader already splits on newline, but
        # reject any stray C0 control — NUL/CR/tab/etc.) would corrupt a downstream sed
        # replacement; drop such a value rather than let it through.
        case "${val}" in
            *[[:cntrl:]]*) warn "ignoring ${key} in ${conf}: contains a control character"; continue ;;
        esac
        printf -v "${key}" '%s' "${val}"
    done < "${conf}"
}

# Brand identity (overridable by brand.conf). Defaults match the stock build.
BRAND_NAME=hugmesh
BRAND_TITLE="HugMesh Systems"
ACCENT_COLOR="#1f6feb"
COLOR_SCHEME_NAME="HugMesh"
_load_brand_conf "${BRAND_CONF}"
_norm_accent

# ── lock enforcement ───────────────────────────────────────────────────────────
# Build-time runs (chroot, run as root with HUGMESH_BRANDING_BUILD=1) bypass the
# lock — the administrator IS the one baking it. Post-install user runs that try to
# CHANGE branding are refused when locked.
require_unlocked() {
    [ "${HUGMESH_BRANDING_BUILD:-0}" = 1 ] && return 0
    if [ -e "${LOCK_FILE}" ]; then
        warn "branding is locked by the administrator of this image — cannot change it."
        warn "(an admin can run: hugmesh-branding unlock)"
        exit 3
    fi
}

# Real local users (uid >= 1000, excluding nobody) + the /etc/skel template, so both
# existing accounts and future ones inherit the look.
target_homes() {
    echo "${ROOT}/etc/skel"
    awk -F: '($3>=1000 && $3<65534){print $6}' "${ROOT}/etc/passwd" 2>/dev/null | while read -r h; do
        [ -d "${ROOT}${h}" ] && echo "${ROOT}${h}"
    done
}
# Numeric uid:gid so it is correct whether applied live or staged into a sysroot whose
# user namespace differs from the build host's /etc/passwd.
home_owner() { stat -c '%u:%g' "$1" 2>/dev/null || echo 0:0; }

# ── GRUB boot screen ───────────────────────────────────────────────────────────
apply_grub_background() {
    local src="$1"
    [ -f "${src}" ] || return 0
    install -D -m 0644 "${src}" "${GRUB_BG}"
    # Point /etc/default/grub at it (idempotent) so any later grub-mkconfig keeps it.
    if [ -f "${GRUB_DEFAULT}" ]; then
        if grep -q '^GRUB_BACKGROUND=' "${GRUB_DEFAULT}"; then
            sed -i "s|^GRUB_BACKGROUND=.*|GRUB_BACKGROUND=\"${GRUB_BG_REAL}\"|" "${GRUB_DEFAULT}"
        else
            printf 'GRUB_BACKGROUND="%s"\n' "${GRUB_BG_REAL}" >> "${GRUB_DEFAULT}"
        fi
    fi
    # On a running/installed system (ROOT unset), regenerate grub.cfg so it takes
    # effect now. When staging into a sysroot we only drop the file + default; the
    # image's own grub.cfg is generated later (installed .img) or carries the
    # background_image directive (live ISO).
    if [ -z "${ROOT}" ] && command -v grub-mkconfig >/dev/null 2>&1 \
            && [ -d /boot/grub ] && [ -f /boot/grub/grub.cfg ]; then
        grub-mkconfig -o /boot/grub/grub.cfg >/dev/null 2>&1 \
            && log "GRUB background applied + grub.cfg regenerated" \
            || warn "grub.cfg regeneration failed (background staged for next grub-mkconfig)"
    else
        log "GRUB background staged at ${GRUB_BG} (applied at next grub-mkconfig)"
    fi
}

# Set KEY="VALUE" in /etc/default/grub (replace existing or append). Drives the
# INSTALLED system's grub-mkconfig; the live ISO grub.cfg is written directly elsewhere.
_grub_default_set() {
    local key="$1" val="$2" val_esc
    val_esc="$(_sed_rep_escape "${val}")"
    [ -f "${GRUB_DEFAULT}" ] || : > "${GRUB_DEFAULT}"
    if grep -q "^${key}=" "${GRUB_DEFAULT}"; then
        sed -i "s|^${key}=.*|${key}=\"${val_esc}\"|" "${GRUB_DEFAULT}"
    else
        printf '%s="%s"\n' "${key}" "${val}" >> "${GRUB_DEFAULT}"
    fi
}

# Map an #RRGGBB accent to the nearest GRUB *text-mode* colour name (GRUB_COLOR_* only
# accepts 16 names, not hex — the gfxmenu theme below uses the real hex).
_grub_color_name() {
    local hex="${1#\#}" r g b
    r=$(( 16#${hex:0:2} )); g=$(( 16#${hex:2:2} )); b=$(( 16#${hex:4:2} ))
    if   [ "${b}" -ge "${r}" ] && [ "${b}" -ge "${g}" ]; then echo light-blue
    elif [ "${g}" -ge "${r}" ] && [ "${g}" -ge "${b}" ]; then echo light-green
    elif [ "${r}" -ge "${g}" ] && [ "${r}" -ge "${b}" ]; then echo light-red
    else echo light-cyan; fi
}

# ── GRUB theme (the FULL boot-screen brand: title, fonts, menu box, accent, colours) ──
# Covers every GRUB branding knob: GRUB_THEME (gfxmenu theme.txt), GRUB_BACKGROUND,
# GRUB_GFXMODE/GFXPAYLOAD, GRUB_TERMINAL_OUTPUT=gfxterm, GRUB_COLOR_NORMAL/HIGHLIGHT text
# fallback, GRUB_DISTRIBUTOR, and a generated font so gfxmenu actually renders. A full
# drop-in theme dir (brand 'grub-theme/' or --grub-theme DIR) wins over the generated one.
apply_grub_theme() {
    local theme_src="${1:-}" bg="${2:-}"
    mkdir -p "${GRUB_THEME_DIR}" "${ROOT}/boot/grub/fonts"
    if [ -n "${theme_src}" ] && [ -f "${theme_src}/theme.txt" ]; then
        cp -r "${theme_src}/." "${GRUB_THEME_DIR}/"          # full author-supplied theme
        log "GRUB theme: installed drop-in theme from ${theme_src}"
    else
        # background inside the theme dir (theme references it relatively)
        [ -f "${bg}" ] && install -m 0644 "${bg}" "${GRUB_THEME_DIR}/background.png"
        # a named font so gfxmenu can render text (else the theme silently fails)
        local fontname="HugMesh Regular 16" fontok=false ttf
        # NB: tolerate missing search dirs — find exits non-zero then, and set -o pipefail
        # would otherwise abort the whole apply (|| true keeps the assignment at exit 0).
        ttf="$(find /usr/share/fonts -name 'DejaVuSans.ttf' -o -name 'LiberationSans-Regular.ttf' 2>/dev/null | head -1 || true)"
        if command -v grub-mkfont >/dev/null 2>&1 && [ -n "${ttf}" ]; then
            grub-mkfont -s 16 -o "${GRUB_THEME_DIR}/font.pf2" -n "HugMesh Regular" "${ttf}" 2>/dev/null && fontok=true
        fi
        if ! ${fontok}; then
            # fall back to a stock unicode pf2 if one exists
            local pf2; pf2="$(find /boot/grub /usr/share/grub /usr/lib/grub -name 'unicode.pf2' 2>/dev/null | head -1 || true)"
            [ -n "${pf2}" ] && cp "${pf2}" "${GRUB_THEME_DIR}/font.pf2" && fontname="Unifont Regular 16" && fontok=true
        fi
        local fontline=""
        ${fontok} && fontline="terminal-font: \"${fontname}\""
        # generate theme.txt — title, accent-highlighted menu, countdown label
        cat > "${GRUB_THEME_DIR}/theme.txt" <<THEME
# Generated by hugmesh-branding — ${BRAND_TITLE}
title-text: "${BRAND_TITLE}"
title-color: "#ffffff"
title-font: "${fontname}"
desktop-image: "background.png"
desktop-color: "#000000"
message-color: "#cccccc"
${fontline}

+ boot_menu {
    left   = 12%
    top    = 30%
    width  = 76%
    height = 44%
    item_font            = "${fontname}"
    item_color           = "#c9d3e6"
    selected_item_color  = "${ACCENT_COLOR}"
    item_height          = 28
    item_padding         = 6
    item_spacing         = 6
    icon_width  = 0
    icon_height = 0
}
+ label {
    top   = 86%
    left  = 0
    width = 100%
    align = "center"
    color = "#8a93a8"
    font  = "${fontname}"
    text  = "${BRAND_TITLE} — booting the highlighted entry in %d s"
    id    = "__timeout__"
}
THEME
        log "GRUB theme: generated theme.txt (accent ${ACCENT_COLOR}, font: $(${fontok} && echo "${fontname}" || echo built-in))"
    fi
    # Wire every GRUB default knob (installed system). Live ISO grub.cfg sets these directly.
    local cname; cname="$(_grub_color_name "${ACCENT_COLOR}")"
    _grub_default_set GRUB_THEME "${GRUB_THEME_DIR_REAL}/theme.txt"
    _grub_default_set GRUB_GFXMODE "1920x1080,1280x720,auto"
    _grub_default_set GRUB_GFXPAYLOAD_LINUX "keep"
    _grub_default_set GRUB_TERMINAL_OUTPUT "gfxterm"
    _grub_default_set GRUB_COLOR_NORMAL "white/black"
    _grub_default_set GRUB_COLOR_HIGHLIGHT "${cname}/black"
    _grub_default_set GRUB_DISTRIBUTOR "${BRAND_TITLE}"
    [ -f "${GRUB_THEME_DIR}/font.pf2" ] && _grub_default_set GRUB_FONT "${GRUB_THEME_DIR_REAL}/font.pf2"
}

# ── lightdm greeter (graphical login) ──────────────────────────────────────────
apply_login_background() {
    local src="$1"
    [ -f "${src}" ] || return 0
    install -D -m 0644 "${src}" "${SHARE_DIR}/login-background.png"
    mkdir -p "$(dirname "${GREETER_CONF}")"
    [ -f "${GREETER_CONF}" ] || printf '[greeter]\n' > "${GREETER_CONF}"
    grep -q '^\[greeter\]' "${GREETER_CONF}" || printf '[greeter]\n' >> "${GREETER_CONF}"
    _greeter_set background "${SHARE_DIR_REAL}/login-background.png"
    _greeter_set theme-name Adwaita-dark
    _greeter_set icon-theme-name Adwaita
    [ -f "${SHARE_DIR}/logo.png" ] && _greeter_set default-user-image "${SHARE_DIR_REAL}/logo.png"
    log "lightdm greeter background applied"
}
# set key=value in the [greeter] section (replace or append)
_greeter_set() {
    local key="$1" val="$2" val_esc
    val_esc="$(_sed_rep_escape "${val}")"
    if grep -q "^${key}=" "${GREETER_CONF}"; then
        sed -i "s|^${key}=.*|${key}=${val_esc}|" "${GREETER_CONF}"
    else
        sed -i "0,/^\[greeter\]/s|^\[greeter\]|[greeter]\n${key}=${val_esc}|" "${GREETER_CONF}"
    fi
}

# ── desktop wallpaper ──────────────────────────────────────────────────────────
# Store the chosen wallpaper world-readably; record it for the in-session applier and
# for every user's skel. Also drop a KDE wallpaper package so Plasma lists it.
apply_wallpaper() {
    local src="$1"
    [ -f "${src}" ] || return 0
    install -D -m 0644 "${src}" "${SHARE_DIR}/wallpaper.png"
    # KDE wallpaper image-package (so it appears in Plasma's wallpaper picker too).
    local wp="${ROOT}/usr/share/wallpapers/HugMesh/contents/images"
    install -D -m 0644 "${src}" "${wp}/1920x1080.png"
    cat > "${ROOT}/usr/share/wallpapers/HugMesh/metadata.desktop" <<META
[Desktop Entry]
Name=${BRAND_TITLE}
X-KDE-PluginInfo-Name=HugMesh
X-KDE-PluginInfo-Author=${BRAND_TITLE}
META
    log "wallpaper staged at ${SHARE_DIR}/wallpaper.png"
}

# ── colour scheme / accent ─────────────────────────────────────────────────────
apply_color_scheme() {
    local src="${1:-}"
    if [ -n "${src}" ] && [ -f "${src}" ]; then
        install -D -m 0644 "${src}" "${COLORSCHEME_DST}"
    fi
    # Per-user + skel kdeglobals: select the scheme + accent so Plasma/KDE apps are
    # consistent. Written even if no .colors file shipped (accent still applies).
    local h owner
    while read -r h; do
        [ -d "${h}" ] || continue
        owner="$(home_owner "${h}")"
        mkdir -p "${h}/.config"
        _kdeglobals_set "${h}/.config/kdeglobals"
        chown -R "${owner%%:*}:${owner##*:}" "${h}/.config" 2>/dev/null || true
    done < <(target_homes)
    log "colour scheme '${COLOR_SCHEME_NAME}' + accent ${ACCENT_COLOR} applied to users + skel"
}
# Write the minimal kdeglobals keys for scheme + accent (decimal R,G,B).
_kdeglobals_set() {
    local f="$1" r g b
    r=$(( 16#$(printf '%s' "${ACCENT_COLOR#\#}" | cut -c1-2) ))
    g=$(( 16#$(printf '%s' "${ACCENT_COLOR#\#}" | cut -c3-4) ))
    b=$(( 16#$(printf '%s' "${ACCENT_COLOR#\#}" | cut -c5-6) ))
    touch "${f}"
    grep -q '^\[General\]' "${f}" || printf '[General]\n' >> "${f}"
    _ini_set "${f}" General ColorScheme "${COLOR_SCHEME_NAME}"
    _ini_set "${f}" General AccentColor "${r},${g},${b}"
    _ini_set "${f}" KDE widgetStyle Breeze
}
# crude but dependency-free INI setter: section/key=value (replace or append in section)
_ini_set() {
    local f="$1" sec="$2" key="$3" val="$4" val_esc
    val_esc="$(_sed_rep_escape "${val}")"
    grep -q "^\[${sec}\]" "${f}" || printf '\n[%s]\n' "${sec}" >> "${f}"
    if awk -v s="[${sec}]" -v k="${key}" '
        $0==s{ins=1;next} /^\[/{ins=0} ins&&$0~"^"k"="{found=1} END{exit !found}' "${f}"; then
        sed -i "/^\[${sec}\]/,/^\[/{s|^${key}=.*|${key}=${val_esc}|}" "${f}"
    else
        sed -i "0,/^\[${sec}\]/s|^\[${sec}\]|[${sec}]\n${key}=${val_esc}|" "${f}"
    fi
}

# ── in-session applier (wallpaper + colours) ───────────────────────────────────
# Runs from the per-user login autostart the first time a desktop session starts,
# detecting the live DE. Self-disables via a stamp so the user can change wallpaper
# afterwards and it is NOT reset on the next login.
session_apply() {
    local wp="${SHARE_DIR}/wallpaper.png"
    local stamp="${HOME}/.config/.hugmesh-branding-applied"
    [ -e "${stamp}" ] && { log "session branding already applied; leaving user's choice"; return 0; }
    [ -f "${wp}" ] || { warn "no wallpaper to apply"; return 0; }
    if command -v plasma-apply-wallpaperimage >/dev/null 2>&1; then
        plasma-apply-wallpaperimage "${wp}" >/dev/null 2>&1 || true
        command -v plasma-apply-colorscheme >/dev/null 2>&1 \
            && plasma-apply-colorscheme "${COLOR_SCHEME_NAME}" >/dev/null 2>&1 || true
    elif command -v xfconf-query >/dev/null 2>&1; then
        # xfce: set every monitor/workspace backdrop property to the wallpaper. The
        # `|| true` on the pipeline is load-bearing: a no-match grep would otherwise
        # (set -o pipefail) abort session_apply BEFORE the stamp below is written, so
        # the autostart would re-apply the brand wallpaper on every login, clobbering
        # the user's own choice.
        xfconf-query -c xfce4-desktop -l 2>/dev/null | grep -E '/last-image$' | while read -r p; do
            xfconf-query -c xfce4-desktop -p "${p}" -s "${wp}" 2>/dev/null || true
        done || true
        xfconf-query -c xfce4-desktop -p /backdrop/screen0/monitor0/workspace0/last-image \
            -n -t string -s "${wp}" 2>/dev/null || true
    elif command -v pcmanfm >/dev/null 2>&1; then
        pcmanfm --set-wallpaper "${wp}" >/dev/null 2>&1 || true   # LXDE/openbox
    elif command -v feh >/dev/null 2>&1; then
        feh --bg-fill "${wp}" >/dev/null 2>&1 || true             # bare WM fallback
    fi
    mkdir -p "${HOME}/.config"; : > "${stamp}"
    log "in-session wallpaper + colours applied for ${USER:-$(id -un)}"
}

install_session_autostart() {
    install -D -m 0755 "$0" "${ROOT}/usr/sbin/hugmesh-branding" 2>/dev/null || true
    mkdir -p "${ROOT}/etc/xdg/autostart"
    cat > "${ROOT}/etc/xdg/autostart/hugmesh-branding.desktop" <<AUTOSTART
[Desktop Entry]
Type=Application
Name=HugMesh branding (first-login wallpaper)
Exec=/usr/sbin/hugmesh-branding session-apply
NoDisplay=true
X-GNOME-Autostart-enabled=true
AUTOSTART
}

# ── whole-directory apply ──────────────────────────────────────────────────────
apply_dir() {
    local dir="${1:-${BRAND_DIR_DEFAULT}}"
    [ -d "${dir}" ] || { warn "brand dir not found: ${dir}"; exit 1; }
    # STRICT parse (never dot-source): DIR may be operator-supplied / attacker-authored.
    _load_brand_conf "${dir}/brand.conf"
    _norm_accent   # a brand.conf accent could be malformed; never let it abort the apply
    mkdir -p "${SHARE_DIR}"
    # wallpaper is the fallback source for the boot + login backgrounds.
    local wp="${dir}/wallpaper.png"
    apply_wallpaper "${wp}"
    local grub_bg; grub_bg="$([ -f "${dir}/grub-background.png" ] && echo "${dir}/grub-background.png" || echo "${wp}")"
    apply_grub_background  "${grub_bg}"
    # Full GRUB theme: a drop-in 'grub-theme/' dir wins, else generate from bg + accent.
    apply_grub_theme "$([ -d "${dir}/grub-theme" ] && echo "${dir}/grub-theme" || echo "")" "${grub_bg}"
    apply_login_background "$([ -f "${dir}/login-background.png" ] && echo "${dir}/login-background.png" || echo "${wp}")"
    [ -f "${dir}/logo.png" ] && install -D -m 0644 "${dir}/logo.png" "${SHARE_DIR}/logo.png"
    apply_color_scheme "${dir}/colors.colors"
    install_session_autostart
    log "brand '${BRAND_TITLE}' applied from ${dir}"
}

usage() { sed -n '2,30p' "$0"; }

cmd="${1:-apply}"; shift || true
case "${cmd}" in
    apply)                apply_dir "${1:-${BRAND_DIR_DEFAULT}}" ;;
    set-wallpaper)        require_unlocked; apply_wallpaper "${1:?file}"; log "run 'hugmesh-branding session-apply' or re-login to see it" ;;
    set-login-background) require_unlocked; apply_login_background "${1:?file}" ;;
    set-grub-background)  require_unlocked; apply_grub_background "${1:?file}"; apply_grub_theme "" "${1}" ;;
    set-grub-theme)       require_unlocked; apply_grub_theme "${1:?theme-dir}" "" ;;
    set-accent)           require_unlocked; ACCENT_COLOR="${1:?#RRGGBB}"; _norm_accent; apply_color_scheme ""; apply_grub_theme "" "${GRUB_BG}" ;;
    set-color-scheme)     require_unlocked; apply_color_scheme "${1:?file.colors}" ;;
    session-apply)        session_apply ;;
    lock)                 : > "${LOCK_FILE}"; log "branding locked (users cannot re-theme)" ;;
    unlock)               rm -f "${LOCK_FILE}"; log "branding unlocked" ;;
    show)
        echo "brand:        ${BRAND_TITLE} (${BRAND_NAME})"
        echo "accent:       ${ACCENT_COLOR}"
        echo "colorscheme:  ${COLOR_SCHEME_NAME}"
        echo "locked:       $([ -e "${LOCK_FILE}" ] && echo yes || echo no)"
        echo "assets:       ${SHARE_DIR}"
        ls -1 "${SHARE_DIR}" 2>/dev/null | sed 's/^/  /' || true ;;
    -h|--help|help)       usage ;;
    *)                    warn "unknown command: ${cmd}"; usage; exit 2 ;;
esac
