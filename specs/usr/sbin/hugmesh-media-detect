#!/bin/bash
# hugmesh-media-detect — find + mount the SEPARATE media-data device (the disk
# that holds the Steam library + the gocryptfs Vaults store) and wire Steam to it.
#
# Runs at every boot (OpenRC service). It is deliberately SAFE + idempotent:
#  - it NEVER formats or writes partition tables (read-only probe mounts only);
#  - it only mounts a device it positively identifies (by LABEL or by the marker
#    directories), so a fresh reinstall on this host re-attaches the SAME data
#    disk that survived the install;
#  - everything is gated by /etc/hugmesh/media.conf (configurable + optional).
set -u
CONF=/etc/hugmesh/media.conf
log() { echo "[media-detect] $*"; }

[ -r "${CONF}" ] || { log "no ${CONF}; nothing to do"; exit 0; }
# shellcheck disable=SC1090
. "${CONF}"

[ "${MEDIA_DATA_ENABLED:-false}" = "true" ] || { log "disabled (MEDIA_DATA_ENABLED!=true)"; exit 0; }
MEDIA_MOUNT="${MEDIA_MOUNT:-/media}"
MEDIA_USER="${MEDIA_USER:-snap}"
MEDIA_MARKERS="${MEDIA_MARKERS:-Steam Vaults}"
STEAM_DIR="${STEAM_DIR:-${MEDIA_MOUNT}/Steam}"
VAULTS_DIR="${VAULTS_DIR:-${MEDIA_MOUNT}/Vaults}"
STEAM_DELIVERY="${STEAM_DELIVERY:-flatpak}"
VAULTS_ENABLED="${VAULTS_ENABLED:-true}"

mkdir -p "${MEDIA_MOUNT}"

# The partition currently backing / — never touch it.
root_src="$(findmnt -no SOURCE / 2>/dev/null || true)"

dir_has_marker() {  # $1 = a mounted directory; true if it contains a marker dir
    local d m
    for m in ${MEDIA_MARKERS}; do
        [ -d "$1/${m}" ] && return 0
    done
    return 1
}

mount_data_device() {
    # Already mounted there (e.g. via an fstab nofail entry)? Done.
    if mountpoint -q "${MEDIA_MOUNT}" && dir_has_marker "${MEDIA_MOUNT}"; then
        log "${MEDIA_MOUNT} already mounted and holds the markers"; return 0
    fi

    # 1) By explicit LABEL, if configured.
    if [ -n "${MEDIA_LABEL:-}" ] && [ -e "/dev/disk/by-label/${MEDIA_LABEL}" ]; then
        log "mounting LABEL=${MEDIA_LABEL} at ${MEDIA_MOUNT}"
        mount "/dev/disk/by-label/${MEDIA_LABEL}" "${MEDIA_MOUNT}" && return 0
    fi

    # 2) Content-scan: read-only probe every non-root, unmounted partition and
    # mount the first one carrying a marker dir. We let `mount` AUTO-DETECT the
    # filesystem (FSTYPE from lsblk is unreliable/empty on some hosts, so filtering
    # on it would wrongly skip the real data disk). swap/ESP just fail the probe or
    # carry no markers and are skipped. lsblk -P (key="value") is parsed safely.
    local probe line NAME TYPE FSTYPE MOUNTPOINT
    probe="$(mktemp -d /tmp/media-probe.XXXXXX)" || return 1
    while IFS= read -r line; do
        NAME=""; TYPE=""; FSTYPE=""; MOUNTPOINT=""
        eval "${line}"                          # sets NAME/TYPE/FSTYPE/MOUNTPOINT
        [ "${TYPE}" = "part" ] || continue
        [ -n "${NAME}" ] || continue
        [ "${FSTYPE}" = "swap" ] && continue    # only when lsblk actually knows
        [ -n "${MOUNTPOINT}" ] && continue      # skip already-mounted
        [ "${NAME}" = "${root_src}" ] && continue
        if mount -o ro "${NAME}" "${probe}" 2>/dev/null; then
            if dir_has_marker "${probe}"; then
                umount "${probe}" 2>/dev/null
                log "data device ${NAME} carries the markers — mounting at ${MEDIA_MOUNT}"
                mount "${NAME}" "${MEDIA_MOUNT}" && { rmdir "${probe}" 2>/dev/null; return 0; }
            fi
            umount "${probe}" 2>/dev/null
        fi
    done < <(lsblk -pno NAME,TYPE,FSTYPE,MOUNTPOINT -P)
    rmdir "${probe}" 2>/dev/null
    log "no attached data device with markers (${MEDIA_MARKERS}) found — continuing"
    return 1
}

mount_data_device || true

# Ensure the Steam + Vaults dirs exist (so the desktop has stable paths even if the
# data device is absent this boot), owned by the desktop user.
if id "${MEDIA_USER}" >/dev/null 2>&1; then
    mkdir -p "${STEAM_DIR}" "${VAULTS_DIR}" 2>/dev/null || true
    chown "${MEDIA_USER}:${MEDIA_USER}" "${STEAM_DIR}" "${VAULTS_DIR}" 2>/dev/null || true
    home="$(getent passwd "${MEDIA_USER}" | cut -d: -f6)"

    # Steam → /media/Steam: symlink the user's Steam data dir at the library so any
    # Steam (native or flatpak) installs/games land on the data disk.
    if [ "${STEAM_DELIVERY}" != "none" ] && [ -n "${home}" ]; then
        for sp in "${home}/.local/share/Steam" "${home}/.steam/steam"; do
            if [ ! -e "${sp}" ] || [ -L "${sp}" ]; then
                mkdir -p "$(dirname "${sp}")"
                ln -sfn "${STEAM_DIR}" "${sp}"
                chown -h "${MEDIA_USER}:${MEDIA_USER}" "${sp}" 2>/dev/null || true
            fi
        done
        # Flatpak Steam: grant filesystem access to the library + the vault.
        if [ "${STEAM_DELIVERY}" = "flatpak" ] && command -v flatpak >/dev/null 2>&1; then
            flatpak override --system --filesystem="${STEAM_DIR}" com.valvesoftware.Steam 2>/dev/null || true
            [ "${VAULTS_ENABLED}" = "true" ] && flatpak override --system --filesystem="${VAULTS_DIR}" com.valvesoftware.Steam 2>/dev/null || true
        fi
    fi
fi

exit 0
