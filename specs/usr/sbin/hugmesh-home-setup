#!/bin/bash
# hugmesh-home-setup — first-boot home provisioning for standalone desktops.
#
# Driven by /etc/hugmesh/home.conf (baked by build-x86-host-stage4.sh). It is
# idempotent and self-removes its local.d hook when finished. It NEVER formats a
# disk or touches anything outside the target user's home + the PAM stack.
#
# Responsibilities, by HOME_MODE / flags:
#   HOME_ENCRYPTED=true  -> wire pam_ecryptfs so ~/.Private unwraps at login. The
#                           migration of an existing home into ~/.Private is NOT
#                           automatic (see section 1): it needs root, the login
#                           password and the user logged out at the same time.
#   HOME_MODE=adopt      -> the installer already mounted the existing home device
#                           at /home (no format); just fix ownership if needed.
#   HOME_MODE=restore    -> the installer already decrypted+unpacked the backup.
#   HOME_SEED_CODE!=none  -> drop the HugMesh stack (code + docker-compose runner)
#                           into ~/hugmesh-stack.
set -uo pipefail

CONF=/etc/hugmesh/home.conf
[ -r "${CONF}" ] || { echo "hugmesh-home-setup: no ${CONF}; nothing to do"; exit 0; }
# shellcheck source=/dev/null
. "${CONF}"

USER_NAME="${LOCAL_USER:-}"
[ -n "${USER_NAME}" ] || { echo "hugmesh-home-setup: LOCAL_USER unset; skipping"; exit 0; }
id "${USER_NAME}" >/dev/null 2>&1 || { echo "hugmesh-home-setup: user ${USER_NAME} not created yet; will retry next boot"; exit 0; }
USER_HOME="$(getent passwd "${USER_NAME}" | cut -d: -f6)"
USER_HOME="${USER_HOME:-/home/${USER_NAME}}"

log(){ echo "  [home-setup] $*"; }

# ── 1. Per-user ecryptfs: wire pam_ecryptfs (idempotent) ─────────────────────
# wire_pam_ecryptfs FILE — add pam_ecryptfs after the LAST line of each of the
# auth / password / session stacks in FILE. Never directly after pam_unix.
#
# WHY "after the last line". Gentoo's pambase system-auth reads
#     auth  [success=1 new_authtok_reqd=1 ignore=ignore default=bad]  pam_unix.so ...
#     auth  [default=die]  pam_faillock.so authfail
#     auth  optional       pam_cap.so
# `success=1` means "on a correct password, SKIP THE NEXT LINE", and the next line
# is meant to be the authfail counter. This used to insert
# `auth optional pam_ecryptfs.so unwrap` right after pam_unix, so a correct password
# skipped the ecryptfs line and landed on `[default=die] pam_faillock.so authfail`:
# every correct login failed (PAM_PERM_DENIED, rc=6 against the image's real
# system-auth on libpam 1.7.2) and counted a faillock failure. lightdm, login, su,
# sudo and sshd all go through system-auth and root is locked, so the 2026-10-30
# standalone image had NO working login at all. A line appended after the last
# line of a stack cannot change where any earlier jump lands, whatever the layout,
# and an `optional` line reached only on the success path is what pam_ecryptfs wants.
# The file is rewritten in place (cat >), so its mode and SELinux label survive.
wire_pam_ecryptfs() {
    local pf="$1" tmp
    [ -f "${pf}" ] || return 0
    grep -q 'pam_ecryptfs\.so' "${pf}" && return 0
    tmp="$(mktemp "${pf}.XXXXXX")" || return 1
    if awk '
        { line[NR] = $0 }
        /^[[:space:]]*-?auth[[:space:]]/     { la = NR }
        /^[[:space:]]*-?password[[:space:]]/ { lp = NR }
        /^[[:space:]]*-?session[[:space:]]/  { lse = NR }
        END {
            for (i = 1; i <= NR; i++) {
                print line[i]
                if (i == la)  print "auth\t\toptional\tpam_ecryptfs.so unwrap"
                if (i == lp)  print "password\toptional\tpam_ecryptfs.so"
                if (i == lse) print "session\t\toptional\tpam_ecryptfs.so unwrap"
            }
        }' "${pf}" > "${tmp}"; then
        cat "${tmp}" > "${pf}"
        rm -f "${tmp}"
        return 0
    fi
    rm -f "${tmp}"
    return 1
}

if [ "${HOME_ENCRYPTED:-false}" = "true" ] && command -v mount.ecryptfs_private >/dev/null 2>&1; then
    # system-auth only, plus system-login when it carries its OWN pam_unix stack. On
    # Gentoo system-login `include`s system-auth, so wiring both would run
    # pam_ecryptfs twice per login.
    for pf in /etc/pam.d/system-auth /etc/pam.d/system-login; do
        [ -f "${pf}" ] || continue
        if [ "${pf}" = /etc/pam.d/system-login ] && ! grep -q '^[^#]*pam_unix\.so' "${pf}"; then
            continue
        fi
        if ! grep -q pam_ecryptfs.so "${pf}"; then
            wire_pam_ecryptfs "${pf}" && log "wired pam_ecryptfs into ${pf}"
        fi
    done
    # create/archive/restore: the home content is PLAINTEXT-on-LUKS. Migrating it
    # into a per-user eCryptfs ~/.Private needs the login password, which only
    # exists at login, AND root, AND the user logged OUT (ecryptfs-migrate-home
    # refuses a home with open files). The one-shot this used to arm from
    # ~/.bash_profile ran ecryptfs-migrate-home as the USER, which refuses non-root
    # ("must be executed with root privileges"), swallowed the error, printed
    # "Done", and was never sourced by a lightdm/Plasma session anyway. It
    # encrypted nothing, so it is no longer armed; the PAM wiring above stays, so a
    # home migrated by an administrator unwraps with the login password.
    case "${HOME_MODE:-create}" in
        create|archive|restore)
            if [ ! -e "${USER_HOME}/.ecryptfs/Private.sig" ]; then
                log "per-user eCryptfs migration is NOT automatic: as root, with ${USER_NAME} logged out, run 'ecryptfs-migrate-home -u ${USER_NAME}'"
            fi
            ;;
    esac
fi

# ── 2. adopt/restore: the installer already placed the home; just fix ownership ──
case "${HOME_MODE:-create}" in
    adopt|restore)
        if [ -d "${USER_HOME}" ]; then
            chown "${USER_NAME}:${USER_NAME}" "${USER_HOME}" 2>/dev/null || true
            log "home ${HOME_MODE}: ${USER_HOME} present (installer-mounted/unpacked)"
        fi
        ;;
esac

# ── 3. Dockerized stack / mesh-node code into ~/hugmesh-stack ─────────────
if [ "${HOME_SEED_CODE:-none}" != "none" ]; then
    DST="${USER_HOME}/hugmesh-stack"
    mkdir -p "${DST}"
    # Code: prefer a bundle staged in the image; else write a runtime fetch helper.
    if [ -d /usr/share/hugmesh/stack/repos ]; then
        cp -r /usr/share/hugmesh/stack/repos/. "${DST}/" 2>/dev/null || true
        log "seeded HugMesh repos from the bundled snapshot"
    fi
    # Compose + runner templates (always shipped under /usr/share/hugmesh/stack).
    for f in docker-compose.yml docker-compose.mesh.yml hugmesh-stack README.md; do
        [ -f "/usr/share/hugmesh/stack/${f}" ] && cp "/usr/share/hugmesh/stack/${f}" "${DST}/${f}"
    done
    [ -f "${DST}/hugmesh-stack" ] && chmod +x "${DST}/hugmesh-stack"
    # If no code was bundled, leave a fetch helper that clones at the user's request.
    if [ ! -d "${DST}/hugmesh-generator" ] && [ -f "/usr/share/hugmesh/stack/fetch-repos.sh" ]; then
        cp /usr/share/hugmesh/stack/fetch-repos.sh "${DST}/fetch-repos.sh"; chmod +x "${DST}/fetch-repos.sh"
    fi
    chown -R "${USER_NAME}:${USER_NAME}" "${DST}" 2>/dev/null || true
    # A dockerized MESH node also wants the container runtime up.
    if [ "${HOME_SEED_CODE}" = "mesh" ] && command -v rc-update >/dev/null 2>&1; then
        rc-update add docker default 2>/dev/null || true
    fi
    log "stack code ready in ${DST} (mode=${HOME_SEED_CODE}) — run ./hugmesh-stack up"
fi

# ── 4. self-destruct the hook ────────────────────────────────────────────────
rm -f /etc/local.d/03-home-setup.start
log "home provisioning complete"
exit 0
