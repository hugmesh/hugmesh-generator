#!/bin/bash
# hugmesh-headscale-oidc-defer — switch headscale's OIDC on once its issuer answers.
#
# Mesh control over Tor (OPT-IN; docs/MESH-CONTROL-OVER-TOR.md), operator decision
# 2026-11-11: first sign-in uses the PRE-AUTH KEYS on the KEYS sticks; OIDC only once
# the identity provider answers; the issuer is never published over the onion.
# headscale 0.23 with only_start_if_oidc_is_available: false starts without OIDC when
# discovery fails (measured: ~39 s blocked, then "falling back to CLI based
# authentication") and NEVER retries: /register keeps serving the CLI page until a
# restart. So while keys-provision's marker exists this cron job (every minute, the
# pki only) asks the issuer's discovery document, and on the first 200 restarts
# headscale once and removes the marker. Nothing else is touched.
set -uo pipefail
MARKER="${HEADSCALE_OIDC_DEFER_MARKER:-/var/lib/hugmesh/headscale-oidc-deferred}"
CONFIG="${HEADSCALE_CONFIG:-/etc/headscale/config.yaml}"
LOG_TAG="hugmesh-headscale-oidc-defer"
log() { echo "[${LOG_TAG} $(date -u '+%Y-%m-%dT%H:%M:%SZ')] $*"; command -v logger >/dev/null 2>&1 && logger -t "${LOG_TAG}" -- "$*" 2>/dev/null || true; }

[ -e "${MARKER}" ] || exit 0
issuer="$(sed -n '/^oidc:/,/^[^ #]/p' "${CONFIG}" 2>/dev/null | sed -n 's/^[[:space:]]\{1,\}issuer:[[:space:]]*//p' | head -1 | sed -e 's/[[:space:]]#.*$//' | tr -d "\"' ")"
if [ -z "${issuer}" ]; then
    log "no oidc issuer in ${CONFIG} — nothing to defer; marker removed"
    rm -f "${MARKER}"; exit 0
fi
if ! [[ "${issuer}" =~ ^https?://[A-Za-z0-9.:\[\]_-]+(/[A-Za-z0-9._~/%-]*)?$ ]]; then
    log "oidc issuer '${issuer}' is not a plain URL — left deferred"
    exit 0
fi
code="$(curl -sS -m 10 -o /dev/null -w '%{http_code}' "${issuer%/}/.well-known/openid-configuration" 2>/dev/null)"
if [ "${code}" != "200" ]; then
    exit 0   # not yet: the next minute asks again
fi
if rc-service headscale restart >/dev/null 2>&1; then
    rm -f "${MARKER}"
    log "issuer ${issuer} answers — restarted headscale so OIDC sign-in is on (pre-auth keys keep working)"
else
    log "issuer ${issuer} answers but the headscale restart failed — retrying next minute"
fi
exit 0
