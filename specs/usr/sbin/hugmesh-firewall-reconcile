#!/bin/bash
# hugmesh-firewall-reconcile — Layer 3 (defense-in-depth) host nftables
# backstop for RELEASE_STATE. Renders + loads a SINGLE, independently-owned
# nftables table (hugmesh_release_gate) enforcing the SAME internal-vs-
# public posture as the K8s ingress-class/NetworkPolicy split (gate_env_apps()
# in build-rpi5-stage4.sh / build-x86-host-stage4.sh, Layer 2 / the PRIMARY
# mechanism) — but at the netfilter layer, so an internal-only device still
# refuses public 80/443 even if a K8s manifest or the firewalld zone
# (/etc/firewalld) were ever misconfigured.
#
# OWNS its own table end-to-end (render + `nft -f` apply) rather than
# delegating to a package-provided nftables OpenRC service, mirroring how
# hugmesh-tor-reconcile owns the `tor` daemon's torrc + key custody (OpenRC
# owns the daemon's lifecycle) and
# hugmesh-vpn-reconcile owns hugmesh-egress-vpn's: one script, one
# init.d oneshot, one clearly-scoped nftables table. It NEVER touches any
# OTHER table — firewalld (net-firewall/firewalld, FirewallBackend=nftables)
# runs its own nftables tables independently; this script only ever
# creates/flushes/redefines `table inet hugmesh_release_gate`, so the two
# coexist without either clobbering the other (no `flush ruleset` here).
#
# Runs:
#   * once at boot via the hugmesh-firewall-reconcile OpenRC oneshot,
#     ordered BEFORE containerd/kubelet/tailscaled (see the init.d depend()),
#     so the backstop is live before any pod network / ingress controller
#     comes up.
#   * on a 60s cron (the convergence floor — cron.d/hugmesh-firewall-
#     reconcile) so flipping RELEASE_STATE by hand or writing the
#     /etc/hugmesh/go-live marker on a LIVE device (the future go-live
#     wizard) takes effect without a reboot/reflash.
#
# POSTURE:
#   * RELEASE_STATE=public (baked at /etc/hugmesh/release-state, mirroring
#     the /etc/hugmesh/cluster-domain bake) OR /etc/hugmesh/go-live
#     present (live override) => PUBLIC: 80/443 fall through to the chain's
#     `accept` policy — the K8s ingress-class + firewalld layers remain the
#     actual enforcement point; this backstop simply steps aside.
#   * otherwise (DEFAULT) => INTERNAL: DROP every inbound 80/443 packet whose
#     source is outside the tailnet CGNAT range (100.64.0.0/10 — the SAME CIDR
#     the tier-egress NetworkPolicy allow-lists for the tailnet).
#
# FAIL-CLOSED: any read/render/apply error KEEPS the existing ruleset in
# place; the baked/first-ever posture (no release-state file yet) is
# INTERNAL — deny by default, never allow.
#
# ...BUT "keep the existing ruleset" is only fail-CLOSED when there IS one. When
# this table is ABSENT (first boot, or a kernel that refuses the ruleset — the
# 2026-10-30 x86 ISOs had no CONFIG_NF_TABLES_INET, so even `table inet X {}`
# answered EOPNOTSUPP on every boot) keeping "the existing ruleset" means keeping
# NOTHING: public 80/443 is open and the old exit 0 + "fail-closed" log line said
# the opposite. So a failed load is now split on what is actually live:
#   * our table IS loaded  => keep it (stale but enforcing), WARN, exit 0;
#   * our table is ABSENT  => ERROR naming the node UNPROTECTED, write
#     ${HEALTH_DIR}/${TABLE}.unprotected (the machine-readable "node unhealthy"
#     mark, /run = tmpfs so it is boot-scoped), and exit 1 so the OpenRC oneshot
#     goes red ("failed") instead of [ ok ] — the same contract
#     hugmesh-sunshine-firewall already keeps for its fence.
# `nft` missing entirely is the same ABSENT case. A successful load is confirmed
# with `nft list table` before the mark is cleared; nothing ever `need`s this
# oneshot, so a red result never blocks boot — it only stops lying.

set -uo pipefail

# Paths are overridable ONLY as test seams (tests/scripts/test-x86-boot-firewall-
# snort.sh renders this script against an nft stub and must never write the real
# /etc/nftables.conf when CI runs as root) — the same seam hugmesh-coturn-firewall
# carries for its marker. Boot and cron run with a clean environment.
RELEASE_STATE_FILE="${HUGMESH_RELEASE_STATE_FILE:-/etc/hugmesh/release-state}"
GO_LIVE_MARKER="${HUGMESH_GO_LIVE_MARKER:-/etc/hugmesh/go-live}"
RULESET="${HUGMESH_RELEASE_GATE_RULESET:-/etc/nftables.conf}"
TABLE="hugmesh_release_gate"
LOG_TAG="hugmesh-firewall-reconcile"
HEALTH_DIR="${HUGMESH_FIREWALL_HEALTH_DIR:-/run/hugmesh/firewall-health}"
UNPROTECTED_MARK="${HEALTH_DIR}/${TABLE}.unprotected"

log()  { echo "[${LOG_TAG} $(date -u '+%Y-%m-%dT%H:%M:%SZ')] $*"; command -v logger >/dev/null 2>&1 && logger -t "${LOG_TAG}" -- "$*" 2>/dev/null || true; }
warn() { log "WARNING: $*"; }
error() { log "ERROR: $*"; }

# The node is UNPROTECTED: no table of ours is live. Mark it, say so, fail.
unprotected() {
    mkdir -p "${HEALTH_DIR}" 2>/dev/null || true
    printf 'table=inet %s\nsince=%s\nreason=%s\n' "${TABLE}" "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$(printf '%s' "$*" | tr '\n' ' ')" \
        > "${UNPROTECTED_MARK}" 2>/dev/null || true
    error "NO host firewall backstop is loaded (table inet ${TABLE} is ABSENT) — this node is UNPROTECTED, NOT fail-closed: $* (marked ${UNPROTECTED_MARK})"
    exit 1
}
table_live() { nft list table inet "${TABLE}" >/dev/null 2>&1; }

command -v nft >/dev/null 2>&1 || unprotected "nft not found — cannot (re)load the host firewall backstop"

RELEASE_STATE="internal"
[ -r "${RELEASE_STATE_FILE}" ] && RELEASE_STATE="$(cat "${RELEASE_STATE_FILE}" 2>/dev/null)"
[ -n "${RELEASE_STATE}" ] || RELEASE_STATE="internal"

GO_LIVE="absent"; [ -e "${GO_LIVE_MARKER}" ] && GO_LIVE="present"

DROP_RULE=""
POSTURE="internal (deny public 80/443 except tailnet)"
if [ "${RELEASE_STATE}" = "public" ] || [ "${GO_LIVE}" = "present" ]; then
    POSTURE="public (80/443 open; K8s ingress-class + firewalld enforce)"
else
    DROP_RULE="        tcp dport { 80, 443 } drop  # INTERNAL: refuse everything else"
fi

TMP="$(mktemp)" || {
    table_live || unprotected "mktemp failed before the first ruleset was ever loaded"
    warn "mktemp failed — keeping the existing ruleset (fail-closed)"; exit 0; }
trap 'rm -f "${TMP}"' EXIT
cat > "${TMP}" <<RULES
#!/usr/sbin/nft -f
# Managed by ${LOG_TAG} — DO NOT hand-edit (rewritten every boot + every 60s
# cron tick from ${RELEASE_STATE_FILE} + ${GO_LIVE_MARKER}).
# STATE: release-state=${RELEASE_STATE} go-live=${GO_LIVE} -> ${POSTURE}

# Idempotent per-table reload: create-if-missing, flush, then redefine — never
# touches any OTHER table (firewalld runs its own nftables tables alongside;
# this script owns ONLY table inet ${TABLE}).
table inet ${TABLE} {}
flush table inet ${TABLE}

table inet ${TABLE} {
    chain input {
        type filter hook input priority filter + 10; policy accept;
        # Tailnet (Tailscale CGNAT range) and loopback always admitted —
        # matches the tier-egress NetworkPolicy's tailnet allow-list.
        ip saddr 100.64.0.0/10 tcp dport { 80, 443 } accept
        iifname "lo" accept
${DROP_RULE}
    }
}
RULES

if ! NFT_ERR="$(nft -f "${TMP}" 2>&1)"; then
    # Keeping "the existing ruleset" is only fail-closed when one exists.
    table_live || unprotected "nft -f failed (${NFT_ERR}) and there is no earlier ruleset to keep (wanted posture: ${POSTURE})"
    warn "nft -f failed (${NFT_ERR}) — keeping the existing ruleset (fail-closed; the PREVIOUS table inet ${TABLE} is still loaded)"
    exit 0
fi
# nft's exit status alone is not proof: confirm the table is really live before
# clearing the unhealthy mark (the hugmesh-sunshine-firewall rule).
table_live || unprotected "nft -f reported success but table inet ${TABLE} is not present afterwards"
rm -f "${UNPROTECTED_MARK}" 2>/dev/null || true
cp -f "${TMP}" "${RULESET}" 2>/dev/null || true
log "applied: release-state=${RELEASE_STATE} go-live=${GO_LIVE} -> ${POSTURE}"
exit 0
