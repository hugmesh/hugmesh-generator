#!/bin/bash
# hugmesh-go-live-at-ready — "Go live when ready" (hugmesh-generator#1201): the
# BUILD-TIME go-live effector. A domain opted in at build time goes public on its own
# once this node has booted and the mesh's containers are healthy.
#
# OPERATOR DECISION (2026-11-25, #1201): choosing "Go live when ready" for a domain at
# build time IS sufficient consent for an unattended go-live of THAT domain. Every
# other domain keeps the interactive confirmation (the Studio/CLI/ncurses front-ends).
#
# It is the third unattended caller of the ONE canonical driver, after
# hugmesh-go-live-reconcile (the web-UI intent). Like that agent it NEVER writes the
# posture marker itself: it runs `hugmesh-go-live plan` (the provider's artifacts,
# kept under the state dir) and then `hugmesh-go-live commit --persist-public -y`, so
# every refusal the driver owns (unknown provider, the onion refusal, a failed emit)
# still applies.
#
# INPUT: /etc/hugmesh/domain-go-live, baked by the builders from
#   --domain-go-live <domain>=<provider>  (scripts/_domain-golive-lib.sh)
# one `<domain>=<provider>` line per opted-in domain. Absent or empty = this agent does
# nothing at all (every image built without the flag).
#
# WHERE IT ACTS: only on the PUBLIC EDGE node — the node the public ingress-nginx
# (specs/cluster/apps/10-ingress-nginx.yaml) is pinned to, label
# hugmesh.net/backend=true. The pki node's internal ingress also binds :443, so "has a
# :443 listener" is NOT the test. Any other node records `not-edge` and stays internal.
#
# WHEN: a domain is READY when BOTH hold, and have held for GLW_STABLE_SECONDS (120 s):
#   1. every pod in every namespace is Running with all containers ready (or
#      Succeeded), and there is at least one pod;
#   2. the domain's front door answers through this node's ingress:
#      `curl --resolve <domain>:443:127.0.0.1 https://<domain>/` returns 100-499.
#
# ONCE PER DOMAIN: after a successful commit the domain's state is `applied` and this
# agent never touches it again — so a person who later rolls back (hugmesh-go-live
# rollback, the console) is not overridden. A failing plan/commit is retried on the
# next run, up to GLW_MAX_ATTEMPTS (5); then the state is `gave-up` with the reason.
#
# STATE: /var/lib/hugmesh/go-live-at-ready/<domain>.state (key=value: status, reason,
# ready_since, attempts, applied_at). `hugmesh-go-live-at-ready --status` prints them.
# Logged only when a domain's status or reason CHANGES, so a waiting domain does not
# write a line every minute.
#
# TOKENS: a provider secret the build supplied (the Studio's API-key field -> the edge
# role's KEYS stick -> provision_go_live_tokens) is at <TOKEN_DIR>/<domain>.token and is
# passed to `plan --token-file`; the driver stores it where the provider reads it.
#
# NOT DONE HERE (docs/GO-LIVE-WHEN-READY.md): provider-side setup that needs a person
# (registrar DNS for byo-domain, creating the tunnel itself) is assumed done, exactly as
# hugmesh-go-live-reconcile assumes for a web intent. And the posture flip is host-wide:
# a domain NOT opted in has no public DNS from this, but the public ingress does not yet
# refuse it by Host header.
#
# ── ENV SEAMS (tests) ─────────────────────────────────────────────────────────────
#   GLW_INTENT_FILE     (def ${GL_ETC_HUGMESH:-/etc/hugmesh}/domain-go-live)
#   GLW_STATE_DIR       (def /var/lib/hugmesh/go-live-at-ready)
#   GLW_DRIVER          (def /usr/sbin/hugmesh-go-live)
#   GLW_KUBECTL         (def kubectl)
#   GLW_KUBECONFIG      (def /etc/kubernetes/admin.conf, else kubelet.conf)
#   GLW_NODE_NAME       (def `hostname`)
#   GLW_CURL            (def curl)
#   GLW_PROBE_ADDR      (def 127.0.0.1)
#   GLW_STABLE_SECONDS  (def 120)
#   GLW_MAX_ATTEMPTS    (def 5)
#   GLW_TOKEN_DIR       (def ${GL_ETC_HUGMESH:-/etc/hugmesh}/go-live-tokens) — <domain>.token
#   GLW_NOW             epoch override (tests)
#   GLW_SYSLOG          0 = do not also send log lines to syslog (tests)
#   GL_ETC_HUGMESH      passed through to the driver

set -uo pipefail

ETC="${GL_ETC_HUGMESH:-/etc/hugmesh}"
INTENT_FILE="${GLW_INTENT_FILE:-${ETC}/domain-go-live}"
STATE_DIR="${GLW_STATE_DIR:-/var/lib/hugmesh/go-live-at-ready}"
DRIVER="${GLW_DRIVER:-/usr/sbin/hugmesh-go-live}"
KUBECTL="${GLW_KUBECTL:-kubectl}"
CURL="${GLW_CURL:-curl}"
PROBE_ADDR="${GLW_PROBE_ADDR:-127.0.0.1}"
STABLE_SECONDS="${GLW_STABLE_SECONDS:-120}"
MAX_ATTEMPTS="${GLW_MAX_ATTEMPTS:-5}"
TOKEN_DIR="${GLW_TOKEN_DIR:-${ETC}/go-live-tokens}"
LOG_TAG="hugmesh-go-live-at-ready"
EDGE_LABEL="hugmesh.net/backend"

DOMAIN_RE='^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)+$'
PROVIDER_RE='^[a-z][a-z0-9-]{0,40}$'

log()  {
    echo "[${LOG_TAG} $(date -u '+%Y-%m-%dT%H:%M:%SZ')] $*"
    [ "${GLW_SYSLOG:-1}" = 1 ] && command -v logger >/dev/null 2>&1 && logger -t "${LOG_TAG}" -- "$*" 2>/dev/null
    return 0
}
have() { command -v "$1" >/dev/null 2>&1; }
now()  { if [ -n "${GLW_NOW:-}" ]; then echo "${GLW_NOW}"; else date -u +%s; fi; }

kubeconfig() {
    if [ -n "${GLW_KUBECONFIG:-}" ]; then echo "${GLW_KUBECONFIG}"; return; fi
    if [ -r /etc/kubernetes/admin.conf ]; then echo /etc/kubernetes/admin.conf; return; fi
    echo /etc/kubernetes/kubelet.conf
}
kc() { KUBECONFIG="$(kubeconfig)" "${KUBECTL}" "$@"; }

# ── per-domain state (key=value) ─────────────────────────────────────────────────
state_file() { echo "${STATE_DIR}/$1.state"; }
state_get() {   # DOMAIN KEY
    local f; f="$(state_file "$1")"
    [ -r "${f}" ] || return 0
    sed -n "s/^$2=//p" "${f}" | head -1
}
# state_put DOMAIN status reason [ready_since] [attempts] [applied_at] — logs on change.
state_put() {
    local dom="$1" st="$2" why="$3" since="${4:-}" att="${5:-}" at="${6:-}"
    local old_st old_why f tmp
    old_st="$(state_get "${dom}" status)"; old_why="$(state_get "${dom}" reason)"
    f="$(state_file "${dom}")"
    tmp="$(mktemp "${f}.tmp.XXXXXX" 2>/dev/null)" || { log "WARNING: cannot write ${f}"; return 0; }
    {
        echo "status=${st}"
        echo "reason=${why}"
        [ -n "${since}" ] && echo "ready_since=${since}"
        [ -n "${att}" ] && echo "attempts=${att}"
        [ -n "${at}" ] && echo "applied_at=${at}"
        true
    } > "${tmp}" && mv -f "${tmp}" "${f}"
    if [ "${st}" != "${old_st}" ] || [ "${why}" != "${old_why}" ]; then
        log "${dom}: ${st}${why:+ — ${why}}"
    fi
}

# ── is THIS node the public edge? ────────────────────────────────────────────────
# Echoes "" when it is, else the reason it is not (or cannot be told).
edge_refusal() {
    have "${KUBECTL}" || { echo "kubectl is not installed here, so this node cannot be identified as the public edge"; return; }
    local node val
    node="${GLW_NODE_NAME:-$(hostname 2>/dev/null)}"
    val="$(kc get node "${node}" -o "jsonpath={.metadata.labels.hugmesh\.net/backend}" 2>/dev/null)" \
        || { echo "kubectl could not read node ${node} (cluster not up yet?)"; return; }
    [ "${val}" = "true" ] || echo "node ${node} is not the public edge (no ${EDGE_LABEL}=true label); only the edge node goes live"
}

# ── readiness ────────────────────────────────────────────────────────────────────
# Echoes "" when every pod is ready, else why not.
pods_refusal() {
    local rows bad total first
    rows="$(kc get pods -A --no-headers \
        -o 'custom-columns=NS:.metadata.namespace,NAME:.metadata.name,PHASE:.status.phase,READY:.status.containerStatuses[*].ready' \
        2>/dev/null)" || { echo "kubectl get pods failed"; return; }
    total="$(printf '%s\n' "${rows}" | grep -c . || true)"
    [ "${total}" -gt 0 ] || { echo "no pods are scheduled yet"; return; }
    # A row is fine when Succeeded, or Running with every READY value "true".
    bad="$(printf '%s\n' "${rows}" | awk 'NF {
        ok = 0
        if ($3 == "Succeeded") ok = 1
        else if ($3 == "Running") { n = split($4, r, ","); ok = (n > 0); for (i = 1; i <= n; i++) if (r[i] != "true") ok = 0 }
        if (!ok) print $1 "/" $2 " (" $3 ")"
    }')"
    if [ -n "${bad}" ]; then
        first="$(printf '%s\n' "${bad}" | head -1)"
        echo "$(printf '%s\n' "${bad}" | grep -c .) of ${total} pods not ready yet, e.g. ${first}"
    fi
}

# Echoes "" when the domain's front door answers through this node's ingress.
door_refusal() {
    local dom="$1" code
    have "${CURL}" || { echo "curl is not installed"; return; }
    code="$("${CURL}" -sk -o /dev/null -w '%{http_code}' --max-time 10 \
        --resolve "${dom}:443:${PROBE_ADDR}" "https://${dom}/" 2>/dev/null)" || true
    case "${code}" in
        1??|2??|3??|4??) ;;
        000|"") echo "https://${dom}/ does not answer on this node's ingress yet" ;;
        *) echo "https://${dom}/ answers HTTP ${code} through this node's ingress" ;;
    esac
}

# ── one domain ──────────────────────────────────────────────────────────────────
go_live() {   # DOMAIN PROVIDER ATTEMPTS
    local dom="$1" prov="$2" att="$3" out
    out="${STATE_DIR}/${dom}.plan"
    mkdir -p "${out}" 2>/dev/null || true
    # The provider token, when the build supplied one (KEYS/go-live/<domain>.token,
    # installed 0600 by provision_go_live_tokens). Only its PATH goes on argv.
    local tok=() tf="${TOKEN_DIR}/${dom}.token"
    [ -r "${tf}" ] && tok=(--token-file "${tf}")
    if ! bash "${DRIVER}" plan --provider "${prov}" --domain "${dom}" --out-dir "${out}" "${tok[@]}" \
            >>"${STATE_DIR}/driver.log" 2>&1; then
        echo "hugmesh-go-live plan failed for provider ${prov} (see ${STATE_DIR}/driver.log)"; return 1
    fi
    if ! bash "${DRIVER}" commit --provider "${prov}" --domain "${dom}" --persist-public -y \
            >>"${STATE_DIR}/driver.log" 2>&1; then
        echo "hugmesh-go-live commit failed for provider ${prov} (see ${STATE_DIR}/driver.log)"; return 1
    fi
    return 0
}

reconcile_domain() {   # DOMAIN PROVIDER EDGE_REFUSAL
    local dom="$1" prov="$2" edge_why="$3" st why since att t
    st="$(state_get "${dom}" status)"
    case "${st}" in applied|gave-up|refused) return 0 ;; esac

    if [ "${prov}" = "tor-onion" ]; then
        state_put "${dom}" refused "a Tor address needs no public flip; tor-onion cannot go live when ready"
        return 0
    fi
    if [ -n "${edge_why}" ]; then
        state_put "${dom}" not-edge "${edge_why}"; return 0
    fi

    why="$(pods_refusal)"
    [ -z "${why}" ] && why="$(door_refusal "${dom}")"
    t="$(now)"
    att="$(state_get "${dom}" attempts)"; att="${att:-0}"
    if [ -n "${why}" ]; then
        state_put "${dom}" waiting "${why}" "" "${att}"; return 0
    fi

    since="$(state_get "${dom}" ready_since)"
    if [ -z "${since}" ]; then
        state_put "${dom}" settling "ready; going live after ${STABLE_SECONDS}s of staying ready" "${t}" "${att}"
        return 0
    fi
    if [ $(( t - since )) -lt "${STABLE_SECONDS}" ]; then
        return 0
    fi

    att=$(( att + 1 ))
    if why="$(go_live "${dom}" "${prov}" "${att}")"; then
        state_put "${dom}" applied "went live via ${prov}" "${since}" "${att}" "$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
    elif [ "${att}" -ge "${MAX_ATTEMPTS}" ]; then
        state_put "${dom}" gave-up "${why} (attempt ${att} of ${MAX_ATTEMPTS}; staying internal)" "" "${att}"
    else
        state_put "${dom}" waiting "${why} (attempt ${att} of ${MAX_ATTEMPTS}; retrying)" "" "${att}"
    fi
}

print_status() {
    [ -s "${INTENT_FILE}" ] || { echo "no domain is set to go live when ready (${INTENT_FILE} absent)"; return 0; }
    local dom prov
    while IFS='=' read -r dom prov; do
        case "${dom}" in ''|\#*) continue ;; esac
        printf '%s via %s: %s%s\n' "${dom}" "${prov}" "$(state_get "${dom}" status)" \
            "$(r="$(state_get "${dom}" reason)"; [ -n "${r}" ] && printf ' — %s' "${r}")"
    done < "${INTENT_FILE}"
}

main() {
    if [ "${1:-}" = "--status" ]; then print_status; return 0; fi
    [ -s "${INTENT_FILE}" ] || return 0
    mkdir -p "${STATE_DIR}" 2>/dev/null || { log "WARNING: cannot create ${STATE_DIR}"; return 0; }
    chmod 0700 "${STATE_DIR}" 2>/dev/null || true
    exec 9>"${STATE_DIR}/.lock"
    if have flock && ! flock -n 9; then return 0; fi

    local edge_why="" edge_known=0 dom prov
    while IFS='=' read -r dom prov; do
        dom="${dom//[[:space:]]/}"; prov="${prov//[[:space:]]/}"
        case "${dom}" in ''|\#*) continue ;; esac
        if ! [[ "${dom}" =~ ${DOMAIN_RE} ]] || ! [[ "${prov}" =~ ${PROVIDER_RE} ]]; then
            log "WARNING: ignoring malformed line in ${INTENT_FILE}: '${dom}=${prov}'"; continue
        fi
        case "$(state_get "${dom}" status)" in applied|gave-up|refused) continue ;; esac
        if [ "${edge_known}" = 0 ]; then edge_why="$(edge_refusal)"; edge_known=1; fi
        reconcile_domain "${dom}" "${prov}" "${edge_why}"
    done < "${INTENT_FILE}"
    return 0
}

main "$@"
