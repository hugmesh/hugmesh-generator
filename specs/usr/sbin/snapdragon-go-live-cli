#!/bin/bash
# snapdragon-go-live-cli — the THIN CLI front-end for the go-live wizard.
#
# It carries NO wizard logic of its own: it is a guided, human-friendly shell
# over the shared driver (snapdragon-go-live). Every real action — reading
# posture, listing providers, emitting artifacts, tripping the marker — is a
# driver subcommand. This is exactly the seam the DEFERRED ncurses/Studio/web
# front-ends will mirror: a UI that only ever calls `snapdragon-go-live <verb>`.
# Mirrors how image-gen exposes one shared driver behind thin per-interface UIs.
#
# MODES:
#   snapdragon-go-live-cli                 -> guided interactive wizard (menu)
#   snapdragon-go-live-cli <verb> [args…]  -> straight pass-through to the driver
#                                             (status | list | plan | commit | rollback)
#
# ENV SEAM: GL_DRIVER overrides the driver path (default: sibling script, else PATH).

set -uo pipefail

# Locate the shared driver: explicit seam -> sibling of this script -> PATH.
_self_dir="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" 2>/dev/null && pwd)"
DRIVER="${GL_DRIVER:-}"
if [ -z "${DRIVER}" ]; then
    if [ -x "${_self_dir}/snapdragon-go-live" ]; then
        DRIVER="${_self_dir}/snapdragon-go-live"
    elif command -v snapdragon-go-live >/dev/null 2>&1; then
        DRIVER="$(command -v snapdragon-go-live)"
    else
        echo "error: shared driver 'snapdragon-go-live' not found (set GL_DRIVER)" >&2
        exit 1
    fi
fi

drv() { bash "${DRIVER}" "$@"; }

# ── Pass-through: any recognised verb goes straight to the driver ────────────────
case "${1:-}" in
    status|list|providers|ls|plan|preview|emit|commit|go-live|rollback|-h|--help|help)
        exec bash "${DRIVER}" "$@"
        ;;
esac

# ── Guided interactive wizard (no args) ──────────────────────────────────────────
if [ ! -t 0 ]; then
    echo "snapdragon-go-live-cli: guided mode needs a TTY. For scripting, call the driver" >&2
    echo "directly, e.g. 'snapdragon-go-live plan --provider byo-domain'. See --help." >&2
    exit 1
fi

echo "============================================================"
echo "  Snapdragon — Superadmin GO-LIVE wizard (v1)"
echo "  Preview-first. Nothing goes live without an explicit step."
echo "============================================================"
echo
echo "-- current posture --"
drv status
echo
echo "-- available edge providers --"
drv list
echo

# Build the provider index by asking the driver's list (data source of truth).
mapfile -t _ids < <(drv list | awk 'NR>1 && $1 !~ /^$/ && $1 !~ /^Fully/ && $1 !~ /^TODO/ {print $1}' | grep -E '^[a-z0-9-]+$')
[ "${#_ids[@]}" -gt 0 ] || { echo "error: no providers returned by the driver" >&2; exit 1; }

echo "Select a provider:"
i=1; for id in "${_ids[@]}"; do echo "  ${i}) ${id}"; i=$((i+1)); done
read -r -p "provider number [1-${#_ids[@]}]: " choice
case "${choice}" in
    ''|*[!0-9]*) echo "not a number — aborting." >&2; exit 1 ;;
esac
[ "${choice}" -ge 1 ] && [ "${choice}" -le "${#_ids[@]}" ] || { echo "out of range — aborting." >&2; exit 1; }
provider="${_ids[$((choice-1))]}"

# Optional autofill target for the record set (public-DNS providers).
read -r -p "ingress IPv4 to point records at (blank to skip / use placeholders): " ip
plan_args=(plan --provider "${provider}")
[ -n "${ip}" ] && plan_args+=(--ingress-ip "${ip}")

echo
echo "-- PLAN (dry-run; posture is NOT touched) --"
drv "${plan_args[@]}"
echo

echo "Review the artifacts + deep-links above and apply them at your edge/registrar."
read -r -p "Trip GO-LIVE now (writes /etc/snapdragon/go-live)? [y/N] " golive
case "${golive}" in
    y|Y|yes|YES)
        read -r -p "Also persist release-state=public (survives a marker delete)? [y/N] " persist
        commit_args=(commit --provider "${provider}" --yes)
        case "${persist}" in y|Y|yes|YES) commit_args+=(--persist-public) ;; esac
        drv "${commit_args[@]}"
        ;;
    *)
        echo "Left INTERNAL. When ready: snapdragon-go-live commit --provider ${provider}"
        echo "Rollback anytime: snapdragon-go-live rollback"
        ;;
esac
