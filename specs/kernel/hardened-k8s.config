# Kernel config fragment — hardened + Kubernetes + RPi 5
#
# Applied on top of the board defconfig via scripts/config.
# Format: one "scripts/config" argument set per line.
# Lines starting with # are comments and are skipped.
#
# Edit this file to add or remove kernel options.

# ── RPi 5 hardware (RP1 south-bridge, PCIe, NVMe) ─────────────────
enable CONFIG_PCIE_BRCMSTB
enable CONFIG_NVME_CORE
enable CONFIG_BLK_DEV_NVME
enable CONFIG_RP1_PIO
enable CONFIG_DRM_V3D
enable CONFIG_DRM_VC4
enable CONFIG_VIDEO_RP1_CFE
enable CONFIG_I2C_DESIGNWARE_PLATFORM
enable CONFIG_SPI_DW_MMIO
enable CONFIG_PINCTRL_RP1
enable CONFIG_SENSORS_RP1_ADC
enable CONFIG_USB_XHCI_PCI
module CONFIG_USB_XHCI_HCD

# ── Hardened kernel ────────────────────────────────────────────────
enable CONFIG_SECURITY
enable CONFIG_SECURITY_APPARMOR
enable CONFIG_DEFAULT_SECURITY_APPARMOR
set-str CONFIG_LSM "apparmor,integrity"
enable CONFIG_SECURITY_APPARMOR_BOOTPARAM_VALUE
enable CONFIG_AUDIT
enable CONFIG_AUDITSYSCALL
enable CONFIG_SECCOMP
enable CONFIG_SECCOMP_FILTER
enable CONFIG_STACKPROTECTOR
enable CONFIG_STACKPROTECTOR_STRONG
enable CONFIG_FORTIFY_SOURCE
enable CONFIG_HARDENED_USERCOPY
enable CONFIG_SLAB_FREELIST_RANDOM
enable CONFIG_SLAB_FREELIST_HARDENED
enable CONFIG_SHUFFLE_PAGE_ALLOCATOR
enable CONFIG_RANDOMIZE_BASE
enable CONFIG_RANDOMIZE_MEMORY
enable CONFIG_INIT_ON_ALLOC_DEFAULT_ON
disable CONFIG_INIT_ON_FREE_DEFAULT_ON
enable CONFIG_PAGE_TABLE_ISOLATION
enable CONFIG_RODATA_FULL_DEFAULT_ENABLED
enable CONFIG_ARM64_BTI
enable CONFIG_ARM64_PTR_AUTH
enable CONFIG_ARM64_MTE
enable CONFIG_STRICT_KERNEL_RWX
enable CONFIG_STRICT_MODULE_RWX
disable CONFIG_ACPI_CUSTOM_METHOD
disable CONFIG_COMPAT_BRK
disable CONFIG_DEVKMEM
disable CONFIG_PROC_KCORE
enable CONFIG_BUG_ON_DATA_CORRUPTION
set-val CONFIG_DEFAULT_MMAP_MIN_ADDR 65536
set-val CONFIG_PANIC_TIMEOUT 10

# ── Cgroup v2 (Kubernetes) ────────────────────────────────────────
enable CONFIG_CGROUPS
enable CONFIG_CGROUP_FREEZER
enable CONFIG_CGROUP_PIDS
enable CONFIG_CGROUP_DEVICE
enable CONFIG_CGROUP_CPUACCT
enable CONFIG_CGROUP_PERF
enable CONFIG_CGROUP_SCHED
enable CONFIG_CGROUP_BPF
enable CONFIG_MEMCG
enable CONFIG_BLK_CGROUP
enable CONFIG_CGROUP_WRITEBACK
enable CONFIG_CGROUP_HUGETLB
enable CONFIG_CPUSETS
enable CONFIG_PROC_PID_CPUSET
enable CONFIG_CGROUP_NET_PRIO
enable CONFIG_CGROUP_NET_CLASSID
enable CONFIG_FAIR_GROUP_SCHED
enable CONFIG_CFS_BANDWIDTH

# ── Namespaces (containers) ────────────────────────────────────────
enable CONFIG_NAMESPACES
enable CONFIG_UTS_NS
enable CONFIG_IPC_NS
enable CONFIG_USER_NS
enable CONFIG_PID_NS
enable CONFIG_NET_NS
enable CONFIG_CGROUP_NS

# ── Networking (K8s CNI / kube-proxy / IPVS) ──────────────────────
enable CONFIG_NETFILTER
enable CONFIG_NETFILTER_ADVANCED
enable CONFIG_NF_CONNTRACK
enable CONFIG_NF_NAT
module CONFIG_NF_NAT_MASQUERADE
enable CONFIG_NETFILTER_XTABLES
module CONFIG_NETFILTER_XT_MATCH_COMMENT
module CONFIG_NETFILTER_XT_MATCH_MULTIPORT
module CONFIG_NETFILTER_XT_MATCH_STATISTIC
module CONFIG_NETFILTER_XT_MATCH_MARK
module CONFIG_NETFILTER_XT_MATCH_CONNTRACK
module CONFIG_NETFILTER_XT_MATCH_ADDRTYPE
module CONFIG_NETFILTER_XT_TARGET_MARK
module CONFIG_NETFILTER_XT_TARGET_MASQUERADE
module CONFIG_NETFILTER_XT_TARGET_REDIRECT
enable CONFIG_IP_NF_IPTABLES
enable CONFIG_IP_NF_FILTER
enable CONFIG_IP_NF_NAT
enable CONFIG_IP_NF_MANGLE
enable CONFIG_IP6_NF_IPTABLES
enable CONFIG_IP6_NF_FILTER
enable CONFIG_IP6_NF_NAT
enable CONFIG_IP6_NF_MANGLE
enable CONFIG_NF_TABLES
module CONFIG_NFT_NAT
module CONFIG_NFT_MASQ
module CONFIG_NFT_CT
enable CONFIG_BRIDGE
enable CONFIG_BRIDGE_NETFILTER
enable CONFIG_VLAN_8021Q
enable CONFIG_VXLAN
enable CONFIG_IP_VS
enable CONFIG_IP_VS_NFCT
module CONFIG_IP_VS_RR
module CONFIG_IP_VS_WRR
module CONFIG_IP_VS_SH
enable CONFIG_NET_SCH_HTB
enable CONFIG_NET_CLS_CGROUP
enable CONFIG_DUMMY
enable CONFIG_MACVLAN
enable CONFIG_IPVLAN
enable CONFIG_VETH
enable CONFIG_NET_L3_MASTER_DEV

# ── Overlay / container filesystem ─────────────────────────────────
enable CONFIG_OVERLAY_FS
enable CONFIG_OVERLAY_FS_REDIRECT_DIR
enable CONFIG_OVERLAY_FS_INDEX
enable CONFIG_FUSE_FS

# ── BPF (Cilium CNI / eBPF) ───────────────────────────────────────
enable CONFIG_BPF
enable CONFIG_BPF_SYSCALL
enable CONFIG_BPF_JIT
enable CONFIG_BPF_JIT_ALWAYS_ON
enable CONFIG_HAVE_EBPF_JIT
enable CONFIG_BPF_EVENTS
enable CONFIG_CGROUP_BPF
enable CONFIG_XDP_SOCKETS

# ── Misc container requirements ───────────────────────────────────
enable CONFIG_POSIX_MQUEUE
enable CONFIG_KEYS
enable CONFIG_CRYPTO_USER_API_HASH
enable CONFIG_CRYPTO_USER_API_SKCIPHER

# ── TUN/TAP (tailscale / headscale userspace networking) ──────────
enable CONFIG_TUN

# ── /dev auto-population (stage4 ships no static device nodes) ─────
enable CONFIG_DEVTMPFS
enable CONFIG_DEVTMPFS_MOUNT

# ── USB mass storage + FAT (read the USB "KEYS" provisioning stick) ─
enable CONFIG_USB_STORAGE
enable CONFIG_USB_UAS
enable CONFIG_SCSI
enable CONFIG_BLK_DEV_SD
enable CONFIG_FAT_FS
enable CONFIG_VFAT_FS
enable CONFIG_MSDOS_FS
enable CONFIG_EXFAT_FS
enable CONFIG_NLS_CODEPAGE_437
enable CONFIG_NLS_ISO8859_1
enable CONFIG_NLS_UTF8
enable CONFIG_EXT4_FS

# ── Virtualization / QEMU `-M virt` integration testing ───────────
# Built-in (=y) so the kernel can mount a virtio rootfs with no initramfs.
# Harmless on real RPi 5 hardware; enables booting the exact same Image
# under qemu-system-aarch64 for tests/qemu.
enable CONFIG_PCI_HOST_GENERIC
enable CONFIG_PCI_HOST_COMMON
enable CONFIG_VIRTIO
enable CONFIG_VIRTIO_MENU
enable CONFIG_VIRTIO_PCI
enable CONFIG_VIRTIO_MMIO
enable CONFIG_VIRTIO_BLK
enable CONFIG_VIRTIO_NET
enable CONFIG_VIRTIO_CONSOLE
enable CONFIG_VIRTIO_BALLOON
enable CONFIG_SCSI_VIRTIO
enable CONFIG_SERIAL_AMBA_PL011
enable CONFIG_SERIAL_AMBA_PL011_CONSOLE
enable CONFIG_RTC_DRV_PL031
enable CONFIG_NET_9P
enable CONFIG_NET_9P_VIRTIO
enable CONFIG_9P_FS
