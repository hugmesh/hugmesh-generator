# Kernel config fragment — the container / Kubernetes NODE data plane, shared by
# every mainline-kernel ARM builder that builds a cluster node role.
#
# Applied by build-orangepi5-stage4.sh and build-orangepi4-lts-stage4.sh ON TOP of
# their board fragment (hardened-desktop.config, which carries the fleet hardening
# posture: SELinux, lockdown, yama, audit, ASLR/slab hardening) and ONLY for a node
# role (pki / backend / frontend / omnibus). Merged with
# scripts/kconfig/merge_config.sh, so the format is a standard .config fragment
# (CONFIG_FOO=y), NOT the scripts/config `enable FOO` form the Raspberry Pi kernel
# uses.
#
# What is in here is the board-agnostic subset of the two node fragments that
# already exist — the container/k8s section of specs-jetson/kernel/hardened-node.config
# and the cgroup / namespace / netfilter / nftables / overlay / ipvs / bridge part of
# specs-rpi5/kernel/hardened-k8s.config — so the Orange Pi nodes ask the kernel for
# what the Pi and Jetson nodes already ask for. Hardening is deliberately NOT
# repeated here (the board fragment owns it; the builder's SELinux/LSM guard checks
# it after the merge). EXPERIMENTAL: no Orange Pi node kernel has been booted.

# ── Namespaces + cgroups (containerd / kubelet) ──────────────────────
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_USER_NS=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_SCHED=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_BPF=y
CONFIG_CGROUP_PERF=y
CONFIG_CGROUP_HUGETLB=y
CONFIG_CGROUP_NET_PRIO=y
CONFIG_CGROUP_NET_CLASSID=y
CONFIG_CGROUP_WRITEBACK=y
CONFIG_HUGETLBFS=y
CONFIG_MEMCG=y
CONFIG_BLK_CGROUP=y
CONFIG_CPUSETS=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_POSIX_MQUEUE=y
CONFIG_KEYS=y

# ── Container filesystems ───────────────────────────────────────────
CONFIG_OVERLAY_FS=y
CONFIG_OVERLAY_FS_REDIRECT_DIR=y
CONFIG_OVERLAY_FS_INDEX=y
CONFIG_FUSE_FS=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y

# ── Pod networking: bridge, veth, vxlan (Calico), vlans ──────────────
CONFIG_BRIDGE=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_VLAN_8021Q=y
CONFIG_VETH=y
CONFIG_VXLAN=y
CONFIG_MACVLAN=y
CONFIG_IPVLAN=y
CONFIG_DUMMY=y
CONFIG_NET_L3_MASTER_DEV=y
CONFIG_NET_SCH_HTB=y
CONFIG_NET_CLS_CGROUP=y

# ── Netfilter (kube-proxy, Calico, the hugmesh nftables backstop) ────
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_NAT=y
CONFIG_NF_NAT_MASQUERADE=y
CONFIG_IPV6=y
CONFIG_NETFILTER_XTABLES=y
# LEGACY iptables core. From kernel 6.16 the legacy x_tables are split out: the
# IPv4/IPv6 filter / nat / mangle tables depend on IP{,6}_NF_IPTABLES_LEGACY, which
# depend on NETFILTER_XTABLES_LEGACY. The Orange Pi sysroot accepts ~arm64, so it
# builds gentoo-sources 7.x; without these three, olddefconfig silently drops
# IP_NF_FILTER / IP_NF_NAT / IP_NF_MANGLE / IP6_NF_* and kube-proxy, Calico and the
# CNI portmap/bridge plugins cannot install a single rule. On kernels before 6.16
# the symbols do not exist and olddefconfig drops these lines harmlessly. Same three
# lines as specs-rpi5/kernel/hardened-k8s.config.
CONFIG_NETFILTER_XTABLES_LEGACY=y
CONFIG_IP_NF_IPTABLES_LEGACY=y
CONFIG_IP6_NF_IPTABLES_LEGACY=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_COMMENT=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_MATCH_MARK=y
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=y
CONFIG_NETFILTER_XT_MATCH_STATISTIC=y
CONFIG_NETFILTER_XT_TARGET_MARK=y
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y
CONFIG_NETFILTER_XT_TARGET_REDIRECT=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_MANGLE=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP6_NF_FILTER=y
CONFIG_IP6_NF_NAT=y
CONFIG_IP6_NF_MANGLE=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_CT=y
# iptables built with USE=nftables (specs-rpi5/portage/package.use/kubernetes, which
# a node build carries) is iptables-nft: its xt matches/targets run through
# nft_compat. Without it every `iptables -m comment ...` rule a CNI writes fails.
CONFIG_NFT_COMPAT=y
# REJECT targets. kube-proxy (iptables mode, the kubeadm default) writes
# `-j REJECT` for every Service with no ready endpoints, and iptables-restore is
# all-or-nothing: one REJECT rule the kernel cannot load fails the WHOLE Service
# ruleset. The arm64 defconfig leaves these off; the Pi 5 kernel ships them (=m).
CONFIG_IP_NF_TARGET_REJECT=y
CONFIG_IP6_NF_TARGET_REJECT=y
CONFIG_NFT_REJECT=y
# ipset + the xt_set match. Calico's iptables dataplane builds its policy
# selectors and the NAT-outgoing pool match out of ipsets; without these Calico
# cannot program a single network policy. Set types are the ones Felix creates.
CONFIG_NETFILTER_NETLINK=y
CONFIG_IP_SET=y
CONFIG_IP_SET_HASH_IP=y
CONFIG_IP_SET_HASH_NET=y
CONFIG_IP_SET_HASH_IPPORT=y
CONFIG_IP_SET_HASH_NETPORT=y
CONFIG_IP_SET_HASH_NETNET=y
CONFIG_IP_SET_BITMAP_PORT=y
CONFIG_IP_SET_LIST_SET=y
CONFIG_NETFILTER_XT_SET=y
# conntrack over netlink: the conntrack CLI (net-firewall/conntrack-tools, in
# packages-node-host.list) and kube-proxy's stale-UDP-entry cleanup need it.
CONFIG_NF_CT_NETLINK=y
CONFIG_IP_VS=y
CONFIG_IP_VS_NFCT=y
CONFIG_IP_VS_RR=y
CONFIG_IP_VS_WRR=y
CONFIG_IP_VS_SH=y

# ── BPF (Calico / cgroup-bpf device control) ─────────────────────────
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
# No CONFIG_BPF_EVENTS: it needs KPROBE_EVENTS/UPROBE_EVENTS, i.e. FTRACE, which this
# board's arm64 defconfig + hardened-desktop.config leave off. Not turned on here
# (tracing is attack surface); kube-proxy, Calico and the CNI plugins do not need it.

# ── tun + WireGuard (tailscale mesh + egress VPN) ───────────────────
CONFIG_TUN=y
CONFIG_WIREGUARD=y
