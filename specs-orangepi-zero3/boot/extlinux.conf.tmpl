# extlinux.conf — U-Boot distro-boot config for the Orange Pi Zero 3 (Allwinner
# H618). U-Boot's distro-boot scans the first partition of whatever block
# device it finds (microSD/USB) for /extlinux/extlinux.conf and boots the entry
# below — the SAME mechanism build-frite-stage4.sh / build-orangepi5-stage4.sh
# use (NOT the RPi5 config.txt/cmdline.txt model, and NOT UEFI/GRUB).
#
# Variables substituted at build time (render_template in
# build-orangepi-zero3-stage4.sh):
#   @@OPIZ3_KERNEL_IMG@@   Kernel image filename in /boot (e.g. Image)
#   @@OPIZ3_DTB@@          Board DTB path under /dtb (e.g.
#                          allwinner/sun50i-h618-orangepi-zero3.dtb)
#   @@OPIZ3_INITRD_LINE@@  INITRD line (live/installer/encrypted-disk boot) or a
#                          comment (plaintext installed system)
#   @@BRAND_TITLE@@        Menu label brand
#
# IMPORTANT: boot the DTB that ships WITH THE KERNEL (copied to /boot/dtb by the
# builder), NOT any DTB baked into U-Boot itself.

DEFAULT orangepizero3
TIMEOUT 20
MENU TITLE @@BRAND_TITLE@@ — Orange Pi Zero 3 (headless appliance)

LABEL orangepizero3
    MENU LABEL @@BRAND_TITLE@@ headless appliance
    LINUX /@@OPIZ3_KERNEL_IMG@@
    FDT /dtb/@@OPIZ3_DTB@@
@@OPIZ3_INITRD_LINE@@
    APPEND @@OPIZ3_APPEND@@

# ── SELinux entries (#863 refute, blockers 3 and 4) ─────────────────────────────
# DEFAULT above is unchanged; these two are picked from the boot menu on the serial
# console (U-Boot shows it because of the MENU TITLE line; the Jetson's L4TLauncher
# lists every LABEL). Same kernel, FDT, initrd and cmdline as the default, plus ONE
# token: the kernel takes the LAST enforcing=, and libselinux lets it override
# /etc/selinux/config.
#   orangepizero3-selinux-rescue          enforcing=0  boot a node whose enforcing policy
#                                   breaks its boot (permissive, for this boot only)
#   orangepizero3-selinux-enforcing-test  enforcing=1  try enforcing for ONE boot without
#                                   touching /etc/selinux/config
# The installers rewrite root= with a per-line sed, so these APPEND lines get the
# installed root= exactly like the default's.

LABEL orangepizero3-selinux-rescue
    MENU LABEL @@BRAND_TITLE@@ headless appliance (SELinux permissive rescue)
    LINUX /@@OPIZ3_KERNEL_IMG@@
    FDT /dtb/@@OPIZ3_DTB@@
@@OPIZ3_INITRD_LINE@@
    APPEND @@OPIZ3_APPEND@@ enforcing=0

LABEL orangepizero3-selinux-enforcing-test
    MENU LABEL @@BRAND_TITLE@@ headless appliance (SELinux enforcing (test))
    LINUX /@@OPIZ3_KERNEL_IMG@@
    FDT /dtb/@@OPIZ3_DTB@@
@@OPIZ3_INITRD_LINE@@
    APPEND @@OPIZ3_APPEND@@ enforcing=1
