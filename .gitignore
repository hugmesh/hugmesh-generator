# ── Build output directories (default work dirs) ──────────────────
# build-rpi5-stage4.sh / build-x86-host-stage4.sh default WORK_DIRs and the
# Makefile's $(CURDIR)/out. Repo-root-anchored: these only ever exist at root.
/rpi5-stage4-build/
/x86-host-build/
/out/

# ── Per-arch heavy build trees (sysroot/distfiles/pkgdir) under any WORK_DIR ──
snap-build-pi5/
snap-build-x86/

# ── Build artifacts ───────────────────────────────────────────────
# Disk images, ISOs, stage4 / filesystem tarballs (*.fs.tar.xz, *.stage4.tar.xz
# both match *.tar.xz), package bundles, and the build log. These are large and
# rebuilt from source; never commit them.
*.img
*.img.xz
*.iso
*.tar.xz
*.tgz
*.qcow2
build.log

# ── QEMU integration-test scratch ─────────────────────────────────
qemu-test/
console.log

# ── Local docker-compose stack (clone+build+run) ──────────────────
# Cloned source repos the local stack builds from (scripts/clone-all-repos.sh).
/.stack-src/
# ── Mesh repo-templating (Phase 2) ────────────────────────────────
# READ-ONLY Tier-2 base clones pulled by scripts/pull-repo-base.sh — never
# committed/vendored (the overlay references the base, it is not vendored in).
# Rendered per-tenant trees land under the already-ignored /out/.
/.repo-base/
# Generated Mastodon dev env (SOCIAL=1 tier) — holds generated secrets.
tests/stack/.mastodon.env
# Generated by tests/stack/m2-bootstrap.sh — the local private-maven registry
# coordinates (container bridge IP); machine-specific, never commit.
tests/stack/.m2-registry.env
# seed-e2e.sh workdir — rendered role JSON (deterministic test passwords) +
# pre-minted per-persona JWTs. Runtime-only; never commit.
tests/stack/.seed-e2e/
# Per-machine TLS CA + leaf for the https front door (`make stack-certs`).
# PRIVATE KEYS — never commit (unlike tests/stack/certs, the committed
# mock-stack FIXTURES, this CA may be imported into the operator's browser).
tests/stack/.tls-front/
# The OPT-IN hugmesh-tor service (`make stack-up TOR=1`) copies the minted
# PUBLIC .onion hostname here for the host/GUI to read (the private key stays in
# the tor-onion-keys volume). Runtime-only, machine-specific; never commit.
tests/stack/tor-onion/

# ── Generated secrets — NEVER commit ──────────────────────────────
# Output of scripts/gen-provision-keys.sh, gen-cluster-secrets.sh, gen-keystores.sh
# (keys-out/) and any filled-in per-role KEYS dir.
/keys-out/
# clients/hugmesh-auditor/gen-auditor-signing-key.sh's release signing key
# defaults into keys-out/ (already ignored above) — these are defense-in-depth
# in case OUTDIR is ever pointed elsewhere inside the repo. The key itself
# belongs on the pki USB / Vault, same custody as cluster-ca.key; NEVER git.
*.jks
keystore.properties
# In-UI SSH-terminal DIAL PRIVATE key + Vault-seed tree (NEVER baked/bundled/git).
# Belt-and-braces if gen-provision-keys.sh is pointed at a custom --out dir inside
# the repo: the dial private key and its vault-seed tree must never be committed.
vault-seed/
dial_private_key
keys-pki/
keys-backend/
keys-frontend/
keys-host/
*_ed25519
*_rsa
*.pem
ssh_host_*_key
ssh_host_*_key.pub
# (keys-template/ itself is committed — it holds only placeholders / *.example.)
# Cloudflare go-live tunnel creds (PROD only) — never commit the real value.
keys-template/cloudflared/tunnel-token
keys-template/cloudflared/credentials.json
**/cloudflared/credentials.json
# go-live wizard secrets (keys-layout token_dest paths emitted by the go-live
# provider registry, specs/usr/lib/hugmesh/go-live-providers.sh) — the DDNS
# token. Only *.example is committed.
keys-template/ddns/token
**/ddns/token
# Encryption-at-rest key material — LUKS data-disk keyfile + etcd Secret
# encryption key. Custody is the offline USB-KEYS stick / Vault, NEVER git.
keys-template/secrets/luks.key
**/secrets/luks.key
*.luks.key
luks.key
keys-template/kubernetes/encryption-key
**/kubernetes/encryption-key
etcd-encryption.key
# Persistent Vault unseal/recovery key + bootstrap/root token. Custody is the
# offline USB-KEYS stick, NEVER git (only the README placeholders are committed).
keys-template/vault/unseal-key
keys-template/vault/token
**/vault/unseal-key
**/vault/token
# Phase 7 foreign-mesh trust store — staged OUT-OF-BAND, pubkeys-only, never
# committed (only README.md + the *.example placeholder are tracked; the
# `*.example` name falls outside this glob).
keys-template/mesh-trust/*/foreign-provenance-pub.ed25519

# Brand profile may hold default passwords — never commit the real one
# (brand.conf.example is the committed template).
brand.conf
# EXCEPTION (ask 6 / premade themes): a THEME's brand.conf is generated by
# scripts/gen-branding-themes.py and carries only ACCENT_COLOR + COLOR_SCHEME_NAME
# — no identity, no credential. It MUST be committed or every theme ships without
# its accent and colour scheme. Deliberately narrow: theme dirs only, so a real
# brand profile anywhere else stays ignored.
!specs-x86/branding/themes/*/brand.conf

# ── Studio launcher / Nix dev-shell scratch (scripts/studio-launch.sh, flake.nix) ──
# The consent-gated Studio bootstrap venv (studio/.venv-studio; also matches the
# path the Windows .bat builds); direnv's cache; and `nix build`/`nix run` result
# symlinks. All generated, machine-specific, never committed.
.venv-studio/
.direnv/
/result
/result-*

# ── Editor / OS noise ─────────────────────────────────────────────
*.swp
*~
.DS_Store
.idea/
.vscode/

# Claude Code agent worktrees / scratch — never commit
.claude/
scripts/__pycache__/
tests/scripts/__pycache__/
specs/cluster/manifests/meshbridge/app/__pycache__/
tests/meshbridge/__pycache__/
tests/workload-console/__pycache__/
tests/scripts/__pycache__/

# Session sandbox: PATH-shadowing no-build stubs (sudo/docker/emerge/qemu -> exit 127).
# Never part of the product — created ad hoc by review/CI sandboxes; see the
# workflow-no-real-builds convention. Ignored so a sandbox run cannot commit them.
.nobuild-bin/
tests/stack/.uidist/_remotes/wasm-fragment/
