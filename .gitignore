# ── Build output directories (default work dirs) ──────────────────
# build-rpi5-stage4.sh / build-x86-host-stage4.sh default WORK_DIRs and the
# Makefile's $(CURDIR)/out. Repo-root-anchored: these only ever exist at root.
/rpi5-stage4-build/
/x86-host-build/
/out/

# ── Build artifacts ───────────────────────────────────────────────
# Disk images, ISOs, stage4 / filesystem tarballs (*.fs.tar.xz, *.stage4.tar.xz
# both match *.tar.xz), package bundles, and the build log. These are large and
# rebuilt from source; never commit them.
*.img
*.img.xz
*.iso
*.tar.xz
*.tgz
*.qcow2
build.log

# ── QEMU integration-test scratch ─────────────────────────────────
qemu-test/
console.log

# ── Generated secrets — NEVER commit ──────────────────────────────
# Output of scripts/gen-provision-keys.sh, gen-cluster-secrets.sh, gen-keystores.sh
# (keys-out/) and any filled-in per-role KEYS dir.
/keys-out/
keys-pki/
keys-backend/
keys-frontend/
keys-host/
*_ed25519
*_rsa
*.pem
ssh_host_*_key
ssh_host_*_key.pub
# (keys-template/ itself is committed — it holds only placeholders / *.example.)
# Cloudflare go-live tunnel creds (PROD only) — never commit the real value.
keys-template/cloudflared/tunnel-token
keys-template/cloudflared/credentials.json
**/cloudflared/credentials.json

# Brand profile may hold default passwords — never commit the real one
# (brand.conf.example is the committed template).
brand.conf

# ── Editor / OS noise ─────────────────────────────────────────────
*.swp
*~
.DS_Store
.idea/
.vscode/
