# Cross-compilation — @@OPIZ2_CPU@@ — Orange Pi Zero 2 (Allwinner H616) —
# HARDENED, HEADLESS APPLIANCE
#
# This is the HEADLESS APPLIANCE image's portage config (NOT a K8s cluster node,
# and NOT a desktop client — this platform has ONE role, a network appliance;
# see the builder header and specs-orangepi-zero2/README.md for the HDMI/
# mainline-driver research that justifies the headless-only scope). It mirrors
# specs-frite/specs-orangepi5's make.conf.tmpl shape (same aarch64 cross
# toolchain, same hardened CFLAGS/LDFLAGS/FEATURES) but is DELIBERATELY MUCH
# SHORTER: no X/gtk/qt USE flags, no VIDEO_CARDS, no INPUT_DEVICES — there is no
# display stack to configure at all on this platform, ever.
#
# Variables substituted at build time (by render_template in
# build-orangepi-zero2-stage4.sh):
#   @@CBUILD@@           Host compiler triplet
#   @@CROSS_TARGET@@     Target triplet (e.g. aarch64-unknown-linux-gnu)
#   @@OPIZ2_CPU@@        GCC -mcpu / -mtune value (cortex-a53 default — H616 is
#                        a quad-core Cortex-A53, no big.LITTLE split; the SAME
#                        core Orange Pi 5's LITTLE cluster uses)
#   @@JOBS@@             Parallel make jobs
#   @@WORK_DIR@@         Base build directory (per-arch build root)

CBUILD="@@CBUILD@@"
CHOST="@@CROSS_TARGET@@"

# Hardened CFLAGS — same posture as the rest of the fleet. H616 is a quad
# Cortex-A53 (no big.LITTLE — unlike RK3588's cortex-a76.cortex-a55 mix), so a
# plain single -mcpu value is correct here.
CFLAGS="-mcpu=@@OPIZ2_CPU@@ -O2 -pipe -fstack-protector-strong -Wno-error=implicit-function-declaration -Wno-error=incompatible-pointer-types -Wno-error=int-conversion -Wno-error=implicit-int"
CXXFLAGS="${CFLAGS}"
LDFLAGS="-Wl,-O1 -Wl,--as-needed -Wl,-z,relro -Wl,-z,now"

MAKEOPTS="-j@@JOBS@@"
# -userfetch/-userpriv: don't drop to the 'portage' user (it can't traverse a
# mode-700 / encrypted $HOME work dir). All sandboxing off for the cross-build.
FEATURES="buildpkg nostrip -userfetch -userpriv -usersandbox -sandbox -pid-sandbox -network-sandbox -ipc-sandbox"
PKGDIR="@@WORK_DIR@@/pkgdir"
DISTDIR="@@WORK_DIR@@/distfiles"

# Hardened USE baseline for a HEADLESS APPLIANCE — NO X11/GTK/Qt anywhere (this
# platform never has a desktop mode, unlike Frite's --desktop light|none). dbus
# is kept (NetworkManager depends on it); elogind/seat-management is dropped —
# there is no local login session to manage on an SSH-only appliance.
USE="bindist hardened pie ssp selinux seccomp"
USE="${USE} dbus udev -X -qt5 -qt6 -kde -gnome -gnome-keyring -systemd"
# No audio at all — this is a headless network appliance, not a media device.
USE="${USE} -alsa -pulseaudio -pipewire"
# Disable GObject introspection: glib-2.86+ bootstraps a native copy of
# gobject-introspection during cross-compile src_configure, but the bootstrap
# meson build fails in the cross-emerge env (cross-file / EPYTHON
# mis-targeting). Mirrors specs-frite/specs-orangepi5 (identical cross-compile
# gap; NetworkManager itself pulls in glib transitively even on a headless box).
USE="${USE} -introspection -vala"

# Only the MCS SELinux policy store (same posture as every other platform in
# this repo): smaller build, matches the per-process MCS labelling baseline.
POLICY_TYPES="mcs"
# Deliberately NO INPUT_DEVICES / VIDEO_CARDS lines: those select X11 input/
# video drivers, and this platform never emerges x11-base/xorg-server or any
# GPU/DRM userspace stack — there is nothing for these variables to select.

ACCEPT_LICENSE="*"
ACCEPT_KEYWORDS="arm64 ~arm64"

# PYTHON_TARGETS / PYTHON_SINGLE_TARGET are DELIBERATELY NOT SET HERE.
# They are DERIVED FROM THE STAGE3 SEED at build time and appended to the
# rendered make.conf by scripts/_python-targets-lib.sh (pt_apply_seed_targets).
# A frozen python3_NN literal in this file is a BUG: the seed's python floats per
# arch and per snapshot (amd64 20260726 ships 3.13+3.14 and no 3.12; arm64 ships
# 3.14 only; the 2026-07 jetson seed shipped 3.12+3.14), and a USE_EXPAND
# assignment here REPLACES the profile default rather than widening it — which is
# what wedged the 2026-07-29 mesh build in a dev-python slot conflict, and, in
# mirror image, what produced the 2026-07-16 jetson "USE changes are necessary:
# python_targets_python3_12" wall. See docs/PYTHON-TARGETS-SEED-DRIFT.md.

# NOTE: the cross-compile chflags() configure fix for dev-lang/python lives in
# package.env (env/python-cross.conf), NOT here — a GLOBAL EXTRA_ECONF leaks the
# ac_cv_* cache args into packages with hand-written configure scripts that
# reject unknown options and die. (Same rationale as every other platform here.)

PAX_MARKINGS="none"

# gettext-0.23.x empty-$(DOMAIN) catalogs. The host-side twin of this mask lives in the
# builder (see its "mo-collision dodge" block) and covers BDEPENDs merged to "/". This
# line covers the OTHER half: packages cross-emerged into ${SYSROOT} collide there too,
# which is the half build-x86-host-stage4.sh has always masked (it substitutes
# @@INSTALL_MASK@@ into specs-x86 at :2058) and the half that took out grub/parted/dracut
# in its 2026-07-08 build. Only the empty-basename catalogs are masked; real ones stay.
INSTALL_MASK="/usr/share/locale/*/LC_MESSAGES/.mo"
