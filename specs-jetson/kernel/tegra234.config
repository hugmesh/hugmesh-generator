# Kernel config fragment — Tegra234 (Jetson Orin) SoC bring-up, MAINLINE kernel.
#
# Merged by build-jetson-stage4.sh AFTER hardened-node.config, on top of the
# generic arm64 defconfig (which already selects ARCH_TEGRA as a platform).
# This pins the Tegra234-specific drivers the Orin Nano Developer Kit needs to
# come up headless on a MAINLINE kernel: UART/TCU console, eMMC/SD, NVMe/PCIe,
# USB, the onboard Ethernet (EQOS), BPMP/IPC, and the SoC's power/clock plumbing.
#
# WHAT MAINLINE DOES **NOT** GIVE YOU (the kernel decision — see kernel/README.md):
#   * NO CUDA. The integrated Ampere GPU (GA10B) is served upstream by the
#     `nouveau`/nova bring-up only partially and by NVIDIA's out-of-tree `nvgpu`
#     driver in L4T. CUDA userspace REQUIRES the L4T/BSP kernel flavor
#     (--kernel-flavor l4t, a documented-not-automated path).
#   * Display (nvdisplay) is likewise partial upstream; the desktop role on
#     mainline may fall back to simple-framebuffer (efifb via UEFI GOP).
# The tegra-drm/host1x options below are enabled so whatever the running
# mainline kernel DOES support is available; they are not a CUDA substitute.
#
# Format: standard .config fragment — consumed by merge_config.sh.

# ── Tegra platform core ────────────────────────────────────────────
CONFIG_ARCH_TEGRA=y
CONFIG_ARCH_TEGRA_234_SOC=y
CONFIG_TEGRA_BPMP=y
CONFIG_TEGRA_HSP_MBOX=y
CONFIG_TEGRA_IVC=y
CONFIG_SOC_TEGRA_PMC=y
CONFIG_TEGRA186_GPC_DMA=y
CONFIG_PINCTRL_TEGRA234=y
CONFIG_GPIO_TEGRA186=y
CONFIG_TEGRA186_TIMER=y
CONFIG_ARM_TEGRA186_CPUFREQ=y
CONFIG_TEGRA_WATCHDOG=y

# ── Console (the Orin TCU serial console = ttyTCU0) ────────────────
CONFIG_SERIAL_TEGRA=y
CONFIG_SERIAL_TEGRA_TCU=y
CONFIG_SERIAL_TEGRA_TCU_CONSOLE=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y

# ── Storage: microSD/eMMC + NVMe (the devkit boots SD or NVMe) ─────
CONFIG_MMC=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_TEGRA=y
CONFIG_PCI=y
CONFIG_PCIE_TEGRA194=y
CONFIG_PCIE_TEGRA194_HOST=y
CONFIG_PHY_TEGRA194_P2U=y
CONFIG_BLK_DEV_NVME=y
CONFIG_NVME_CORE=y

# ── Networking: onboard GbE (EQOS/stmmac on Tegra234) ──────────────
CONFIG_STMMAC_ETH=y
CONFIG_DWMAC_DWC_QOS_ETH=y
CONFIG_MDIO_BUS=y
CONFIG_PHYLIB=y
CONFIG_REALTEK_PHY=y

# ── USB (xudc/xhci + the devkit's type-A ports) ────────────────────
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_TEGRA=y
CONFIG_USB_STORAGE=y
CONFIG_PHY_TEGRA_XUSB=y

# ── I2C / SPI / thermal / fan (nvpmodel-class knobs live in userspace) ─
CONFIG_I2C=y
CONFIG_I2C_TEGRA=y
CONFIG_SPI_TEGRA210_QUAD=y
CONFIG_SENSORS_PWM_FAN=y
CONFIG_TEGRA_SOCTHERM=y
CONFIG_THERMAL=y
CONFIG_CPU_THERMAL=y

# ── Host1x / tegra-drm (what mainline display support exists; NOT CUDA) ─
CONFIG_TEGRA_HOST1X=y
CONFIG_DRM=y
CONFIG_DRM_TEGRA=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FB=y
CONFIG_FB_SIMPLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_SYSFB_SIMPLEFB=y

# ── IOMMU (SMMU-500 on Tegra234; required for PCIe/GPU DMA isolation) ─
CONFIG_IOMMU_SUPPORT=y
CONFIG_ARM_SMMU=y
CONFIG_ARM_SMMU_V3=y
CONFIG_TEGRA_IOMMU_SMMU=y

# ── EFI (the Orin boots via UEFI from QSPI; efivars for the installer) ─
CONFIG_EFI=y
CONFIG_EFIVAR_FS=y
